          <!-- mk._x = (c.getTransform().rb == 255) / 0.005 -->
          <PushData>
            <items>
              <StackString value="/mk"/>
              <StackFloat value="0.0"/>
              <StackInteger value="0"/>
              <StackString value="c"/>
            </items>
          </PushData>
          <GetVariable/>
          <PushData><items><StackString value="getTransform"/></items></PushData>
          <CallMethod/>
          <PushData><items><StackString value="rb"/></items></PushData>
          <GetMember/>
          <PushData><items><StackInteger value="255"/></items></PushData>
          <EqualTyped/>
          <PushData><items><StackDouble value="0.005"/></items></PushData>
          <Divide/>
          <SetProperty/>
          <EndAction/>
        </actions>
      </DoAction>

      <ShowFrame/>
      <End/>
    </tags>
  </Header>
</swf>
