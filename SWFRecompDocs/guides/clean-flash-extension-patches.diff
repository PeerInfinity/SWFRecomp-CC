+/// Get the page origin from the first plugin instance, for use as a stable
+/// SharedObjects directory name. Falls back to "default" if unavailable.
+fn get_page_origin() -> String {
+    let Some(host) = HOST.get() else {
+        return "default".to_string();
+    };
+    // There's exactly one instance per host process; grab instance 1.
+    let page_url = host.instances.with_instance(1, |inst| {
+        inst.page_url.clone()
+    }).flatten();
+    match page_url {
+        Some(url) => {
+            // Extract origin (scheme + host + port) from the URL.
+            // e.g. "http://localhost:8002/path/page.html" -> "http://localhost:8002"
+            if let Some(scheme_end) = url.find("://") {
+                let after_scheme = &url[scheme_end + 3..];
+                if let Some(path_start) = after_scheme.find('/') {
+                    url[..scheme_end + 3 + path_start].to_string()
+                } else {
+                    url.clone()
+                }
+            } else {
+                url
+            }
+        }
+        None => "default".to_string(),
+    }
+}
+
+/// Rewrite a Flash-relative path to replace the random `#SharedObjects/<ID>/`
+/// directory with a stable one derived from the page origin.
+///
+/// Flash internally generates a random 8-character directory name under
+/// `#SharedObjects/` each time the PPAPI host starts. This function detects
+/// that pattern and replaces the random component with a deterministic hash
+/// of the page URL origin, so save data persists across sessions.
+fn stabilize_shared_objects_path(rel: &str) -> String {
+    const PREFIX: &str = "#SharedObjects/";
+    if let Some(after_prefix) = rel.strip_prefix(PREFIX) {
+        // Split into "<random_id>/rest/of/path" or just "<random_id>"
+        if let Some(slash_pos) = after_prefix.find('/') {
+            let rest = &after_prefix[slash_pos..]; // includes leading '/'
+            let origin = get_page_origin();
+            let stable_id = stable_shared_objects_id(&origin);
+            tracing::debug!(
+                "Stabilizing SharedObjects path: random -> {} (origin: {})",
+                stable_id, origin
+            );
+            format!("{}{}{}", PREFIX, stable_id, rest)
+        } else {
+            // Just the directory itself, e.g. "#SharedObjects/3XRELRFV"
+            let origin = get_page_origin();
+            let stable_id = stable_shared_objects_id(&origin);
+            format!("{}{}", PREFIX, stable_id)
+        }
+    } else {
+        rel.to_string()
+    }
+}
