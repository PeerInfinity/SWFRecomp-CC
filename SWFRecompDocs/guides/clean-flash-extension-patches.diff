+/// Derive a stable 8-character uppercase alphanumeric ID from a string,
+/// mimicking the format Flash uses for its random SharedObjects directory names.
+fn stable_shared_objects_id(origin: &str) -> String {
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    origin.hash(&mut hasher);
+    let hash = hasher.finish();
+    // Encode as base-36 (0-9A-Z) and take first 8 chars, uppercase
+    let mut id = String::new();
+    let mut val = hash;
+    const CHARS: &[u8] = b"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+    for _ in 0..8 {
+        id.push(CHARS[(val % 36) as usize] as char);
+        val /= 36;
+    }
+    id
+}
