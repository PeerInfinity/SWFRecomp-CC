+// package registration never matches it.
+static void builtin_add_global_fn_ns_kind(Avm2Context* ctx, const char* ns,
+                                          const char* name, Avm2MethodFn fn,
+                                          uint8_t ns_kind)
+{
+	char dbuf[160];
