+	ActionVar* p = getProperty((ASObject*) mc->dynamic_props, "hscroll", 7);
+	if (p == NULL) return 0.0f;
+	double d = varToDoubleSimple(p);
+	return d > 0.0 ? (float) d : 0.0f;
