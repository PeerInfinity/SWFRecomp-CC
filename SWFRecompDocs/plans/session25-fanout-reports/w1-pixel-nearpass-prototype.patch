+		long long tx = bx, ty = by;
+		bx = qx; by = qy; qx = tx; qy = ty;
+	}
+	long long X[3] = { ax, bx, qx }, Y[3] = { ay, by, qy };
+	for (int e = 0; e < 3; e++)
+	{
+		long long x0 = X[e], y0 = Y[e], x1 = X[(e + 1) % 3], y1 = Y[(e + 1) % 3];
+		long long w = (x1 - x0) * (cy - y0) - (y1 - y0) * (cx - x0);
+		if (w > 0) continue;
