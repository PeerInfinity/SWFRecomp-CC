 // ---------------------------------------------------------------------------
 void render_webgpu_free(SWFAppContext* app_context, WebGPURenderContext* ctx)
 {
 	(void)app_context;
+	release_color_matrix_resources();
 
 	// Release pipelines
 	if (ctx->render_pipeline)
