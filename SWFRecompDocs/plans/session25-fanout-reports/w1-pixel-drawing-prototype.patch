+static void drawingUnionTranslucentStroke(DrawPath* path)
+{
+	if (path->line_verts == NULL || path->line_vert_count < 6) return;
+	int translucent = 0;
+	if (path->has_line_gradient) {
+		for (int i = 0; i < 256; i++)
