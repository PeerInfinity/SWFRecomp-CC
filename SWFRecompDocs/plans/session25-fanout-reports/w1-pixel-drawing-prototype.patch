+			for (int i = 0; i < ntris; i++)
+				for (int j = 0; j < 3; j++) {
+					TESSindex idx = elems[i * 3 + j];
+					out[i*6 + j*2]     = verts[idx * 2];
+					out[i*6 + j*2 + 1] = verts[idx * 2 + 1];
+				}
+			free(path->line_verts);
+			path->line_verts = out;
+			path->line_vert_count = (u32)ntris * 3;
+		}
+	}
