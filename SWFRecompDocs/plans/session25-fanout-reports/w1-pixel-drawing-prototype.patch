+	if (tess == NULL) return;
+	u32 ntri_in = path->line_vert_count / 3;
+	for (u32 t = 0; t < ntri_in; t++) {
+		float* v = &path->line_verts[t * 6];
+		float area = (v[2] - v[0]) * (v[5] - v[1]) - (v[4] - v[0]) * (v[3] - v[1]);
+		if (fabsf(area) < 1e-4f) continue;
