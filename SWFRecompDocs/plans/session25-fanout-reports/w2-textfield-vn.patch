+// createTextField constructs the new field through the CURRENT
+// `_global.TextField`, with `this` = the field and no arguments (Ruffle
+// edit_text.rs construct_as_avm1_object `construct_on_existing`; gnash
+// TextField.as:1219-1248: a replaced `_global.TextField` runs once,
+// `storedthis === _root.tfmo`, `this.bo` lands as an own property). The
+// native constructor does nothing here, so only a script function is called.
+static void tfCallGlobalCtorOnField(SWFAppContext* app_context, MovieClip* field)
+{
+	if (field == NULL || g_swf_version < 6) return;
+	ASObject* g = getActiveGlobal();
+	if (g == NULL) return;
+	ActionVar* cv = getProperty(g, "TextField", 9);
+	if (cv == NULL || cv->type != ACTION_STACK_VALUE_FUNCTION) return;
+	ASFunction* f = (ASFunction*)(uintptr_t) cv->data.numeric_value;
+	if (f == NULL || f == &g_textfield_constructor) return;
+	// The field is built on the replaced constructor's prototype (Ruffle
+	// `constr.prototype()` then `new_with_native(proto)`): avm1
+	// globals_monkeypatch `new MyTextField() called!` / `className:
+	// MyTextField`. Read raw (prototype_obj), never through a getter, as
+	// Flash does (no "prototype getter called" trace there).
+	if (f->prototype_obj != NULL && field->dynamic_props != NULL) {
+		ASObject* props = (ASObject*) field->dynamic_props;
+		ActionVar proto_val = {0};
+		proto_val.type = ACTION_STACK_VALUE_OBJECT;
+		proto_val.data.numeric_value = (u64)(uintptr_t) f->prototype_obj;
+		setProperty(app_context, props, "__proto__", 9, &proto_val);
+		for (u32 pi = 0; pi < props->num_used; pi++) {
+			if (props->properties[pi].name != NULL && strcmp(props->properties[pi].name, "__proto__") == 0) {
+				props->properties[pi].flags &= ~PROPERTY_FLAG_ENUMERABLE;
+				break;
+			}
+		}
+	}
+	ActionVar this_var = {0};
+	this_var.type = ACTION_STACK_VALUE_MOVIECLIP;
+	this_var.data.numeric_value = (u64)(uintptr_t) field;
+	// Default flag superset, plus a real zero-length `arguments` for a type-1
+	// (SWF6 DefineFunction) body, which has no prologue of its own
+	// (TextField.as:1239 `args == 0`).
+	InvokeOpts opts = { .flags = INV_DEPTH_GUARD | INV_THIS_STACK | INV_SUPER_CTX |
+	                             INV_CAPTURED_SCOPE | INV_LOCAL_SCOPE | INV_BIND_THIS |
+	                             INV_BASE_CLIP | INV_VERSION_SWITCH | INV_EVENT_THIS_MC |
+	                             INV_EXEC_FUNC | INV_LOCAL_SCOPE_MC | INV_CTOR_CTX |
+	                             INV_MC_THIS_NULL_PTR,  // MC receiver: preload_this reads g_event_this_mc
+	                    .act_flags = INV_ACT_ARGUMENTS };
+	(void) invokeFunctionValue(app_context, f, &this_var, NULL, 0, &opts);
+}
