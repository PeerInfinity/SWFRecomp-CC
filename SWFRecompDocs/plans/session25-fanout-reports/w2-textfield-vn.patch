+// First-instantiation definition of the 35 native TextField properties on
+// TextField.prototype (see initTextFieldPrototype). One-shot, SWF6+.
+static int g_tf_proto_props_defined = 0;
+static void textFieldDefineProtoProps(SWFAppContext* app_context)
+{
+	if (g_tf_proto_props_defined || g_swf_version < 6) return;
+	initTextFieldPrototype(app_context);
+	if (g_textfield_constructor_init < 2) return;
+	ASObject* proto = g_textfield_constructor.prototype_obj;
+	if (proto == NULL) return;
+	g_tf_proto_props_defined = 1;
+	static const char* names[] = {
+		"styleSheet", "mouseWheelEnabled", "condenseWhite", "restrict",
+		"textHeight", "textWidth", "bottomScroll", "length",
+		"selectable", "multiline", "password", "wordWrap",
+		"background", "border", "html", "embedFonts",
+		"maxChars", "maxhscroll", "hscroll", "variable",
+		"htmlText", "type", "text", "autoSize",
+		"tabIndex", "textColor", "backgroundColor", "borderColor",
+		"maxscroll", "scroll", "filters", "sharpness",
+		"thickness", "antiAliasType", "gridFitType"
+	};
+	ActionVar undef_val = {0};
+	undef_val.type = ACTION_STACK_VALUE_UNDEFINED;
+	// Register in REVERSE order so that for-in enumeration (LIFO stack) yields forward order.
+	for (int i = 34; i >= 0; i--)
+	{
+		u32 l = (u32) strlen(names[i]);
+		// A script may already have assigned one of these names on the
+		// prototype; Flash's native definition would replace it, but keep
+		// the conservative behaviour of not clobbering user data.
+		if (findPropertyRaw(proto, names[i], l) != NULL) continue;
+		setProperty(app_context, proto, names[i], l, &undef_val);
+	}
+}
