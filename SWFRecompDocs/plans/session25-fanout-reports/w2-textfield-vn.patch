+// Runtime `tf.variable = X` on a createTextField field (ng_textfield_idx == -2,
+// no DefineEditText metadata). Flash semantics (gnash TextField.as:748-772):
+//   - the field's text is NOT reset and the variable is NOT created when it
+//     does not exist (`!_level0.hasOwnProperty('inputVar')`, text stays);
+//   - when the bound property already exists, the text takes its value;
+//   - later writes to a DISPLAY-OBJECT container's property update the text
+//     (binding registered on the container clip); writes to a plain Object
+//     container do not (only re-assigning `variable` re-reads it);
+//   - writing `tf.text` writes through to the resolved path (ng_syncTextToVar).
+// Ruffle set_variable/try_bind_text_field_variable differs only in resetting
+// the text to the (empty) initial text first, which Flash does not do.
+static void tfDynamicRebindVariable(SWFAppContext* app_context, MovieClip* tf_mc)
+{
+	extern MovieClip root_movieclip;
+	extern ActionVar* getVariable(char* var_name, size_t key_size);
+	if (tf_mc == NULL || tf_mc->ng_textfield_idx != -2 || tf_mc->dynamic_props == NULL) return;
+	g_tf_bound_gen++;
+	// Clear any previous registration of this field.
+	actionDropTextFieldBindingForTF(&root_movieclip, tf_mc);
+	for (int i = 0; i < child_mc_count; i++)
+		if (child_mc_cache[i] != NULL) actionDropTextFieldBindingForTF(child_mc_cache[i], tf_mc);
+
+	ASObject* props = (ASObject*) tf_mc->dynamic_props;
+	ActionVar* vp = getProperty(props, "variable", 8);
+	if (vp == NULL || vp->type != ACTION_STACK_VALUE_STRING || vp->str_size == 0) return;
+	char var_name[512];
+	u16_to_utf8(varGetU16Ptr(vp), vp->str_size, var_name, sizeof(var_name));
+	if (var_name[0] == '\0') return;
+
+	ASObject* container = NULL;
+	MovieClip* container_mc = NULL;
+	const char* prop_name = var_name;
+	const char* last_dot = strrchr(var_name, '.');
+	if (last_dot != NULL) {
+		prop_name = last_dot + 1;
+		PUSH_STR(var_name, (u32)(last_dot - var_name));
+		actionGetVariable(app_context);
+		ActionVar cvar;
+		peekVar(app_context, &cvar);
+		POP();
+		if (cvar.type == ACTION_STACK_VALUE_OBJECT) {
+			container = (ASObject*) VAL(u64, &cvar.data.numeric_value);
+		} else if (cvar.type == ACTION_STACK_VALUE_MOVIECLIP) {
+			container_mc = (MovieClip*) VAL(u64, &cvar.data.numeric_value);
+		}
+	} else {
+		container_mc = (tf_mc->parent != NULL) ? tf_mc->parent : &root_movieclip;
+	}
+	if (container_mc != NULL) container = (ASObject*) container_mc->dynamic_props;
+	u32 prop_len = (u32) strlen(prop_name);
+	if (prop_len == 0) return;
+
+	if (container != NULL || container_mc == &root_movieclip) {
+		ActionVar* ev = (container != NULL) ? getProperty(container, prop_name, prop_len) : NULL;
+		// Root timeline variables may live only in the global var_map.
+		if (ev == NULL && container_mc == &root_movieclip && hasVariable((char*)prop_name, prop_len))
+			ev = getVariable((char*)prop_name, prop_len);
+		if (ev != NULL) {
+			ActionVar text_val = *ev;
+			if (ev->type != ACTION_STACK_VALUE_STRING) {
+				char _sv_buf[512];
+				int _n = varToStringBuf(app_context, ev, _sv_buf, sizeof(_sv_buf));
+				u32 _u16_len = 0;
+				uint16_t* _u16 = utf8_to_u16(app_context, _sv_buf, _n > 0 ? (u32)_n : 0, &_u16_len);
+				text_val = (ActionVar){0};
+				text_val.type = ACTION_STACK_VALUE_STRING;
+				text_val.str_size = _u16_len;
+				VAL(u64, &text_val.data.numeric_value) = (u64)_u16;
+			}
+			setProperty(app_context, props, "text", 4, &text_val);
+			setProperty(app_context, props, "htmlText", 8, &text_val);
+			ActionVar len_val = {0};
+			len_val.type = ACTION_STACK_VALUE_F64;
+			VAL(double, &len_val.data.numeric_value) = (double)text_val.str_size;
+			setProperty(app_context, props, "length", 6, &len_val);
+		}
+	}
+	if (container_mc != NULL)
+		actionRegisterTextFieldBinding(container_mc, tf_mc, var_name);
+}
