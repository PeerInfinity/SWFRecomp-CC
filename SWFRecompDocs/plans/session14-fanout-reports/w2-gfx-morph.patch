+	// -----------------------------------------------------------------------
+	// Morph shape edge pairing (see interpretShape's morph pre-pass)
+	// -----------------------------------------------------------------------
+	// A DefineMorphShape carries two edge streams (StartEdges, EndEdges) whose
+	// EDGE records correspond one-to-one, and our runtime lerps the start
+	// shape's flattened vertices against the end shape's positions BY INDEX
+	// (Vertex::morph_index -> morph_end_positions[i]). That only holds if the
+	// two streams emit the same number of vertices in the same order, which the
+	// historical rule ("one vertex per straight edge, six per curved edge") does
+	// NOT guarantee:
+	//
+	//   * SWF lets a StraightEdgeRecord in one stream pair with a
+	//     CurvedEdgeRecord in the other. Flash promotes the straight edge to a
+	//     degenerate quadratic whose control point is the segment midpoint
+	//     (~/CC/ruffle core/src/display_object/morph_shape.rs `lerp_edges`);
+	//     since that degenerate quadratic evaluates to plain linear
+	//     interpolation, subdividing the straight edge into the same N chords
+	//     as its curved partner reproduces Flash exactly. One vertex against
+	//     six does not — it desynchronises every vertex after it.
+	//   * StyleChangeRecords need not appear in matching pairs. Ruffle walks
+	//     whichever side has one and leaves the other side's pen where it is.
+	//
+	// So both streams are pre-scanned before either is parsed, the records are
+	// paired the way Ruffle pairs them, and each parser is handed a per-record
+	// vertex count. A shared count is also what makes adaptive subdivision
+	// possible here: a curve pair takes max(N(dev_start), N(dev_end)) chords, so
+	// the two sides subdivide identically and stay index-paired. (Session 13
+	// shipped adaptive subdivision for plain shapes and gated morphs out for
+	// exactly this reason — `w2-curve-subdiv-report.md` §2.)
+	//
+	// Anything unexpected in either stream (StateNewStyles, truncation) discards
+	// the plan and restores the historical fixed-6 behaviour.
+
+	struct MorphEdgeRec
+	{
+		u8 kind;             // 0 = StyleChange, 1 = StraightEdge, 2 = CurvedEdge
+		bool emits_vertex;   // StyleChange: this record pushes a vertex
+		bool implicit_start; // edge: the parser auto-creates a Path (+1 vertex) first
+		float dev;           // CurvedEdge: chord deviation from its chord, twips
+	};
+
+	// Walk one morph edge stream, recording its record sequence. `end_stream`
+	// selects the EndEdges grammar (its own NumFillBits/NumLineBits header, and
+	// StyleChangeRecords whose only meaningful bit is StateMoveTo) instead of the
+	// StartEdges one. Returns false if the stream is not a plain morph SHAPE.
+	static bool scanMorphEdgeStream(SWFTag& t, char* pos, char* limit,
+	                                bool end_stream, u8 fill_bits, u8 line_bits,
+	                                std::vector<MorphEdgeRec>& out)
+	{
+		u32 bits_left = 8;
+
+		if (end_stream)
+		{
+			if (pos == nullptr || pos + 1 > limit)
+			{
+				return false;
+			}
+
+			t.clearFields();
+			t.setFieldCount(2);
+			t.configureNextField(SWF_FIELD_UB, 4);
+			t.configureNextField(SWF_FIELD_UB, 4);
+			t.parseFields(pos);
+
+			fill_bits = (u8) t.fields[0].value;
+			line_bits = (u8) t.fields[1].value;
+		}
+
+		u32 last_fill_0 = 0, last_fill_1 = 0, last_line = 0;
+		bool has_path = false;
+		size_t guard = 0;
+
+		while (true)
+		{
+			if (++guard > 1000000 || pos >= limit)
+			{
+				return false;
+			}
+
+			t.clearFields();
+			t.setFieldCount(2);
+			t.configureNextField(SWF_FIELD_UB, 1);
+			t.configureNextField(SWF_FIELD_UB, 5);
+			t.parseFieldsContinue(pos, bits_left);
+
+			bool is_edge = ((u8) t.fields[0].value) != 0;
+			u8 state_flags = (u8) t.fields[1].value;
+
+			if (is_edge)
+			{
+				MorphEdgeRec r;
+				r.emits_vertex = false;
+				r.implicit_start = !has_path;
+				r.dev = 0.0f;
+				has_path = true;
+
+				bool is_straight = (state_flags & 0b10000) != 0;
+				u8 num_bits = state_flags & 0xF;
+
+				if (is_straight)
+				{
+					t.clearFields();
+					t.setFieldCount(1);
+					t.configureNextField(SWF_FIELD_UB, 1);
+					t.parseFieldsContinue(pos, bits_left);
+
+					bool is_general_line = (t.fields[0].value & 1) != 0;
+
+					t.clearFields();
+					t.setFieldCount(2);
+					if (is_general_line)
+					{
+						t.configureNextField(SWF_FIELD_SB, num_bits + 2);
+						t.configureNextField(SWF_FIELD_SB, num_bits + 2);
+					}
+					else
+					{
+						t.configureNextField(SWF_FIELD_UB, 1);
+						t.configureNextField(SWF_FIELD_SB, num_bits + 2);
+					}
+					t.parseFieldsContinue(pos, bits_left);
+
+					r.kind = 1;
+				}
+
+				else
+				{
+					t.clearFields();
+					t.setFieldCount(4);
+					t.configureNextField(SWF_FIELD_SB, num_bits + 2);
+					t.configureNextField(SWF_FIELD_SB, num_bits + 2);
+					t.configureNextField(SWF_FIELD_SB, num_bits + 2);
+					t.configureNextField(SWF_FIELD_SB, num_bits + 2);
+					t.parseFieldsContinue(pos, bits_left);
+
+					// dev = |control - (current + anchor)/2| / 2, which in terms of
+					// the record's deltas is |control_delta - anchor_delta| / 4. The
+					// parser's y negation does not change the magnitude.
+					float ddx = (float) ((s16) t.fields[0].value) - (float) ((s16) t.fields[2].value);
+					float ddy = (float) ((s16) t.fields[1].value) - (float) ((s16) t.fields[3].value);
+					r.dev = 0.25f * sqrtf(ddx*ddx + ddy*ddy);
+
+					r.kind = 2;
+				}
+
+				out.push_back(r);
+
+				continue;
+			}
+
+			if (state_flags == 0)
+			{
+				// EndShapeRecord
+				break;
+			}
+
+			if ((state_flags & 0b10000) != 0)
+			{
+				// StateNewStyles cannot appear in a morph SHAPE; the stream is not
+				// what we think it is.
+				return false;
+			}
+
+			bool state_line_style = (state_flags & 0b01000) != 0;
+			bool state_fill_style_1 = (state_flags & 0b00100) != 0;
+			bool state_fill_style_0 = (state_flags & 0b00010) != 0;
+			bool state_move_to = (state_flags & 0b00001) != 0;
+
+			MorphEdgeRec r;
+			r.kind = 0;
+			r.implicit_start = false;
+			r.dev = 0.0f;
+
+			if (end_stream)
+			{
+				// The EndEdges parser reads a StyleChangeRecord's MoveTo and nothing
+				// else (NumFillBits/NumLineBits are 0 there); mirror it exactly so
+				// the scan stays bit-aligned with the real parse.
+				if (state_move_to)
+				{
+					t.clearFields();
+					t.setFieldCount(3);
+					t.configureNextField(SWF_FIELD_UB, 5, true);
+					t.configureNextField(SWF_FIELD_SB, 0);
+					t.configureNextField(SWF_FIELD_SB, 0);
+					t.parseFieldsContinue(pos, bits_left);
+				}
+
+				r.emits_vertex = state_move_to;
+			}
+
+			else
+			{
+				t.clearFields();
+				t.setFieldCount(3*state_move_to + state_fill_style_0 + state_fill_style_1 + state_line_style);
+
+				if (state_move_to)
+				{
+					t.configureNextField(SWF_FIELD_UB, 5, true);
+					t.configureNextField(SWF_FIELD_SB, 0);
+					t.configureNextField(SWF_FIELD_SB, 0);
+				}
+				if (state_fill_style_0) t.configureNextField(SWF_FIELD_UB, fill_bits);
+				if (state_fill_style_1) t.configureNextField(SWF_FIELD_UB, fill_bits);
+				if (state_line_style)   t.configureNextField(SWF_FIELD_UB, line_bits);
+
+				t.parseFieldsContinue(pos, bits_left);
+
+				size_t f = state_move_to ? 3 : 0;
+				u32 fill_0 = last_fill_0, fill_1 = last_fill_1, line = last_line;
+				if (state_fill_style_0) fill_0 = (u32) t.fields[f++].value;
+				if (state_fill_style_1) fill_1 = (u32) t.fields[f++].value;
+				if (state_line_style)   line   = (u32) t.fields[f++].value;
+
+				// Mirrors the start parser's new-Path condition exactly.
+				r.emits_vertex = state_move_to || (fill_0 != last_fill_0)
+				              || (fill_1 != last_fill_1) || (line != last_line);
+
+				last_fill_0 = fill_0;
+				last_fill_1 = fill_1;
+				last_line = line;
+			}
+
+			if (r.emits_vertex)
+			{
+				has_path = true;
+			}
+
+			out.push_back(r);
+		}
+
+		return true;
+	}
+
+	// Chord count for a quadratic of chord deviation `dev`, tolerance 1 twip,
+	// clamped to [6, 64] — the same rule the plain-shape arm uses.
+	static u32 morphChordCount(float dev)
+	{
+		if (dev <= 1.0f)
+		{
+			return 6;
+		}
+
+		float n = ceilf(sqrtf(dev));
+		if (n > 64.0f)
+		{
+			n = 64.0f;
+		}
+		if (n < 6.0f)
+		{
+			n = 6.0f;
+		}
+
+		return (u32) n;
+	}
