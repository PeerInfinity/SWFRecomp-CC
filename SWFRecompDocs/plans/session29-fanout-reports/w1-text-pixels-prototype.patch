+// s29 w1-text-pixels PROTOTYPE: Flash Player 32's HIGH-quality coverage rule,
+// fitted on the FP32 capture of regression/avm1_edittext_rotated_glyphs:
+// FOUR sub-scanlines per pixel row at y + j/4 (j = 0..3), EXACT horizontal
+// coverage on each, the total quantised to 1/16 (Flash writes 255 - 16n,
+// so a run of n/16 draws at alpha 16n/255).
+// It is not a 4x4 grid (best grid phase 825 px > 2 vs this rule's 196), and
+// 4x MSAA (one sample per sub-row) cannot express it: our slanted hairline
+// weight oscillated 1.00/1.25/1.50 along the shear edge where Flash holds
+// 20/16. Used only for SKEWED text fields (rotated / sheared world matrix),
+// where the geometry is ours on the CPU: the polygons are scan-converted
+// here and emitted as runs of equal coverage, one alpha rect per run,
+// through transform slot 0 (stage twips). SWF_TF_CPU_COV=0 opts out (A/B).
+typedef struct { int n; float x[4], y[4]; } TfCovPoly;
+typedef struct { float a, b; } TfCovIv;
+static int tf_cov_iv_cmp(const void* p, const void* q)
+{
+	float d = ((const TfCovIv*)p)->a - ((const TfCovIv*)q)->a;
+	return (d > 0.0f) - (d < 0.0f);
+}
+static int tf_cpu_cov_enabled(void)
+{
+	static int e = -1;
+	if (e < 0) {
+		const char* v = getenv("SWF_TF_CPU_COV");
+		e = !(v && v[0] == '0');
+	}
+	return e;
+}
+// Polygons in DEVICE px (convex, 3 or 4 vertices). Returns 0 (nothing drawn)
+// when the bbox is too wide for the row buffer, so the caller falls back.
+static int tf_cpu_cov_fill(const TfCovPoly* polys, int np, float dscale,
+	float r, float g, float b, float alpha)
+{
+	enum { TF_COV_MAXW = 4096, TF_COV_MAXIV = 8192 };
+	static float cov[TF_COV_MAXW + 2];
+	static TfCovIv iv[TF_COV_MAXIV];
+	if (np <= 0) return 1;
+	float minx = 1e30f, maxx = -1e30f, miny = 1e30f, maxy = -1e30f;
+	for (int i = 0; i < np; i++)
+		for (int k = 0; k < polys[i].n; k++) {
+			minx = fminf(minx, polys[i].x[k]); maxx = fmaxf(maxx, polys[i].x[k]);
+			miny = fminf(miny, polys[i].y[k]); maxy = fmaxf(maxy, polys[i].y[k]);
+		}
+	if (!(maxx > minx) || !(maxy > miny)) return 1;
+	const int x0 = (int)floorf(minx), x1 = (int)floorf(maxx);
+	const int y0 = (int)floorf(miny), y1 = (int)ceilf(maxy);
+	const int W = x1 - x0 + 1;
+	if (W > TF_COV_MAXW || y1 - y0 > 8192) return 0;
+	const float px2tw = 20.0f / dscale;
+	for (int y = y0; y < y1; y++) {
+		memset(cov, 0, sizeof(float) * (size_t)(W + 1));
+		int any = 0;
+		for (int j = 0; j < 4; j++) {
+			const float ys = (float)y + 0.25f * (float)j;
+			int ni = 0;
+			for (int i = 0; i < np && ni < TF_COV_MAXIV; i++) {
+				const TfCovPoly* p = &polys[i];
+				float lo = 1e30f, hi = -1e30f; int hits = 0;
+				for (int k = 0; k < p->n; k++) {
+					const float ax = p->x[k], ay = p->y[k];
+					const float bx = p->x[(k + 1) % p->n], by = p->y[(k + 1) % p->n];
+					if ((ay <= ys && ys < by) || (by <= ys && ys < ay)) {
+						const float xc = ax + (ys - ay) * (bx - ax) / (by - ay);
+						lo = fminf(lo, xc); hi = fmaxf(hi, xc); hits++;
+					}
+				}
+				if (hits >= 2 && hi > lo) { iv[ni].a = lo; iv[ni].b = hi; ni++; }
+			}
+			if (ni == 0) continue;
+			qsort(iv, (size_t)ni, sizeof(TfCovIv), tf_cov_iv_cmp);
+			float ca = iv[0].a, cb = iv[0].b;
+			for (int i = 1; i <= ni; i++) {
+				if (i < ni && iv[i].a <= cb + 1e-4f) { cb = fmaxf(cb, iv[i].b); continue; }
+				// accumulate [ca, cb) into the row, 1/4 weight per sub-scanline
+				int xa = (int)floorf(ca), xb = (int)floorf(cb);
+				for (int x = xa; x <= xb; x++) {
+					const float o = fminf(cb, (float)(x + 1)) - fmaxf(ca, (float)x);
+					if (o > 0.0f && x >= x0 && x <= x1) { cov[x - x0] += 0.25f * o; any = 1; }
+				}
+				if (i < ni) { ca = iv[i].a; cb = iv[i].b; }
+			}
+		}
+		if (!any) continue;
+		int run_n = 0, run_x = 0;
+		for (int x = 0; x <= W; x++) {
+			int n = 0;
+			if (x < W) {
+				n = (int)floorf(cov[x] * 16.0f + 0.5f);
+				if (n > 16) n = 16;
+				if (n < 0) n = 0;
+			}
+			if (n != run_n || x == W) {
+				if (run_n > 0)
+					renderer_draw_rect(context, (float)(x0 + run_x) * px2tw, (float)y * px2tw,
+						(float)(x - run_x) * px2tw, px2tw, r, g, b,
+						alpha * fminf(1.0f, (float)run_n * 16.0f / 255.0f), 0, 0);
+				run_n = n; run_x = x;
+			}
+		}
+	}
+	return 1;
+}
