diff --git a/SWFModernRuntime/src/libswf/tag.c b/SWFModernRuntime/src/libswf/tag.c
index 9a07be06..91132c75 100644
--- a/SWFModernRuntime/src/libswf/tag.c
+++ b/SWFModernRuntime/src/libswf/tag.c
@@ -3822,6 +3822,14 @@ static int cab_snap_delta(DisplayObject* obj, const float world[16],
 	// visual/filters/blur_scales_with_screen 30440 -> 0 and
 	// drop_shadow_scales_with_screen 400 -> 0.
 	if (obj == NULL || !cab_snaps(obj)) return 0;
+#if !defined(MSAA_SAMPLES) || MSAA_SAMPLES > 1
+	// s29 w1-pixel-flash-gaps (PROTOTYPE): Flash 32 at quality HIGH composites
+	// an UNFILTERED cacheAsBitmap shape at its sub-pixel position (FP32
+	// lowq_sample_point.high.png row 3: a 25-px rect at (7.5, 127.5) has 50 %
+	// edges and 25 % corners). LOW keeps the snap (its aliased raster can't
+	// tell the two apart and the LOW Flash-golden scroll_rect needs it).
+	if (obj->filter_type == 0) return 0;
+#endif
 	float xmin, ymin;
 	if (!cab_world_bounds_min(obj, world, &xmin, &ymin)) return 0;
 	// Ruffle's bounds (and the blit it snaps) are taken under the STAGE VIEW
@@ -8386,6 +8394,25 @@ static void tf_glyph_quarter_snap(float* xy, const TextFieldGlyphInfo* info,
 		xy[2 * v]     = rintf(vx.f * scale / q) * q + px;
 		xy[2 * v + 1] = rintf(vy.f * scale / q) * q + py;
 	}
+#elif !defined(TF_GLYPH_NO_QSNAP) && defined(MSAA_SAMPLES) && MSAA_SAMPLES == 1
+	// s29 w1-pixel-flash-gaps (PROTOTYPE): Flash Player 32 quality = LOW draws a
+	// plain ("normal" antiAliasType) embedded-font field aliased with its pen
+	// rounded to a WHOLE device px, outline unsnapped (fit on the FP32 LOW
+	// goldens gnash place_object_test / shape_test: text channels 5073 -> 2604
+	// and 1128 -> 543; morph_test1 frames 2-6 -129 each). FlashType fields
+	// (CSMTextSettings advanced) stay anti-aliased in Flash even at LOW
+	// (acid-color-0 FP32 LOW capture), so they are left alone.
+	(void)sd; (void)g_offset; (void)scale;
+	if (info->device_font || info->csm_advanced) return;
+	const float dscale = (context != NULL && context->stage_scale > 0.0f)
+	                   ? context->stage_scale : 1.0f;
+	const float q = 20.0f / dscale;   // 1 device px, in stage twips
+	const float dx = rintf(x_pos / q) * q - x_pos;
+	const float dy = rintf(y_pos / q) * q - y_pos;
+	for (size_t v = 0; v < g_size; v++) {
+		xy[2 * v]     += dx;
+		xy[2 * v + 1] += dy;
+	}
 #else
 	(void)xy; (void)info; (void)sd; (void)g_offset; (void)g_size; (void)scale;
 	(void)x_pos; (void)y_pos;
