+    hdr_rest = rect(0, w * 20, 0, h * 20) + struct.pack('<HH', fps << 8, len(root_frames))
+    total = 8 + len(hdr_rest) + len(body)
+    return b'FWS' + bytes([version]) + struct.pack('<I', total) + hdr_rest + body
