+    return op(0x9b, p) + body
+
+
+def get(path):
+    """Push the value at a dotted path: a.b.c -> GetVariable a, GetMember b, c."""
+    parts = path.split('.')
+    code = push(parts[0]) + GETVAR
+    for q in parts[1:]:
