+    flags = 0x02 | 0x20
+    data = struct.pack('<HH', depth, cid)
+    if x or y:
+        flags |= 0x04
+        data += matrix_translate(x, y)
+    return tag(26, bytes([flags]) + data + s(name))
+
+
