+    return int(bits, 2).to_bytes(len(bits) // 8, 'big')
+
+
+def swf(version, defs, root_frames, w=400, h=300, fps=30, as3=False):
+    body = (tag(69, struct.pack('<I', 0x08 if as3 else 0)) + tag(9, b'\xff\xff\xff') + defs
