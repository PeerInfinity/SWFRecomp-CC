+	const float w_px = floorf(lw) * min_scale;  // AVM1 declares whole pixels
+	const float limit = (path->line_flags & STROKE_FLAG_PIXEL_HINTING) ? 3.875f : 3.125f;
+	return w_px >= limit;
+}
