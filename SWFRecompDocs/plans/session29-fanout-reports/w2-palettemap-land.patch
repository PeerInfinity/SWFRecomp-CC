+// paletteMap (operations.rs palette_map): per pixel, look each unmultiplied
+// source channel up in its 256-entry array and wrap-add the four FULL 32-bit
+// entries (no per-channel mask: the AVM1 arm, bitmapDataPaletteMap, is FP32-
+// pinned on avm1/bitmap_data_thorough/paletteMap). A missing / null / non-
+// object array is the identity mapping (i << shift). The sum is premultiplied
+// with the TARGET's transparency, so an opaque target keeps alpha 0xFF and the
+// colour as is (avm2/bitmapdata_palettemap_opaque, upstream 31e07df77).
+// Entries are read as arr[i]. Ruffle's AVM2 arm reads get_enumerant_value(i),
+// which is arr[i-1] (and 0 for i == 0); that off-by-one is NOT replicated.
+static Avm2Value bd_palette_map(Avm2Activation* act)
+{
+	Avm2Context* ctx = act->ctx;
+	Avm2BitmapDataExt* dst = this_bd(act);
+	check_valid(ctx, dst);
+	Avm2BitmapDataExt* src = avm2_bitmapdata_ext_of(ctx, arg(act, 0));
+	if (src == NULL) return avm2_undefined();
+	int32_t sx, sy, sw, sh;
+	rect_to_xywh(ctx, arg(act, 1), &sx, &sy, &sw, &sh);
+	int32_t dx, dy;
+	read_point_i32(ctx, arg(act, 2), &dx, &dy);
+	static const int shifts[4] = {16, 8, 0, 24};
+	uint32_t lut[4][256];
+	for (int ch = 0; ch < 4; ch++)
+	{
+		Avm2Value a = arg(act, 3 + (uint32_t) ch);
+		Avm2Object* o = a.kind == AVM2_VALUE_OBJECT ? a.u.obj : NULL;
+		Avm2Object* arr = (o != NULL && avm2_array_ext(o) != NULL) ? o : NULL;
+		for (uint32_t i = 0; i < 256; i++)
+		{
+			if (o == NULL) { lut[ch][i] = i << shifts[ch]; continue; }
+			Avm2Value v;
+			if (arr != NULL)
+			{
+				v = avm2_array_get(arr, i);
+				if (v.kind == AVM2_VALUE_HOLE) v = avm2_undefined();
+			}
+			else
+			{
+				char key[12];
+				int kl = snprintf(key, sizeof(key), "%u", i);
+				v = avm2_get_public_property(ctx, a, key, (uint32_t) kl, NULL);
+			}
+			lut[ch][i] = avm2_coerce_to_u32(ctx, v);
+		}
+	}
+	PixelRegion source_region = pr_whole(src->width, src->height);
+	PixelRegion dest_region = pr_whole(dst->width, dst->height);
+	pr_clamp_intersection(&dest_region, dx, dy, sx, sy, sw, sh, &source_region);
+	if (pr_w(&dest_region) == 0 || pr_h(&dest_region) == 0) return avm2_undefined();
+	uint32_t rh = pr_h(&dest_region) < pr_h(&source_region)
+		? pr_h(&dest_region) : pr_h(&source_region);
+	uint32_t rw = pr_w(&dest_region) < pr_w(&source_region)
+		? pr_w(&dest_region) : pr_w(&source_region);
+	for (uint32_t y = 0; y < rh; y++)
+		for (uint32_t x = 0; x < rw; x++)
+		{
+			uint32_t sc = unmul(bd_get_raw(src, source_region.x_min + x,
+			                               source_region.y_min + y));
+			uint32_t sum = lut[0][CR(sc)] + lut[1][CG(sc)]
+			             + lut[2][CB(sc)] + lut[3][CA(sc)];
+			bd_set_raw(dst, dest_region.x_min + x, dest_region.y_min + y,
+			           premul(sum, dst->transparency));
+		}
+	return avm2_undefined();
+}
