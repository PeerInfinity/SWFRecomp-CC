+				const char* nl = memchr(t->utf8 + 1, '\n', t->len - 1);
+				uint32_t off = nl != NULL ? (uint32_t) (nl - t->utf8) : t->len;
+				pl.stack_tail = avm2_string_new(ctx, t->utf8 + off, t->len - off);
+			}
+		}
