+# s30 w2-stroke-geometry-land: FP32 HIGH golden (output.expected.png = fp32.lnx.high.png
+# == fp32.win.high.png). Budgets = OUR outliers after gfx_curve_tol_scale
+# (HIGH 0.01 px drawing-API flattening), so the rows GUARD that rule: master
+# (0.1 px) exceeds every check. See regression/README.md.
+num_ticks = 1
+
+[[image_comparisons.output.checks]]
+tolerance = 0
+max_outliers = 5629
+
+[[image_comparisons.output.checks]]
+tolerance = 16
+max_outliers = 4448
+
+[[image_comparisons.output.checks]]
+tolerance = 64
+max_outliers = 1925
+
+[[image_comparisons.output.checks]]
+tolerance = 128
+max_outliers = 738
+
+[player_options]
+with_renderer = { optional = false, quality = "high" }
diff --git a/ruffle-tests/tests/swfs/regression/avm2_stroke_curve_scale_s1s4/Test.as b/ruffle-tests/tests/swfs/regression/avm2_stroke_curve_scale_s1s4/Test.as
new file mode 100644
index 000000000..658c309ef
--- /dev/null
+++ b/ruffle-tests/tests/swfs/regression/avm2_stroke_curve_scale_s1s4/Test.as
@@ -0,0 +1,24 @@
+package {
+  import flash.display.*;
+  [SWF(width="900", height="700", backgroundColor="#000000", frameRate="30")]
+  public class Test extends Sprite {
+    public function Test() {
+      var scales:Array = [1,4]; var widths:Array = [4,16]; var shapes:Array = [0,1]; var phases:Array = [0,0.3];
+      var x:Number = 10, y:Number = 10, rowH:Number = 0;
+      for each (var w:Number in widths) for each (var s:Number in scales) for each (var k:int in shapes) for each (var f:Number in phases) {
+        var sp:Sprite = new Sprite();
+        sp.graphics.lineStyle(w, 0x49D0D7);
+        sp.graphics.moveTo(0, 0);
+        if (k == 0) { sp.graphics.curveTo(20, 0, 20, 20); sp.graphics.curveTo(10, 30, 0, 20); }
+        else { sp.graphics.curveTo(10, 30, 20, 0); }
+        sp.scaleX = sp.scaleY = s;
+        var bw:Number = 24 * s + w * s, bh:Number = 32 * s + w * s;
+        if (x + bw > 900 - 10) { x = 10; y += rowH + 6; rowH = 0; }
+        sp.x = x + w * s / 2 + f; sp.y = y + w * s / 2 + f;
+        addChild(sp); trace("w=" + w + " s=" + s + " k=" + k + " f=" + f + " at " + sp.x + "," + sp.y);
+        x += bw + 6; if (bh > rowH) rowH = bh;
+      }
+      trace("bottom " + (y + rowH));
+    }
+  }
+}
