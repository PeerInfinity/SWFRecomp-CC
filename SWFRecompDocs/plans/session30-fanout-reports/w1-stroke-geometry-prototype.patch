@@ -9328,6 +9328,24 @@ static void gfx_build_stroke(Avm2GfxPath* path, const float* poly,
 // MoveTo(cursor), so a stroke run that starts in the MIDDLE of a subpath still
 // carries its first vertex. The curve start point is read at the absolute
 // index (cmds[i-1]), which for i == from > 0 is exactly that same cursor.
+// s30 w1-stroke-geometry PROTOTYPE: drawing-API curve flattening tolerance
+// scale. 0.1 (0.1 px -> 0.01 px) at HIGH; 1 at LOW (MSAA_SAMPLES == 1).
+// SWF_AVM2_CURVE_FINE=0 restores lyon's 0.1 px everywhere.
+static float gfx_curve_tol_scale(void)
+{
+#if defined(MSAA_SAMPLES) && MSAA_SAMPLES == 1
+	return 1.0f;
+#else
+	static float sc = -1.0f;
+	if (sc < 0.0f)
+	{
+		const char* e = getenv("SWF_AVM2_CURVE_FINE");
+		sc = (e != NULL && e[0] == '0') ? 1.0f : 0.1f;
+	}
+	return sc;
+#endif
+}
