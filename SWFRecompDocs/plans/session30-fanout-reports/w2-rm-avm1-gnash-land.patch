+    nb = max(max(abs(v).bit_length() for v in vals) + 1, 1)
+    bits = '{:05b}'.format(nb) + ''.join(format(v & ((1 << nb) - 1), '0{}b'.format(nb)) for v in vals)
+    bits += '0' * ((8 - len(bits) % 8) % 8)
+    return int(bits, 2).to_bytes(len(bits) // 8, 'big')
