diff --git a/ruffle-tests/tests/swfs/regression/lowq_glyph_probe_df2/test.toml b/ruffle-tests/tests/swfs/regression/lowq_glyph_probe_df2/test.toml
new file mode 100644
index 000000000..0c145086e
--- /dev/null
+++ b/ruffle-tests/tests/swfs/regression/lowq_glyph_probe_df2/test.toml
@@ -0,0 +1,19 @@
+num_ticks = 1
+
+# s30 w2-lowq-land. LOW glyph-raster probe (df2). Golden = Flash Player 32
+# quality LOW, LNX draw() capture (session30-fanout-reports/w1-local-oracles/
+# w1-lowq-residues/df2/fp32.lnx.low.png; LNX vs WIN and draw vs --screen differ
+# by 24-45 channels of host noise). The SWF sets _quality = "LOW" itself.
+# Generator: session30-fanout-reports/w1-lowq-residues-fixtures/lowq_glyph_probe/
+# create_test_swf.py. max_outliers = our measured channels at s30 w2-lowq-land
+# (it guards the LOW glyph rule; it is NOT a Flash-exact pass).
+# s30 w2-lowq-land: 56139 at master; 52527 with the field-local pen rule.
+# The rest is mostly layout: FP32 advances this field's DefineFont2 glyphs by
+# ceil(advance px) (SWF_TF_LOW_ADV_CEIL=1: 12891, HOLD) and the 48 px row's
+# baseline sits 1 px lower in Flash.
+[image_comparisons.output]
+tolerance = 2
+max_outliers = 52527
+
+[player_options]
+with_renderer = { optional = false, quality = "low" }
