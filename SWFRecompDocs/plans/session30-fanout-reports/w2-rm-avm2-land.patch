+		int roundUp = 0, bit53 = 0, bit54 = 0;
+		double factor = 1;
+		switch (radix)
+		{
+		case 32:
+			bit53 = v & (1 << 2);
+			bit54 = v & (1 << 1);
+			roundUp = (v & 1);
+			break;
+		case 16:
+			bit53 = v & (1 << 0);
+			v = pow2_digit(end, lim, radix);
+			if (v != -1)
+			{
+				factor *= radix;
+				bit54 = v & (1 << 3);
+				roundUp = (v & 0x3) != 0;
+			}
+			else
+			{
+				roundUp = bit53 != 0;
+			}
+			break;
+		case 8:
+		case 4:
+			v = pow2_digit(end, lim, radix);
+			if (v == -1) v = 0;
+			factor *= radix;
+			bit53 = v & (1 << 1);
+			bit54 = v & (1 << 0);
+			break;
+		case 2:
+			bit53 = v & (1 << 0);
+			v = pow2_digit(end, lim, radix);
+			if (v != -1)
+			{
+				factor *= radix;
+				bit54 = v & (1 << 0);
+			}
+			break;
+		}
+		bit53 = !!bit53;
+		bit54 = !!bit54;
