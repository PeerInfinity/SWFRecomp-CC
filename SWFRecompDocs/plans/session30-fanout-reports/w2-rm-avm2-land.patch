+	int32_t next;
+	for (next = 0; next * powOf2 <= 52; next++)
+	{
+		v = pow2_digit(end++, lim, radix);
+		if (v == -1)
+		{
+			v = 0;
+			break;
+		}
+		result = result * radix + v;
+		if (end >= lim) break;
+	}
+	if (next * powOf2 > 52)
