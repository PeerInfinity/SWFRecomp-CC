+			bit54 = v & (1 << 0);
+			break;
+		case 2:
+			bit53 = v & (1 << 0);
+			v = pow2_digit(end, lim, radix);
+			if (v != -1)
+			{
+				factor *= radix;
+				bit54 = v & (1 << 0);
+			}
+			break;
+		}
