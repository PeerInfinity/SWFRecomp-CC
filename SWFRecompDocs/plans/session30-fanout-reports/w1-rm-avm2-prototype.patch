+		case 32:
+			bit53 = v & (1 << 2);
+			bit54 = v & (1 << 1);
+			roundUp = (v & 1);
+			break;
+		case 16:
+			bit53 = v & (1 << 0);
+			v = pow2_digit(end, lim, radix);
+			if (v != -1)
+			{
+				factor *= radix;
+				bit54 = v & (1 << 3);
+				roundUp = (v & 0x3) != 0;
+			}
+			else
+			{
+				roundUp = bit53 != 0;
+			}
+			break;
+		case 8:
