+static void textFormatStoreCtorArgs(SWFAppContext* app_context, ASObject* tf_obj,
+                                    ActionVar* conv, int* has)
+{
+	for (u32 i = 0; i < TF_CTOR_ARGS; i++)
+		if (has[i])
+			setProperty(app_context, tf_obj, tf_ctor_arg_names[i], tf_ctor_arg_lens[i], &conv[i]);
+}
+
+// `new TextFormat(...)`.
+static ASObject* textFormatConstructNew(SWFAppContext* app_context, ActionVar* args, u32 num_args)
+{
+	initTextFormatPrototype(app_context);
+	ActionVar conv[TF_CTOR_ARGS];
+	int has[TF_CTOR_ARGS];
+	textFormatConvertCtorArgs(app_context, args, num_args, conv, has);
+	ASObject* tf_obj = allocObject(app_context, 24);
+	tf_obj->native_type = NATIVE_TEXTFORMAT;
+	if (!textFormatLinkProto(app_context, tf_obj))
+		setObjectProto(app_context, tf_obj);
+	textFormatInitInstanceFields(app_context, tf_obj);
+	textFormatStoreCtorArgs(app_context, tf_obj, conv, has);
+	return tf_obj;
+}
+
+// super(...) into TextFormat on an existing `this`. The arguments are always
+// converted; only an object without native data (of any class: a TextFormat,
+// a Date, an Array's bag are all native) becomes a TextFormat and gets the
+// own getTextExtent, with the lazy fields defined on its __proto__.
+static void textFormatConstructSuper(SWFAppContext* app_context, ASObject* obj, ActionVar* args, u32 num_args)
+{
+	initTextFormatPrototype(app_context);
+	ActionVar conv[TF_CTOR_ARGS];
+	int has[TF_CTOR_ARGS];
+	textFormatConvertCtorArgs(app_context, args, num_args, conv, has);
+	if (obj->native_type != NATIVE_NONE) return;
+	obj->native_type = NATIVE_TEXTFORMAT;
+	textFormatDefineLazyPropsOnValue(app_context, getProperty(obj, "__proto__", 9));
+	textFormatInitInstanceFields(app_context, obj);
+	textFormatStoreCtorArgs(app_context, obj, conv, has);
+}
