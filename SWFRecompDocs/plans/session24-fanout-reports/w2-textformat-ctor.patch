+// ---- TextFormat construction (shared by `new TextFormat`, native super() and
+// the TextField getTextFormat/getNewTextFormat builders). Ruffle
+// avm1/globals/text_format.rs `constructor` + `define_instance_properties`
+// (674bee2d8) + `define_lazy_proto_properties`.
+
+// getTextExtent: an ordinary (enumerable, writable, deletable) OWN property
+// holding a NEW function object per TextFormat, so
+// `a.getTextExtent === b.getTextExtent` is false.
+static void textFormatInstallGetTextExtent(SWFAppContext* app_context, ASObject* tf_obj)
+{
+	ASFunction* fn = (ASFunction*) calloc(1, sizeof(ASFunction));
+	if (fn == NULL) return;
+	actionGcLinkFunction(fn);
+	strncpy(fn->name, "getTextExtent", 255);
+	fn->function_type = 2;
+	fn->advanced_func = (Function2Ptr) textFormatGetTextExtent;
+	setupNativeFuncOwnProps(app_context, fn);
+	ActionVar v = {0};
+	v.type = ACTION_STACK_VALUE_FUNCTION;
+	v.data.numeric_value = (u64)(uintptr_t) fn;
+	setProperty(app_context, tf_obj, "getTextExtent", 13, &v);
+}
+
+// Define the lazy fields on a prototype VALUE: an object, or an Array (whose
+// non-index bag gets them, as for Video in actionOnVideoPlaced).
+static void textFormatDefineLazyPropsOnValue(SWFAppContext* app_context, const ActionVar* pv)
+{
+	if (pv == NULL || pv->data.numeric_value == 0) return;
+	if (pv->type == ACTION_STACK_VALUE_OBJECT)
+		textFormatDefineLazyProps(app_context, (ASObject*)(uintptr_t) pv->data.numeric_value);
+	else if (pv->type == ACTION_STACK_VALUE_ARRAY) {
+		ASArray* arr = (ASArray*)(uintptr_t) pv->data.numeric_value;
+		if (arr->props == NULL) { arr->props = allocObject(app_context, 4); retainObject(arr->props); }
+		textFormatDefineLazyProps(app_context, arr->props);
+	}
+}
+
+// Link a new TextFormat to the current TextFormat.prototype (DONTENUM
+// __proto__) and define the lazy fields there. An Array prototype lives in the
+// constructor's own_props (prototype_obj is NULL then); the instance __proto__
+// keeps the ARRAY type. Returns 0 if there is no object/array prototype.
+static int textFormatLinkProto(SWFAppContext* app_context, ASObject* tf_obj)
+{
+	ActionVar pv = {0};
+	if (g_textformat_constructor.prototype_obj != NULL) {
+		pv.type = ACTION_STACK_VALUE_OBJECT;
+		pv.data.numeric_value = (u64) g_textformat_constructor.prototype_obj;
+	} else if (g_textformat_constructor.own_props != NULL) {
+		ActionVar* own = getProperty(g_textformat_constructor.own_props, "prototype", 9);
+		if (own != NULL && own->type == ACTION_STACK_VALUE_ARRAY && own->data.numeric_value != 0)
+			pv = *own;
+	}
+	if (pv.type != ACTION_STACK_VALUE_OBJECT && pv.type != ACTION_STACK_VALUE_ARRAY)
+		return 0;
+	textFormatDefineLazyPropsOnValue(app_context, &pv);
+	setProperty(app_context, tf_obj, "__proto__", 9, &pv);
+	for (u32 i = 0; i < tf_obj->num_used; i++) {
+		if (strcmp(tf_obj->properties[i].name, "__proto__") == 0) {
+			tf_obj->properties[i].flags &= ~PROPERTY_FLAG_ENUMERABLE;
+			break;
+		}
+	}
+	return 1;
+}
+
+// The instance part of the constructor: all fields null except
+// display = "block", plus the own getTextExtent.
+static void textFormatInitInstanceFields(SWFAppContext* app_context, ASObject* tf_obj)
+{
+	ActionVar null_val = {0};
+	null_val.type = ACTION_STACK_VALUE_NULL;
+	for (int i = 0; i < TF_PROP_COUNT; i++)
+		setProperty(app_context, tf_obj, tf_prop_names[i], tf_prop_lens[i], &null_val);
+	ActionVar display_val = {0};
+	display_val.type = ACTION_STACK_VALUE_STRING;
+	display_val.data.numeric_value = (u64) u16_block;
+	display_val.str_size = 5;
+	setProperty(app_context, tf_obj, "display", 7, &display_val);
+	textFormatInstallGetTextExtent(app_context, tf_obj);
+}
+
+#define TF_CTOR_ARGS 13
+static const char* const tf_ctor_arg_names[TF_CTOR_ARGS] = {
+	"font", "size", "color", "bold", "italic", "underline",
+	"url", "target", "align", "leftMargin", "rightMargin", "indent", "leading"
+};
+static const u32 tf_ctor_arg_lens[TF_CTOR_ARGS] = { 4, 4, 5, 4, 6, 9, 3, 6, 5, 10, 11, 6, 7 };
+
+// Convert the 13 constructor arguments, in order (so toString/valueOf side
+// effects happen even when nothing is stored -- Flash converts them before it
+// checks for existing native data). has[i] = 0 keeps the field null.
+// - font: string (objects via toString), truncated to 64 chars
+// - url/target: string for objects via toString, primitives raw
+// - size/leftMargin/rightMargin/indent/leading: truncate toward zero
+//   (objects via valueOf; NaN/Inf -> -2147483648)
+// - color: uint32; bold/italic/underline: boolean; align: validated string
+static void textFormatConvertCtorArgs(SWFAppContext* app_context, ActionVar* args, u32 num_args,
+                                      ActionVar* out, int* has)
+{
+	// 0=font, 1=truncInt, 2=uint32, 3=bool, 4=align, 5=url/target
+	static const int ctor_coerce[TF_CTOR_ARGS] = { 0, 1, 2, 3, 3, 3, 5, 5, 4, 1, 1, 1, 1 };
+	for (u32 i = 0; i < TF_CTOR_ARGS; i++) {
+		has[i] = 0;
+		if (i >= num_args) continue;
+		if (args[i].type == ACTION_STACK_VALUE_NULL || args[i].type == ACTION_STACK_VALUE_UNDEFINED)
+			continue; // null/undefined -> null (keep the initialized null)
+		ActionVar coerced = args[i]; // default: store raw
+		switch (ctor_coerce[i]) {
+			case 0: // font -- toString for objects, truncate if > 64 chars
+			case 5: // url/target -- toString for objects, no truncation
+				if (coerced.type == ACTION_STACK_VALUE_OBJECT) {
+					coerced = tfCoerceString(app_context, &args[i]);
+					if (coerced.type == ACTION_STACK_VALUE_NULL) continue;
+				}
+				if (ctor_coerce[i] == 0 && coerced.type == ACTION_STACK_VALUE_STRING && coerced.str_size > TF_FONT_MAX_LENGTH) {
+					const uint16_t* _ctor_trunc_u16 = varGetU16Ptr(&coerced);
+					uint16_t* truncated = (uint16_t*) malloc((TF_FONT_MAX_LENGTH + 1) * sizeof(uint16_t));
+					memcpy(truncated, _ctor_trunc_u16, TF_FONT_MAX_LENGTH * sizeof(uint16_t));
+					truncated[TF_FONT_MAX_LENGTH] = 0;
+					coerced.data.numeric_value = (u64) truncated;
+					coerced.str_size = TF_FONT_MAX_LENGTH;
+				}
+				break;
+			case 1: { // truncate toward zero (size, margins, indent, leading)
+				double d = 0;
+				if (args[i].type == ACTION_STACK_VALUE_F64)
+					d = VAL(double, &args[i].data.numeric_value);
+				else if (args[i].type == ACTION_STACK_VALUE_F32)
+					d = (double) VAL(float, &args[i].data.numeric_value);
+				else if (args[i].type == ACTION_STACK_VALUE_BOOLEAN)
+					d = args[i].data.numeric_value ? 1.0 : 0.0;
+				else if (args[i].type == ACTION_STACK_VALUE_STRING) {
+					char _ctor_atof_buf[512];
+					const uint16_t* _ctor_atof_u16 = varGetU16Ptr(&args[i]);
+					u16_to_utf8(_ctor_atof_u16, args[i].str_size, _ctor_atof_buf, sizeof(_ctor_atof_buf));
+					d = atof(_ctor_atof_buf);
+				}
+				else if (args[i].type == ACTION_STACK_VALUE_OBJECT) {
+					int _vof_found = 0;
+					ActionVar vof = objectCallValueOf(app_context, &args[i], &_vof_found);
+					if (vof.type == ACTION_STACK_VALUE_F64)
+						d = VAL(double, &vof.data.numeric_value);
+					else if (vof.type == ACTION_STACK_VALUE_F32)
+						d = (double) VAL(float, &vof.data.numeric_value);
+					else
+						d = 0.0 / 0.0;
+				}
+				else break; // other non-numeric -> store raw
+				double v;
+				if (d != d || d == (1.0/0.0) || d == -(1.0/0.0))
+					v = -2147483648.0; // NaN/Inf
+				else
+					v = (d >= 0) ? floor(d) : -floor(-d);
+				coerced.type = ACTION_STACK_VALUE_F64;
+				coerced.data.numeric_value = VAL(u64, &v);
+				break;
+			}
+			case 2: // uint32
+				coerced = tfCoerceUnsigned(app_context, &args[i]);
+				break;
+			case 3: // boolean
+				coerced = tfCoerceBoolean(app_context, &args[i]);
+				break;
+			case 4: // align
+				coerced = tfCoerceAlign(app_context, &args[i], NULL);
+				if (coerced.type == 255) continue; // invalid -> keep null
+				break;
+		}
+		out[i] = coerced;
+		has[i] = 1;
+	}
+}
