+// s24 w2-text-pitch: compose a ROOT static-text (DefineText) instance's glyph
+// transforms into a per-INSTANCE run of dynamic slots, and cull it when its
+// placed tag bounds miss the stage.
+//
+// The glyph slots ch->transform_start+j are CHARACTER-shared, so two root
+// instances of one DefineText composed in place collapse onto the last writer
+// (visual/static_text_offstage: the (0,0) corner marker drew at (396,296)).
+// This is the same per-instance run compose_children allocates for nested
+// text (the Minesweeper fix). When the dynamic pool is full it falls back to
+// the shared in-place compose, as before.
+//
+// Cull: Flash (and Ruffle) skip a display object whose world bounds miss the
+// render target; for static text that is the DefineText TextBounds under the
+// placement matrix, grown by the filter chain's reach (a drop shadow can bring
+// off-stage text's halo on stage). Only when the root itself carries no AS
+// transform (otherwise the stage rect in root space is unknown here).
+static void compose_root_text_instance(SWFAppContext* app_context,
+                                       DisplayObject* obj, Character* ch)
+{
+	u32 tgbase = g_next_dynamic_xform_slot;
+	if (ch->text_size == 0 || tgbase + (u32)ch->text_size > g_xform_slot_capacity) {
+		renderer_compose_text_transforms(context,
+			app_context->transform_data,
+			obj->transform_id, ch->transform_start, ch->text_size);
+		return;
+	}
+	g_next_dynamic_xform_slot += (u32)ch->text_size;
+	text_glyph_overrides_push(obj);
+	obj->text_glyph_xform_base = tgbase;
+	const float* tf_all = (const float*)app_context->transform_data;
+	const float* place_m = tf_all + obj->transform_id * 16;
+
+	extern MovieClip root_movieclip;
+	s32 bx0, bx1, by0, by1;
+	if (root_movieclip.as_set_flags == 0
+	    && g_text_culled_count < MAX_TEXT_CULLED
+	    && ng_getCharBounds(obj->char_id, &bx0, &bx1, &by0, &by1)) {
+		float mnx = 1e30f, mny = 1e30f, mxx = -1e30f, mxy = -1e30f;
+		for (int k = 0; k < 4; k++) {
+			float lx = (k & 1) ? (float)bx1 : (float)bx0;
+			float ly = (k & 2) ? (float)by1 : (float)by0;
+			float wx = place_m[0] * lx + place_m[4] * ly + place_m[12];
+			float wy = place_m[1] * lx + place_m[5] * ly + place_m[13];
+			if (wx < mnx) mnx = wx;
+			if (wx > mxx) mxx = wx;
+			if (wy < mny) mny = wy;
+			if (wy > mxy) mxy = wy;
+		}
+		// Filter reach in stage px (vs = 1) -> twips.
+		FilterListEntry scratch;
+		const FilterListEntry* chain[MAX_FILTER_LIST_SIZE];
+		int fn = build_filter_chain(obj, &scratch, chain, MAX_FILTER_LIST_SIZE);
+		if (fn > 0) {
+			float grow = (float)(filter_chain_reach_px(chain, fn, 1.0) * 20.0);
+			mnx -= grow; mny -= grow; mxx += grow; mxy += grow;
+		}
+		float sw = (float)app_context->width * 20.0f, sh = (float)app_context->height * 20.0f;
+		if (mxx <= 0.0f || mxy <= 0.0f || mnx >= sw || mny >= sh)
+			g_text_culled[g_text_culled_count++] = obj;
+	}
+	for (size_t j = 0; j < ch->text_size; j++) {
+		float gc[16];
+		hit_test_mat4_multiply(gc, place_m, tf_all + (ch->transform_start + (u32)j) * 16);
+		renderer_write_transform(context, tgbase + (u32)j, gc);
+	}
+}
