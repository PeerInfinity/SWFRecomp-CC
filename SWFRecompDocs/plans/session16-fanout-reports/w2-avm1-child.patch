 	MovieClip* mc = getOrCreateLevel(app_context, level);
 	if (mc == NULL) return NULL;
+	// Ruffle loader.rs:61 LOADER_INSERTED_AVM1_DEPTH = -0xF000 (-61440): an AVM1
