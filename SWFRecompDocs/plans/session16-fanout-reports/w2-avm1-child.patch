@@ -12949,6 +12982,7 @@ static void input_deliver(Avm2Context* ctx, Avm2InputEvent* ev)
 		g_mouse_x = ev->x; g_mouse_y = ev->y;
 		g_mouse_btn_down[ev->button] = 0;
 		update_mouse_state(ctx, ev->button, moved);
