+// C string-literal body for a font / export name emitted into tagInit.
+static std::string escapeFontNameForC(const std::string& s)
+{
+	std::string out;
+	for (char c : s) {
+		if (c == '\\') out += "\\\\";
+		else if (c == '"') out += "\\\"";
+		else if (c == '\n') out += "\\n";
+		else if (c == '\r') out += "\\r";
+		else if (c == '\t') out += "\\t";
+		else if (c == '?') out += "\\?";
+		else out += c;
+	}
+	return out;
+}
