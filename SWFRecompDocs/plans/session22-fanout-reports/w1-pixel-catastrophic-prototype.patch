diff --git a/SWFModernRuntime/src/avm2/avm2_bitmap.c b/SWFModernRuntime/src/avm2/avm2_bitmap.c
index cb944e0a..a7c8fc4e 100644
--- a/SWFModernRuntime/src/avm2/avm2_bitmap.c
+++ b/SWFModernRuntime/src/avm2/avm2_bitmap.c
@@ -2626,8 +2626,30 @@ static Avm2Value bd_draw(Avm2Activation* act)
 	// the draw matrix's pixel translation (mtx,mty) is scaled to twips.
 	if (shape_src != NULL)
 	{
+		// PROTO clipRect (arg 4): snapshot, draw, restore outside the rect.
+		uint32_t* snap = NULL;
+		int cx0 = 0, cy0 = 0, cx1 = 0, cy1 = 0;
+		if (arg_present(act, 4) && act->args[4].kind == AVM2_VALUE_OBJECT && dst->pixels)
+		{
+			Avm2Value cr = act->args[4];
+			double rx = read_prop_num(ctx, cr, "x"), ry = read_prop_num(ctx, cr, "y");
+			double rw = read_prop_num(ctx, cr, "width"), rh = read_prop_num(ctx, cr, "height");
+			cx0 = (int) floor(rx); cy0 = (int) floor(ry);
+			cx1 = (int) floor(rx + rw); cy1 = (int) floor(ry + rh);
+			size_t n = (size_t) dst->width * dst->height;
+			snap = (uint32_t*) malloc(n * sizeof(uint32_t));
+			if (snap) memcpy(snap, dst->pixels, n * sizeof(uint32_t));
+		}
 		bd_draw_shape_walk(ctx, dst, shape_src, ma, mb, mc, md,
 		                   mtx * 20.0, mty * 20.0, 1.0, 0);
+		if (snap)
+		{
+			for (int y = 0; y < (int) dst->height; y++)
+				for (int x = 0; x < (int) dst->width; x++)
+					if (x < cx0 || x >= cx1 || y < cy0 || y >= cy1)
+						dst->pixels[(size_t) y * dst->width + x] = snap[(size_t) y * dst->width + x];
+			free(snap);
+		}
 		return avm2_undefined();
 	}
 
