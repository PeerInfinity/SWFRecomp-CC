+// BitmapData.draw() anti-aliasing gate (avm2_bitmap.c bd_draw): Ruffle draws
+// at the stage quality's sample count, so LOW is aliased.
+int avm2_stage_quality_is_low(void)
+{
+	return g_avm2_stage_quality == AVM2_SQ_LOW;
+}
