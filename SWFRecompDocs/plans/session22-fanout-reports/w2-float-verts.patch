+	// times, step = 2*acos(1 - tol/r). Ruffle strokes with
+	// StrokeOptions::DEFAULT_TOLERANCE (0.1 px) at scale 1, i.e. 2 twips here.
+	static int strokeArcSegments(double radius, double angle)
+	{
+		const double tolerance = std::min(2.0, radius);
+		if (radius <= 0.0)
+		{
+			return 1;
+		}
+		double step = 2.0*acos((radius - tolerance)/radius);
+		if (!(step > 0.0))
+		{
+			return 1;
+		}
+		double segments = ceil(fabs(angle)/step);
+		if (!(segments >= 1.0))
+		{
+			return 1;
+		}
+		int subdivisions = (int) std::lround(log2(segments));
+		if (subdivisions > 16)
+		{
+			subdivisions = 16;
+		}
+		return 1 << subdivisions;
+	}
