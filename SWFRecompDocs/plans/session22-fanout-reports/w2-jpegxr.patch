diff --git a/SWFModernRuntime/CMakeLists.txt b/SWFModernRuntime/CMakeLists.txt
index 3cf4ae089..bc1371c7f 100644
--- a/SWFModernRuntime/CMakeLists.txt
+++ b/SWFModernRuntime/CMakeLists.txt
@@ -23,6 +23,16 @@ else()
     option(WITH_LIBAVCODEC "Link libavcodec for full Flash video codec support" ON)
 endif()
 
+# Link jxrlib for JPEG-XR decode (Loader-loaded .jxr, Stage3D ATF formats 1/4;
+# src/avm2/avm2_jpegxr.c). Same defaults as libavcodec: ON for a native
+# graphics build, OFF for NO_GRAPHICS and Emscripten, where the decoder is a
+# stub. The ATF LZMA records use the xz `lzma` target linked below.
+if(NO_GRAPHICS OR EMSCRIPTEN)
+    option(WITH_LIBJXR "Link jxrlib for JPEG-XR decode" OFF)
+else()
+    option(WITH_LIBJXR "Link jxrlib for JPEG-XR decode" ON)
+endif()
+
 # Core sources (always included)
 set(CORE_SOURCES
     ${PROJECT_SOURCE_DIR}/src/actionmodern/action.c
@@ -121,6 +131,18 @@ else()
     message(STATUS "WITH_LIBAVCODEC: OFF — only ScreenVideo (codec id 3) will decode")
 endif()
 
+# jxrlib (libjxr-dev). avm2_jpegxr.c is the only TU that includes its headers.
+if(WITH_LIBJXR)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(LIBJXR REQUIRED IMPORTED_TARGET libjxr)
+    target_sources(${PROJECT_NAME} PRIVATE ${PROJECT_SOURCE_DIR}/src/avm2/avm2_jpegxr.c)
+    target_compile_definitions(${PROJECT_NAME} PRIVATE SWF_HAVE_LIBJXR)
+    target_link_libraries(${PROJECT_NAME} PUBLIC PkgConfig::LIBJXR)
+    message(STATUS "WITH_LIBJXR: ON (libjxr ${LIBJXR_VERSION})")
+else()
+    message(STATUS "WITH_LIBJXR: OFF — JPEG-XR content and ATF formats 1/4 stay undecoded")
+endif()
+
 if(NO_GRAPHICS)
     # Console-only: no graphics libraries needed
     target_link_libraries(${PROJECT_NAME} PUBLIC
diff --git a/SWFModernRuntime/include/avm2/avm2_jpegxr.h b/SWFModernRuntime/include/avm2/avm2_jpegxr.h
new file mode 100644
index 000000000..ef59149df
--- /dev/null
+++ b/SWFModernRuntime/include/avm2/avm2_jpegxr.h
@@ -0,0 +1,33 @@
+#ifndef AVM2_JPEGXR_H
+#define AVM2_JPEGXR_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+// JPEG-XR decode (jxrlib) for Loader-loaded .jxr content and the JPEG-XR-backed
+// Stage3D ATF formats. Every function is a stub returning 0 unless the build
+// defines SWF_HAVE_LIBJXR (verify_output.py graphics mode / CMake WITH_LIBJXR);
+// no-graphics and WASM builds never decode JPEG-XR.
+//
+// All jxrlib headers stay inside avm2_jpegxr.c: they define Bool / U8 / max
+// and friends, which would collide with runtime code.
+
+// Ruffle render/src/utils.rs decode_jpegxr: decode through jxrlib's TIFF
+// conversion and expand to straight (NOT premultiplied) RGBA8, which is what
+// the `image` crate's to_rgba8 yields. Returns 1 and a malloc()ed buffer of
+// w*h*4 bytes (caller free()s it), or 0.
+int avm2_jxr_decode_rgba(const uint8_t* data, size_t len,
+                         uint32_t* out_w, uint32_t* out_h, uint8_t** out_rgba);
+
+// Ruffle core/.../display3D/textures/atf_jpegxr.rs do_compressed_upload for
+// the JPEG-XR ATF formats: 0/1 (RGB888/RGBA8888, one JPEG-XR image) and
+// 4 (CompressedAlpha: LZMA DXT tables + JPEG-XR endpoint planes, rebuilt into
+// DXT5 and decoded here to RGBA8 because the Stage3D texel store is RGBA).
+// Only face 0, mip 0 is decoded, as in Ruffle. `atf` starts at the "ATF"
+// signature; `w`/`h` are the texture's size (already checked against the
+// header by the caller). Returns 1 and a malloc()ed w*h*4 RGBA8 buffer, or 0
+// for any other format or a decode failure (the texture is left untouched).
+int avm2_atf_jxr_decode(const uint8_t* atf, size_t len, uint32_t w, uint32_t h,
+                        uint8_t** out_rgba);
+
+#endif
