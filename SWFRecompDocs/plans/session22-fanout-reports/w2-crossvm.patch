+static int pk_in_scroll_rect(Avm2Context* ctx, Avm2Object* obj,
+                             Avm2DisplayObjectExt* ext, double px, double py)
+{
+	if (!ext->sr_committed) return 1;
+	Mat m = display_l2g_matrix(ctx, obj);
