+// One clip's `onData`. Deliberately a private copy of mc_call_as2_handler_ng's
+// invoke ritual rather than a call into it, for two reasons: that function is
+// owned by a sibling change this session, and it can only find handlers stored
+// in mc->dynamic_props — which is the wrong store for the ROOT clip, whose
+// timeline variables live in the global var_map (see actionSetVariable's
+// `_uq_target == &root_movieclip falls through to the global var_map` arm).
+// gnash's MovieClip.as installs its handler with a bare `onData = function(){}`
+// on the root timeline, so the root case has to resolve through the ordinary
+// variable chain.
+static void avm1FireFormDataEvent(SWFAppContext* app_context, MovieClip* mc)
+{
+	extern MovieClip root_movieclip;
+	if (mc == NULL || g_execution_halted) return;
+
+	ActionVar handler = {0};
+	handler.type = ACTION_STACK_VALUE_UNDEFINED;
+	if (mc->dynamic_props != NULL)
+	{
+		ActionVar* p = getPropertyWithPrototype((ASObject*) mc->dynamic_props, "onData", 6);
+		if (p != NULL) handler = *p;
+	}
+	if (handler.type != ACTION_STACK_VALUE_FUNCTION && mc == &root_movieclip)
+	{
+		MovieClip* _fd_saved = g_current_context;
+		actionSetCurrentContext(mc);
+		PUSH_STR("onData", 6);
+		actionGetVariable(app_context);
+		popVar(app_context, &handler);
+		actionSetCurrentContext(_fd_saved);
+	}
+	if (handler.type != ACTION_STACK_VALUE_FUNCTION) return;
+
+	ASFunction* func = (ASFunction*)(uintptr_t) handler.data.numeric_value;
+	if (func == NULL) return;
+	if (g_call_depth >= g_max_call_depth - 1) { g_execution_halted = 1; return; }
+
+	ActionVar this_var = {0};
+	this_var.type = ACTION_STACK_VALUE_MOVIECLIP;
+	this_var.data.numeric_value = (u64)(uintptr_t) mc;
+
+	g_inside_event_handler++;
+	// Ruffle dispatches this as ActionType::Method{args: vec![]}, so the
+	// handler sees a real zero-length `arguments` — MovieClip.as:2207 asserts
+	// `arguments.length == 0`. A type-2 body builds its own `arguments` in its
+	// prologue; a type-1 body has none unless the caller binds it on a local
+	// frame, hence INV_LOCAL_SCOPE + INV_ACT_ARGUMENTS on both arms. The frame
+	// holds only `this`/`arguments`, and actionSetVariable only writes to a
+	// scope frame that ALREADY carries the name, so the handler's own
+	// `dataLoaded++` still lands on the timeline.
+	InvokeOpts opts = { .flags = INV_THIS_STACK | INV_CAPTURED_SCOPE |
+	                             INV_VERSION_SWITCH | INV_LOCAL_SCOPE |
+	                             INV_BIND_THIS,
+	                    .act_flags = INV_ACT_ARGUMENTS };
+	if (func->function_type == 2)
+		opts.flags |= INV_LOCAL_SCOPE_MC | INV_EVENT_THIS_MC |
+		              INV_MC_THIS_NULL_PTR | INV_EXEC_FUNC;
+	g_call_depth++;
+	(void) invokeFunctionValue(app_context, func, &this_var, NULL, 0, &opts);
+	g_call_depth--;
+	g_inside_event_handler--;
+}
+
+static void avm1FireFormDataEvents(SWFAppContext* app_context)
+{
+	// Bounded re-entrant drain, mirroring processLoadVarsLoads' own
+	// `while (pending && guard++ < 16)` shape. An onData that issues another
+	// loadVariables (MovieClip-v6's two-round vars.txt handshake does exactly
+	// that) must still complete inside the movie's frame budget: our loads are
+	// synchronous reads out of the data registry, not real network fetches, so
+	// there is no latency to spread a chain over several ticks — and the
+	// gnash tests put the whole handshake in the LAST frame's script, leaving
+	// no later tick to drain into.
+	int guard = 0;
+	while (g_pending_form_data_count > 0 && guard++ < 8)
+	{
+		int count = g_pending_form_data_count;
+		MovieClip* pend[MAX_PENDING_FORM_DATA];
+		for (int i = 0; i < count; i++) pend[i] = g_pending_form_data[i];
+		g_pending_form_data_count = 0;
+		for (int i = 0; i < count; i++)
+		{
+			MovieClip* mc = pend[i];
+			if (mc == NULL || mc->depth == INT_MIN || mc->avm1_removed || mc->pending_removal)
+				continue;
+			avm1FireFormDataEvent(app_context, mc);
+		}
+	}
+}
