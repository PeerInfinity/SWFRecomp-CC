+// Rust's form_urlencoded::Serializer, which is what Activation::object_into_request
+// builds the GET query / POST body from: alphanumerics and `*-._` survive, a space
+// becomes '+', everything else is %XX. Deliberately NOT lv_url_encode — that one is
+// _global.escape (space → %20) and is user-overridable.
+static int avm1_form_urlencode(const char* in, int in_len, char* out, int out_cap)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	int o = 0;
+	for (int i = 0; i < in_len && o < out_cap - 4; i++)
+	{
+		unsigned char c = (unsigned char) in[i];
+		if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+		    (c >= '0' && c <= '9') || c == '*' || c == '-' || c == '.' || c == '_')
+			out[o++] = (char) c;
+		else if (c == ' ')
+			out[o++] = '+';
+		else { out[o++] = '%'; out[o++] = hex[c >> 4]; out[o++] = hex[c & 0x0F]; }
+	}
+	if (o < out_cap) out[o] = '\0';
+	return o;
+}
