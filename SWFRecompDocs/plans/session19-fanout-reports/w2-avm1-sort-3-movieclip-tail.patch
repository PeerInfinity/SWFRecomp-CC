+static void avm1QueueFormDataEvent(MovieClip* mc)
+{
+	if (mc == NULL) return;
+	if (g_pending_form_data_count < MAX_PENDING_FORM_DATA)
+		g_pending_form_data[g_pending_form_data_count++] = mc;
+}
