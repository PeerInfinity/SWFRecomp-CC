+// --- Deferred loadVariables `onData` queue ---------------------------------
+// Ruffle's load_form_into_object (core/src/loader.rs:1028-1042) parses the form
+// response into the target clip and then QUEUES `onData` on the action queue —
+// it never runs inside the caller's own frame. Our form loads are synchronous
+// file reads out of the test's data registry, so the parse has already
+// happened by the time we get here; only the event is deferred. The queue is
+// drained from actionFirePendingDirectLoads, which both frame loops
+// (libswf/swf_core.c and libswf/swf.c) already call once per tick, so this
+// needs no new call site in either loop.
+//
+// Entries are NOT deduplicated: Flash fires one onData per completed load, and
+// the drain copies-and-clears before dispatching, so an onData that issues
+// another loadVariables (from_gnash actionscript.all/MovieClip-v6 does exactly
+// that) lands on the NEXT tick rather than recursing.
+#define MAX_PENDING_FORM_DATA 16
+static MovieClip* g_pending_form_data[MAX_PENDING_FORM_DATA];
+static int g_pending_form_data_count = 0;
