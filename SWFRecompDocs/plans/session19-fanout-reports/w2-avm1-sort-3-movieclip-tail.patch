+// Ruffle's load_form_into_object body (core/src/loader.rs:990-1027): fetch the
+// URL, decode it per the charset rules, and set every "k=v" pair on the target
+// clip. Factored out of actionGetURL2's loadVariables branch so the
+// MovieClip.loadVariables METHOD form shares one implementation with the
+// ActionGetURL2 TAG form. `url` may carry a GET query string (object_into_request
+// appends the caller's form values to it); the data-registry lookup uses the
+// path part only.
+// Returns 1 when the fetch resolved to a real payload (Ruffle's future resolved
+// Ok, i.e. the point at which it queues `onData`); 0 on a miss, where Ruffle's
+// future errors out and no event fires.
+static int avm1LoadFormIntoMC(SWFAppContext* app_context, MovieClip* mc, const char* url)
+{
+	extern DataFileEntry* findDataFile(const char* name);
+	if (mc == NULL || url == NULL || url[0] == '\0') return 0;
+
+	char path[512];
+	size_t n = 0;
+	while (url[n] != '\0' && url[n] != '?' && n < sizeof(path) - 1) { path[n] = url[n]; n++; }
+	path[n] = '\0';
+
+	DataFileEntry* data = findDataFile(path);
+	if (data == NULL || data->content == NULL || data->content_length <= 0) return 0;
+	int len = data->content_length;
+	if (len > 4096) len = 4096;
+
+	// The form loader is charset-aware; every other loader (LoadVars.load,
+	// XML.load, StyleSheet.load) is not. Mirrors Ruffle's load_form_into_object
+	// (core/src/loader.rs:1004-1022): useCodepage sniffs, else a root SWF of
+	// version <= 5 is windows-1252, else the bytes pass through untouched. The
+	// version has to be the ROOT movie's — g_swf_version is swapped per call
+	// frame, g_main_movie_swf_version is not.
+	LegacyCharset cs;
+	if (avm1_system_use_codepage()) {
+		cs = legacy_charset_detect((const unsigned char*) data->content, len);
+	} else if (g_main_movie_swf_version <= 5) {
+		cs = LEGACY_CS_WINDOWS_1252;
+	} else {
+		cs = LEGACY_CS_UTF8;   // verbatim
+	}
+
+	// Heap, not a 4097-byte stack buffer: decoding expands (up to 3x) and
+	// parseURLEncodedVars mutates its argument.
+	char* buf = legacy_charset_to_utf8((const unsigned char*) data->content, len, cs, NULL);
+	if (buf != NULL) {
+		parseURLEncodedVars(app_context, buf, mc);
+		free(buf);
+	}
+	return 1;
+}
