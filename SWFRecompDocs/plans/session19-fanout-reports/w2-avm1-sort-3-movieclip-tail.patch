+// The "Navigator::fetch:" block MovieClip.loadVariables(url, method) issues.
+// Ruffle: object_into_request(clip, url, method) — GET appends the clip's own
+// variables to the query string, POST sends them as an
+// application/x-www-form-urlencoded body; no method at all is a bare GET with
+// neither. send_vars_method: 0 = none, 1 = GET, 2 = POST.
+static void avm1_log_form_fetch(SWFAppContext* app_context, MovieClip* mc,
+                                const char* url, u8 send_vars_method)
+{
+	if (url == NULL) return;
+	if (send_vars_method == 0)
+	{
+		swf_log_fetch_queue(url, strlen(url), "GET", 3, NULL, 0, NULL, 0, NULL, 0, 0, 0);
+		swf_log_fetch_flush();
+		return;
+	}
+
+	SwfLogPair pairs[AVM1_MAX_NAV_PARAMS];
+	char pbuf[AVM1_NAV_PARAM_BUF];
+	size_t np = avm1_collect_form_values(app_context, mc, pairs,
+	                                     AVM1_MAX_NAV_PARAMS, pbuf, sizeof(pbuf));
+	char q[AVM1_NAV_PARAM_BUF * 3];
+	int qn = 0;
+	for (size_t i = 0; i < np; i++)
+	{
+		if (qn > 0 && qn < (int) sizeof(q) - 1) q[qn++] = '&';
+		qn += avm1_form_urlencode(pairs[i].name, (int) pairs[i].name_len,
+		                          q + qn, (int) sizeof(q) - qn);
+		if (qn < (int) sizeof(q) - 1) q[qn++] = '=';
+		qn += avm1_form_urlencode(pairs[i].value, (int) pairs[i].value_len,
+		                          q + qn, (int) sizeof(q) - qn);
+	}
+	q[qn] = '\0';
+
+	if (send_vars_method == 2)
+	{
+		swf_log_fetch_queue(url, strlen(url), "POST", 4, NULL, 0,
+		                    "application/x-www-form-urlencoded", 33,
+		                    (const unsigned char*) q, (size_t) qn, 1, 1);
+	}
+	else
+	{
+		char full[1024];
+		const char* sep = (strchr(url, '?') != NULL) ? "&" : "?";
+		int fn = snprintf(full, sizeof(full), "%s%s%s", url, sep, q);
+		if (fn < 0) fn = 0;
+		if (fn > (int) sizeof(full) - 1) fn = (int) sizeof(full) - 1;
+		swf_log_fetch_queue(full, (size_t) fn, "GET", 3, NULL, 0, NULL, 0, NULL, 0, 0, 0);
+	}
+	swf_log_fetch_flush();
+}
