+struct S3dBackend
+{
+	uint32_t w, h;
+	uint32_t samples;           // 1 or 4
+	uint8_t has_depth;
+	uint8_t presented;
+	float* color;               // w*h*samples*4 (RGBA, linear 0..1)
+	float* depth;               // w*h*samples
+	uint32_t* front;            // w*h ARGB8888, resolved at present()
