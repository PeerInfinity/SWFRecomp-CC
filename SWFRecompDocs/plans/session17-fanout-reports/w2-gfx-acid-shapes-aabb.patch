+	int32_t y = twips_from_pixels(y_px);
+	int32_t r = gfx_stroke_radius_tw(g);
+	draw_union_shape_tw(ext, x - r, y - r);
+	draw_union_shape_tw(ext, x + r, y + r);
+	draw_union_edge_tw(ext, x, y);
+}
