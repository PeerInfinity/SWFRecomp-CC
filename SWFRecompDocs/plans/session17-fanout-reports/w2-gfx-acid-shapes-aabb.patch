+static void draw_union_point(Avm2DisplayObjectExt* ext, double x_px, double y_px)
+{
+	int32_t x = twips_from_pixels(x_px);
+	int32_t y = twips_from_pixels(y_px);
+	draw_union_shape_tw(ext, x, y);
