+	const float d0[9] = { m[5], m[6], m[7], m[9], m[10], m[11], m[13], m[14], m[15] };
+	const float d4[9] = { m[1], m[2], m[3], m[9], m[10], m[11], m[13], m[14], m[15] };
+	const float d8[9] = { m[1], m[2], m[3], m[5], m[6], m[7], m[13], m[14], m[15] };
