+// Create (or replace) the ExternalSound record - mirrors `ExternalSound::empty`:
+// a FRESH default transform (volume 100, identity matrix), will_autoplay =
+// is_streaming, is_loading = true. Called by every `loadSound(<arg>)` that
+// passes the has_valid_owner gate, including `loadSound("")`.
+static void soundCreateExternal(SWFAppContext* app_context, ASObject* sound_obj, int is_streaming, double load_id)
+{
+	ASObject* xf = allocObject(app_context, 8);
+	if (xf != NULL)
+	{
+		initSoundTransformDefaults(app_context, xf);
+		ActionVar xv = {0};
+		xv.type = ACTION_STACK_VALUE_OBJECT;
+		xv.data.numeric_value = (u64) (uintptr_t) xf;
+		// setPropertyWithFlags retains the new value and releases the old one,
+		// so replacing the record drops the previous transform object.
+		setPropertyWithFlags(app_context, sound_obj, "__ext_xform__", 13, &xv, PROPERTY_FLAGS_DONTENUM);
+		releaseObject(app_context, xf);   // drop allocObject's initial reference
+	}
+	soundSetExtFlag(app_context, sound_obj, "__ext__", 7, 1);
+	soundSetExtFlag(app_context, sound_obj, "__ext_stream__", 14, is_streaming);
+	soundSetExtFlag(app_context, sound_obj, "__ext_auto__", 12, is_streaming);
+	soundSetExtFlag(app_context, sound_obj, "__ext_loading__", 15, 1);
+	soundSetExtNum(app_context, sound_obj, "__ext_loadid__", 14, load_id);
+}
