+// Shared CBR-MP3 metadata pass. Parses the ID3v2 tag (returned through
+// *out_id3, NULL when absent or malformed), skips it, and returns the
+// duration estimate in milliseconds from the first MPEG frame header.
+// Extracted from builtin_sound_loadSound so the synchronous (local) load and
+// the deferred (remote) load share one implementation.
+static double soundParseMp3Meta(SWFAppContext* app_context, const unsigned char* data, int len, ASObject** out_id3)
+{
+	if (out_id3 != NULL) *out_id3 = NULL;
+	if (data == NULL || len <= 0) return 0.0;
+
+	const unsigned char* mp3 = data;
+	int mp3_len = len;
+
+	ASObject* id3_obj = parseID3v2Tags(app_context, mp3, mp3_len);
+	if (out_id3 != NULL) *out_id3 = id3_obj;
+
+	if (mp3_len >= 10 && mp3[0] == 'I' && mp3[1] == 'D' && mp3[2] == '3')
+	{
+		int id3_size = ((mp3[6] & 0x7F) << 21) | ((mp3[7] & 0x7F) << 14) |
+		               ((mp3[8] & 0x7F) << 7) | (mp3[9] & 0x7F);
+		int audio_offset = id3_size + 10;
+		mp3 += audio_offset;
+		mp3_len -= audio_offset;
+	}
+
+	if (mp3_len >= 4 && mp3[0] == 0xFF && (mp3[1] & 0xE0) == 0xE0)
+	{
+		// MPEG audio frame header
+		int version = (mp3[1] >> 3) & 3; // 0=2.5, 2=2, 3=1
+		int layer = (mp3[1] >> 1) & 3;   // 1=III, 2=II, 3=I
+		int br_idx = (mp3[2] >> 4) & 0xF;
+
+		// Bitrate table for MPEG1 Layer III
+		static const int bitrates_v1_l3[] = {0,32,40,48,56,64,80,96,112,128,160,192,224,256,320,0};
+
+		int bitrate = 0;
+		if (version == 3 && layer == 1) // MPEG1 Layer III
+			bitrate = bitrates_v1_l3[br_idx] * 1000;
+		else if (version == 3 && layer == 2) { // MPEG1 Layer II
+			static const int bitrates_v1_l2[] = {0,32,48,56,64,80,96,112,128,160,192,224,256,320,384,0};
+			bitrate = bitrates_v1_l2[br_idx] * 1000;
+		}
+		else if ((version == 0 || version == 2) && layer == 1) { // MPEG2 / MPEG2.5 Layer III
+			static const int bitrates_v2_l3[] = {0,8,16,24,32,40,48,56,64,80,96,112,128,144,160,0};
+			bitrate = bitrates_v2_l3[br_idx] * 1000;
+		}
+
+		if (bitrate > 0)
+			return (double)mp3_len * 8.0 / (double)bitrate * 1000.0;
+		return 1000.0; // fallback
+	}
+	return 1000.0; // fallback for non-standard MP3
+}
