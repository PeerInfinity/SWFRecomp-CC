+#ifdef HAS_DATA_FILES
+// Resolve a scheme'd sound URL to a bundled data file. Ruffle's test navigator
+// maps `http://<host>/<path>` onto `<test_dir>/<host>/<path>`, and
+// verify_output.py's find_data_files registers the file under exactly that
+// relative key ("localhost/noise.mp3") — so the basename-only lookup the local
+// path uses misses it. Same resolution order as avm1_amf.c's
+// nc_resolve_response (kept as a private static rather than exported).
+static DataFileEntry* soundResolveUrlData(const char* url)
+{
+	const char* scheme = strstr(url, "://");
+	const char* rest = (scheme != NULL) ? scheme + 3 : url;
+	const char* slash = strchr(rest, '/');
+	if (slash == NULL || slash[1] == '\0') return NULL;
+
+	// "localhost:8000/noise.mp3" -> try "localhost/noise.mp3" then "noise.mp3".
+	char rel[512];
+	size_t hostlen = (size_t) (slash - rest);
+	const char* colon = (const char*) memchr(rest, ':', hostlen);
+	size_t hnlen = (colon != NULL) ? (size_t) (colon - rest) : hostlen;
+	if (hnlen + 1 + strlen(slash + 1) + 1 <= sizeof(rel))
+	{
+		memcpy(rel, rest, hnlen);
+		rel[hnlen] = '/';
+		snprintf(rel + hnlen + 1, sizeof(rel) - hnlen - 1, "%s", slash + 1);
+		DataFileEntry* d = findDataFile(rel);
+		if (d != NULL && d->content != NULL) return d;
+	}
+	const char* base = strrchr(url, '/');
+	base = (base != NULL) ? base + 1 : url;
+	if (base[0] == '\0') return NULL;
+	DataFileEntry* d = findDataFile(base);
+	if (d != NULL && d->content != NULL) return d;
+	return NULL;
+}
+#endif
