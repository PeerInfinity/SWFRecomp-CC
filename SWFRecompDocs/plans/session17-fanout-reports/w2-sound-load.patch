+		// Stale-completion guard (Ruffle loader.rs:1425-1432): a second
+		// loadSound() bumped the generation, so this completion is dropped.
+		if (soundIsExternal(sound_obj) &&
+		    soundExtNum(sound_obj, "__ext_loadid__", 14) == d->load_id)
+		{
+			int success = 0;
+			double duration_ms = 0.0;
+			if (d->content != NULL && d->content_length > 0)
+			{
+				ASObject* id3_obj = NULL;
+				duration_ms = soundParseMp3Meta(app_context, (const unsigned char*) d->content,
+				                                (int) d->content_length, &id3_obj);
+
+				ActionVar dv = {0}; dv.type = ACTION_STACK_VALUE_F64;
+				VAL(double, &dv.data.numeric_value) = duration_ms;
+				setProperty(app_context, sound_obj, "__duration__", 12, &dv);
+				ActionVar pv = {0}; pv.type = ACTION_STACK_VALUE_F64;
+				setProperty(app_context, sound_obj, "__position__", 12, &pv);
+				ActionVar lv = {0}; lv.type = ACTION_STACK_VALUE_BOOLEAN; lv.data.numeric_value = 1;
+				setProperty(app_context, sound_obj, "__loaded__", 10, &lv);
+				soundSetExtNum(app_context, sound_obj, "__bytes_total__", 15, (double) d->content_length);
+
+				if (id3_obj != NULL)
+				{
+					ActionVar id3_var = {0}; id3_var.type = ACTION_STACK_VALUE_OBJECT;
+					id3_var.data.numeric_value = (u64) (uintptr_t) id3_obj;
+					setPropertyWithFlags(app_context, sound_obj, "__id3__", 7, &id3_var, PROPERTY_FLAGS_DONTENUM);
+					// getDuration() reads 0 during onID3 (mirrors the sync path).
+					ActionVar zero = {0}; zero.type = ACTION_STACK_VALUE_F64;
+					setProperty(app_context, sound_obj, "__duration__", 12, &zero);
+					ActionVar ok = {0}; ok.type = ACTION_STACK_VALUE_BOOLEAN; ok.data.numeric_value = 1;
+					soundFireCallback(app_context, sound_obj, "onID3", 5, &ok, 1);
+					setProperty(app_context, sound_obj, "__duration__", 12, &dv);
+				}
+				success = 1;
+			}
+
+			soundSetExtFlag(app_context, sound_obj, "__ext_loading__", 15, 0);
+
+			ActionVar cb = {0}; cb.type = ACTION_STACK_VALUE_BOOLEAN;
+			cb.data.numeric_value = success ? 1 : 0;
+			soundFireCallback(app_context, sound_obj, "onLoad", 6, &cb, 1);
+
+			// Streaming sounds auto-play unless stop() ran before completion.
+			if (success && soundExtFlag(sound_obj, "__ext_auto__", 12))
+				soundStartExternalPlayback(sound_obj, duration_ms);
+		}
+		releaseObject(app_context, sound_obj);
+	}
+	free(d);
+}
