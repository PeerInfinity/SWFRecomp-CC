+// ---------------------------------------------------------------------------
+// ExternalSound record - Ruffle core/src/avm1/globals/sound.rs `ExternalSound`
+// (`Sound::external` is `Some` from the moment `loadSound(<any arg>)` is
+// called). The Sound is then permanently "separated" from its original owner:
+// it gets its OWN sound transform (checked BEFORE global and owner),
+// `owner()` returns None, and `has_valid_owner()` is unconditionally true.
+// Modelled as DONTENUM properties on the Sound instance:
+//   __ext__          boolean  record present            (Sound::is_external)
+//   __ext_xform__    object   private transform         (ExternalSound::transform)
+//   __ext_stream__   boolean  is_streaming
+//   __ext_auto__     boolean  will_autoplay (cleared by stop())
+//   __ext_loading__  boolean  is_loading
+//   __ext_loadid__   number   load generation (stale-completion guard)
+//   __bytes_total__  number   byte count of the loaded file (getBytes*)
+// ---------------------------------------------------------------------------
+static int soundIsExternal(ASObject* sound_obj)
+{
+	if (sound_obj == NULL) return 0;
+	ActionVar* v = getProperty(sound_obj, "__ext__", 7);
+	return (v != NULL && v->type == ACTION_STACK_VALUE_BOOLEAN && v->data.numeric_value) ? 1 : 0;
+}
+
+static ASObject* soundExternalTransform(ASObject* sound_obj)
+{
+	if (sound_obj == NULL) return NULL;
+	ActionVar* v = getProperty(sound_obj, "__ext_xform__", 13);
+	if (v == NULL || v->type != ACTION_STACK_VALUE_OBJECT) return NULL;
+	return (ASObject*) (uintptr_t) v->data.numeric_value;
+}
+
+static int soundExtFlag(ASObject* sound_obj, const char* name, u32 len)
+{
+	if (sound_obj == NULL) return 0;
+	ActionVar* v = getProperty(sound_obj, name, len);
+	return (v != NULL && v->type == ACTION_STACK_VALUE_BOOLEAN && v->data.numeric_value) ? 1 : 0;
+}
+
+static void soundSetExtFlag(SWFAppContext* app_context, ASObject* sound_obj, const char* name, u32 len, int on)
+{
+	ActionVar v = {0};
+	v.type = ACTION_STACK_VALUE_BOOLEAN;
+	v.data.numeric_value = on ? 1 : 0;
+	setPropertyWithFlags(app_context, sound_obj, name, len, &v, PROPERTY_FLAGS_DONTENUM);
+}
+
+static double soundExtNum(ASObject* sound_obj, const char* name, u32 len)
+{
+	if (sound_obj == NULL) return 0.0;
+	ActionVar* v = getProperty(sound_obj, name, len);
+	if (v == NULL) return 0.0;
+	if (v->type == ACTION_STACK_VALUE_F64) return VAL(double, &v->data.numeric_value);
+	if (v->type == ACTION_STACK_VALUE_F32) return (double) VAL(float, &v->data.numeric_value);
+	return 0.0;
+}
+
+static void soundSetExtNum(SWFAppContext* app_context, ASObject* sound_obj, const char* name, u32 len, double d)
+{
+	ActionVar v = {0};
+	v.type = ACTION_STACK_VALUE_F64;
+	VAL(double, &v.data.numeric_value) = d;
+	setPropertyWithFlags(app_context, sound_obj, name, len, &v, PROPERTY_FLAGS_DONTENUM);
+}
