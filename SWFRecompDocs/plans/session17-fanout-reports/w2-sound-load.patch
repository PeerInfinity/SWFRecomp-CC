+// Deferred remote-load payload. `content` points at the static data-registry
+// buffer (no copy); NULL content means the URL resolved to nothing and the
+// load failed. Drained as an AQ_KIND_SCRIPT entry, i.e. right after the
+// in-progress frame script — exactly the deferral the three `_remote` tests
+// pin (sound_load_streaming_stop_remote's expected `before / after / onLoad
+// true` is impossible with a synchronous onLoad).
+typedef struct {
+	ASObject* sound;
+	const char* content;
+	u32 content_length;
+	double load_id;
+} SoundLoadDeferred;
+
+static void aq_dispatch_sound_load(SWFAppContext* app_context, void* user)
+{
+	SoundLoadDeferred* d = (SoundLoadDeferred*) user;
+	if (d == NULL) return;
+	ASObject* sound_obj = d->sound;
+	if (sound_obj != NULL)
