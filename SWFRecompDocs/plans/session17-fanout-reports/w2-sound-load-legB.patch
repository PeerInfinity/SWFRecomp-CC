+// Ruffle sound.rs:626-647 — only `file:` URLs load synchronously (the Flash
+// desktop projector blocks on local files). Anything else returns immediately
+// and completes asynchronously, so `loadSound` must NOT fire its callbacks
+// inside the calling script.
+static int soundUrlIsRemote(const char* url)
+{
+	const char* p = strstr(url, "://");
+	if (p == NULL) return 0;
+	if ((size_t)(p - url) == 4 && strncasecmp(url, "file", 4) == 0) return 0;
+	return 1;
+}
