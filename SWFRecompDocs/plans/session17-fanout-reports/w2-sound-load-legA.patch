+// Sound.getBytesLoaded() / Sound.getBytesTotal(). Ruffle stubs both to a
+// constant 1 (sound.rs:510-526), which makes it FAIL the six pre-load
+// `typeof(...) == 'undefined'` checks in from_gnash Sound.as (110/111,
+// 177/178, 336/337) that Flash passes. Gate on "externally loaded" instead:
+// undefined until a `loadSound()` has actually completed, the file's byte
+// count afterwards. attachSound()-ed sounds keep returning undefined (they
+// have no external byte stream), which is what those six checks pin.
+static ActionVar builtin_sound_getBytes(SWFAppContext* app_context, ActionVar* args, u32 arg_count, ActionVar* registers, void* this_obj)
+{
+	(void)args; (void)arg_count; (void)registers;
+	ActionVar ret = {0};
+	ret.type = ACTION_STACK_VALUE_UNDEFINED;
+	ASObject* sound_obj = resolveSoundThis(this_obj);
+	if (sound_obj == NULL) return ret;
+	if (!soundIsExternal(sound_obj)) return ret;
+	ActionVar* bl_loaded = getProperty(sound_obj, "__loaded__", 10);
+	if (bl_loaded == NULL || bl_loaded->type != ACTION_STACK_VALUE_BOOLEAN ||
+	    !bl_loaded->data.numeric_value)
+		return ret;
+	ret.type = ACTION_STACK_VALUE_F64;
+	VAL(double, &ret.data.numeric_value) = soundExtNum(sound_obj, "__bytes_total__", 15);
+	return ret;
+}
