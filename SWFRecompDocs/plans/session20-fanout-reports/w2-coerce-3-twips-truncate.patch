+// Ruffle's WRITE-side quantizer. `Twips::from_pixels(px)` is `(px * 20.0) as i32`
+// -- a Rust float->int cast, so it TRUNCATES TOWARD ZERO and saturates; `floor`
+// is a different function for a negative coordinate (`mc._x = -10.53` is -210.6
+// twips: Ruffle stores -210 = -10.5 px, `floor` stores -211 = -10.55 px), and
+// leaving the raw pixel value for the read side to `round` gives -10.55 too.
+// Quantizing on WRITE is also what makes the read exact: the stored float is a
+// twip multiple, which `spvTwipsQuantizePixels` recovers without error.
+static float spvTwipsTruncatePixels(double px)
+{
+	double t = trunc(px * 20.0);
+	if (t < (double)INT32_MIN) t = (double)INT32_MIN;
+	else if (t > (double)INT32_MAX) t = (double)INT32_MAX;
+	return (float)(t / 20.0);
+}
