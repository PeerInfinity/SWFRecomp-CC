-    ActionVar rx, ry, rw, rh;
+    double rx, ry, rw, rh;
     if (max_x == 0 && max_y == 0) {
-        rx = makeF64(0); ry = makeF64(0); rw = makeF64(0); rh = makeF64(0);
+        rx = 0; ry = 0; rw = 0; rh = 0;
     } else {
-        rx = makeF64(min_x); ry = makeF64(min_y);
-        rw = makeF64(max_x - min_x + 1); rh = makeF64(max_y - min_y + 1);
+        rx = min_x; ry = min_y;
+        rw = max_x - min_x + 1; rh = max_y - min_y + 1;
     }
-    ASObject* rect_obj = createRectObj(app_context, &rx, &ry, &rw, &rh);
-    r.type = ACTION_STACK_VALUE_OBJECT;
-    r.data.numeric_value = (u64) rect_obj;
-    return r;
+    // Ruffle get_color_bounds_rect CONSTRUCTS the result through
+    // `flash.geom.Rectangle` as resolved right now (bitmap_data.rs:732), so a
+    // script that replaced the class sees its own constructor run. Minting one
+    // internally was the defect avm1/bitmapdata_custom_rectangle grades.
+    ActionVar rect_var = {0};
+    if (!constructGeomRectDynamic(app_context, rx, ry, rw, rh, &rect_var)) {
+        r = makeF64(-1);
+        return r;
+    }
+    return rect_var;
 }
 
