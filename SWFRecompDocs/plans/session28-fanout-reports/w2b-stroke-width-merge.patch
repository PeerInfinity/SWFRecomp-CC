 }
 
+// s28 w2-flash-stroke-width: one stroke vertex offset d (local twips, from its
+// centreline point) re-expanded to Flash's device-space stroke of half-width
+// hw (device px) under M = [[m00 m01],[m10 m11]] (local twips -> device px).
+// Every vertex the recompiler emits is centre + d with d.n = h_e for the
+// normal(s) n of the edge(s) it offsets:
+//  - |d| = h_e: ONE normal n = d/|d| (a segment side, or a round join/cap arc
+//    point). It goes to the point whose DEVICE offset is hw along the DEVICE
+//    normal N = M^-T n / |M^-T n|, i.e. d' = M^-1 (hw N). On a segment that is
+//    the exact device-space offset line; on an arc, n sweeping n1..n2 maps
+//    monotonically onto N1..N2, so the join/cap becomes a true device circle
+//    of radius hw (Flash) instead of a local circle stretched by M (which
+//    bulged acid-stroke-0's sheared round joins to 115x50 vs Flash's 111x49).
+//  - |d| > h_e: a miter / inner-join vertex with TWO normals, recoverable from
+//    d alone (n = cos(phi) d^ +- sin(phi) d^perp, cos(phi) = h_e/|d|); solve
+//    d'.n_i = hw |M^-T n_i| for both (the intersection of the two device
+//    offset lines).
+static void hairline_flash_offset(double m00, double m01, double m10, double m11,
+                                  double det, double h_e, double hw,
+                                  double* io_dx, double* io_dy)
+{
+	const double dx = *io_dx, dy = *io_dy;
+	const double len = sqrt(dx * dx + dy * dy);
+	if (len < 1e-9) return;
+	const double ux = dx / len, uy = dy / len;
+	const double rr = len / h_e;
+	// |M^-T n| for a unit local normal n (M^-T n = (m11 nx - m10 ny,
+	// -m01 nx + m00 ny) / det).
+	#define HL_NT_X(nx_, ny_) (m11 * (nx_) - m10 * (ny_))
+	#define HL_NT_Y(nx_, ny_) (-m01 * (nx_) + m00 * (ny_))
+	#define HL_NSCALE(nx_, ny_) (hw * sqrt(HL_NT_X(nx_, ny_) * HL_NT_X(nx_, ny_) \
+	                                     + HL_NT_Y(nx_, ny_) * HL_NT_Y(nx_, ny_)) / fabs(det))
+	double ox, oy;
+	if (rr < 1.0 + 1e-3)
+	{
+		// N = M^-T n normalised (the 1/det keeps its sign), then M^-1 (hw N).
+		double qx = HL_NT_X(ux, uy), qy = HL_NT_Y(ux, uy);
+		const double ql = sqrt(qx * qx + qy * qy);
+		if (ql < 1e-18) return;
+		const double sg = (det > 0.0) ? 1.0 : -1.0;
+		qx *= sg * hw / ql; qy *= sg * hw / ql;     // device offset, px
+		ox = ( m11 * qx - m01 * qy) / det;
+		oy = (-m10 * qx + m00 * qy) / det;
+	}
+	else
+	{
+		const double cphi = 1.0 / rr, sphi = sqrt(1.0 - cphi * cphi);
+		const double n1x = cphi * ux - sphi * uy, n1y = cphi * uy + sphi * ux;
+		const double n2x = cphi * ux + sphi * uy, n2y = cphi * uy - sphi * ux;
+		const double t1 = HL_NSCALE(n1x, n1y), t2 = HL_NSCALE(n2x, n2y);
+		const double dd = n1x * n2y - n1y * n2x;
+		if (fabs(dd) < 1e-9) { const double f = HL_NSCALE(ux, uy); ox = ux * f; oy = uy * f; }
+		else { ox = (t1 * n2y - t2 * n1y) / dd; oy = (n1x * t2 - n2x * t1) / dd; }
+	}
+	#undef HL_NSCALE
+	#undef HL_NT_Y
+	#undef HL_NT_X
+	*io_dx = ox; *io_dy = oy;
+}
+
 static size_t hairline_restage(WebGPURenderContext* ctx, size_t offset,
                                size_t num_verts, u32 transform_id)
 {
@@ -3326,6 +3392,16 @@ static size_t hairline_restage(WebGPURenderContext* ctx, size_t offset,
 	}
 	// Stage-only scale (noScale strokes): device twips per stage twip.
 	const double stage_scale = sqrt(((hw * p[0]) * (hw * p[0]) + (hh * p[5]) * (hh * p[5])) / 2.0);
+	// s28 w2b-stroke-width-merge (w2-flash-stroke-width / w1-acid-flash P2):
+	// v = M*(1,1) in device twips per local twip; `scale` above is |v|/sqrt2.
+	// A matrix that is not a similarity (non-uniform scale or skew) gets its
+	// stroke offsets rebuilt in device space (hairline_flash_offset) instead
+	// of stretched by M.
+	const double v_x = 20.0 * (Ax + Bx), v_y = 20.0 * (Ay + By);
+	const double m_mag = fabs(Ax) + fabs(Bx) + fabs(Ay) + fabs(By);
+	const int similar = (fabs(Ax - By) + fabs(Bx + Ay) <= 1e-6 * m_mag)
+	                 || (fabs(Ax + By) + fabs(Bx - Ay) <= 1e-6 * m_mag);
+	const int flash_dev = hairline_flash_width && !similar && fabs(det) > 1e-12;
 
 	// With the snap tables every stroke run may move (snap or width
 	// quantisation); without them only the historical min-1px re-expansion.
@@ -3375,7 +3451,16 @@ static size_t hairline_restage(WebGPURenderContext* ctx, size_t offset,
 		// only; a single no*Scale flag keeps the normal scale (Flash scales a
 		// uniformly scaled noHScale / noVScale stroke; measured).
 		const int no_scale = (rf & 6u) == 6u;
-		const double dev_per_twip = (no_scale ? stage_scale : scale) / 20.0;
+		double s_dev = no_scale ? stage_scale : scale;
+		// s28 w2b: a SINGLE no*Scale flag scales with the other device axis
+		// of v: NoVScale (bit 2) |v.x|, NoHScale (bit 1) |v.y| (equal to the
+		// normal |v|/sqrt2 under a uniform scale, as n-stroke-snap measured).
+		if (hairline_flash_width && !no_scale)
+		{
+			if (rf & 4u) s_dev = fabs(v_x);
+			else if (rf & 2u) s_dev = fabs(v_y);
+		}
+		const double dev_per_twip = s_dev / 20.0;
 		const double w_px = (double) hairline_runs[r][3] * dev_per_twip;
 		const int u = (int) floor(4.0 * w_px + 0.5);
 		int W = 0;  // snapped integer width, 0 = AA
@@ -3419,7 +3504,16 @@ static size_t hairline_restage(WebGPURenderContext* ctx, size_t offset,
 			const double ox = vx.f - cx.f, oy = vy.f - cy.f;
 			double odx = Ax * ox + Bx * oy;
 			double ody = Ay * ox + By * oy;
-			if (axis != 0) { odx *= kx; ody *= ky; }
+			if (flash_dev)
+			{
+				// Device-space offset line / device-circle joins and caps of
+				// half-width target_px/2 (the snap below moves only the centre).
+				double lx = ox, ly = oy;
+				hairline_flash_offset(Ax, Bx, Ay, By, det, 0.5 * emitted, 0.5 * target_px, &lx, &ly);
+				odx = Ax * lx + Bx * ly;
+				ody = Ay * lx + By * ly;
+			}
+			else if (axis != 0) { odx *= kx; ody *= ky; }
 			else { odx *= k_uni; ody *= k_uni; }
 			// Flash rasterises on a quarter-pixel grid: centres land on it
 			// (with the half width a multiple of 1/4, so do the edges).
