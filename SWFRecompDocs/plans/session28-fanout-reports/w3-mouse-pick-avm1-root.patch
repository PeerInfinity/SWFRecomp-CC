+// s28 w3-mouse-pick-avm1-root: the AVM1-under-AVM2 tick
+// (actionTickAvm1ChildrenUnderAvm2) never runs either AVM1 frame loop, so
+// nothing promoted g_pending_mcl_loads_next_tick there: once C' sent every
+// frame-script loadClip to the next-tick bucket, an AVM1 child's loadClip
+// under an AVM2 Loader never fired (avm2/mouse_pick_avm1_root). That tick
+// calls this bucket move alone, at its top; the direct-load epoch stamp and
+// the advance-ran flag belong to the AVM1-root loops and stay out of it.
+void actionPromotePendingMCLLoadsUnderAvm2(void)
+{
+    mclPromoteNextTickBucket();
+}
+static void mclPromoteNextTickBucket(void)
+{
     int n = g_pending_mcl_load_count_next_tick;
