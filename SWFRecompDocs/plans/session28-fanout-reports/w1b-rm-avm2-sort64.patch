 }
 
+// FP32 is a 64-bit player: an int atom carries a 53-bit integer shifted
+// left by 3, and the SWF<11 compare truncates the 64-bit atom DIFFERENCE to
+// int32 (avm2/array_sort_swf10_64bit; the same SWF backs
+// array_sort_swf10_32bit, whose golden is a 32-bit player's).
+static int normalize_to_i53(Avm2Value v, int64_t* out)
+{
+	if (v.kind == AVM2_VALUE_INTEGER) { *out = v.u.i; return 1; }
+	if (v.kind == AVM2_VALUE_NUMBER)
+	{
+		double d = v.u.d;
+		if (d >= -9007199254740992.0 && d < 9007199254740992.0
+		    && d == floor(d) && !(d == 0.0 && signbit(d)))
+		{
+			*out = (int64_t) d;
+			return 1;
+		}
+	}
+	return 0;
+}
