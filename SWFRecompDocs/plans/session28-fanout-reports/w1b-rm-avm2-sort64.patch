+		uint64_t x = ((uint64_t) ia << 3) | 6u;
+		uint64_t y = ((uint64_t) ib << 3) | 6u;
+		int32_t diff = (int32_t) (uint32_t) (x - y);
 		return diff < 0 ? -1 : (diff > 0 ? 1 : 0);
 	}
 	double x = avm2_coerce_to_number(ctx, a);
