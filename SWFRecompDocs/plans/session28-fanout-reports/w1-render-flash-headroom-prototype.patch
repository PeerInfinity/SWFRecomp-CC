 	wgpuRenderPassEncoderSetBindGroup(ctx->render_pass, 2, ctx->fragment_sampler_bg, 0, NULL);
 
 	// Upload stage_to_ndc uniform
-	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0,
