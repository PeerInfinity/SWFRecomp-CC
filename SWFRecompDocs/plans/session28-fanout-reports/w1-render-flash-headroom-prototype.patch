+// s28 w1-render-flash-headroom PROTOTYPE: at MSAA_SAMPLES == 1 the lone
+// pixel-centre sample resolves an edge that passes exactly through it by the
+// rasteriser's top-left rule. Flash (and the Ruffle goldens) resolve the tie
+// the other way: a 1-px hairline centred on integer x paints pixel x, not x-1
+// (gnash misc-ming.all/shape_test: Flash root capture strokes at 100/160,
+// ours at 99/159). Shifting every vertex +1/256 device px right and down turns
+// each exact tie into the bottom-right rule without moving any non-tie sample.
+static void stage_upload_tiebias(WebGPURenderContext* ctx, const float m[16])
+{
+#if MSAA_SAMPLES == 1
+	float b[16];
+	memcpy(b, m, sizeof(b));
+	if (ctx->width > 0 && ctx->height > 0)
+	{
+		const float eps = 1.0f / 256.0f;
+		b[12] += 2.0f * eps / (float) ctx->width;
+		b[13] -= 2.0f * eps / (float) ctx->height;
+	}
+	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0, b, 16 * sizeof(float));
+#else
+	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0, m, 16 * sizeof(float));
+#endif
+}
+
 // Overwrites the stage_to_ndc uniform buffer. Called from tag.c after
 // render_webgpu_open_pass when _root has an AS-set transform to compose
 // (e.g. _root._x = 200 shifting the whole scene).
 void render_webgpu_upload_stage_transform(WebGPURenderContext* ctx, const float matrix[16])
 {
-	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0, matrix, 16 * sizeof(float));
+	stage_upload_tiebias(ctx, matrix);
 	hairline_note_stage(matrix);
 }
 
