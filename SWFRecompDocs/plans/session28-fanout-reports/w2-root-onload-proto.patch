+	_pr_opts.act_flags = _pr_act;
+	g_call_depth++;
+	(void) invokeFunctionValue(app_context, func, &_pr_this, NULL, 0, &_pr_opts);
+	g_call_depth--;
+	g_current_context = _pr_saved;
