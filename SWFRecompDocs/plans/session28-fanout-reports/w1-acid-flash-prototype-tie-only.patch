+// PROTOTYPE (s28 w1-acid-flash): Flash's aliased (quality LOW) rasteriser
+// resolves pixel-centre ties the other way from Vulkan/D3D's top-left rule:
+// a 1-px line centred on integer x covers device column x in Flash
+// (acid-shapes-testing's getRect boxes, Flash golden) but column x-1 here.
+// Nudging the stage by +1/128 device px on both axes (below the 1/20-px twip
+// grid, so no non-tied edge moves a pixel) flips exactly the ties.
+// LOWQ_SHIFT="x,y" overrides it for measurement.
+static void lowq_stage_shift(const WebGPURenderContext* ctx, const float in[16], float out[16])
+{
+	memcpy(out, in, 16 * sizeof(float));
+#if MSAA_SAMPLES == 1
+	static int init = 0; static float sx = 1.0f / 128.0f, sy = 1.0f / 128.0f;
+	if (!init) { const char* e = getenv("LOWQ_SHIFT"); if (e) sscanf(e, "%f,%f", &sx, &sy); init = 1; }
+	if (ctx->width > 0 && ctx->height > 0)
+	{
+		// translate by (sx, sy) device px: NDC x right, y up.
+		const float dx = 2.0f * sx / (float) ctx->width, dy = -2.0f * sy / (float) ctx->height;
+		out[12] += dx * in[15]; out[13] += dy * in[15];
+	}
+#else
+	(void) ctx;
+#endif
+}
+
 // Overwrites the stage_to_ndc uniform buffer. Called from tag.c after
 // render_webgpu_open_pass when _root has an AS-set transform to compose
 // (e.g. _root._x = 200 shifting the whole scene).
 void render_webgpu_upload_stage_transform(WebGPURenderContext* ctx, const float matrix[16])
 {
-	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0, matrix, 16 * sizeof(float));
+	float sh[16]; lowq_stage_shift(ctx, matrix, sh);
+	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0, sh, 16 * sizeof(float));
 	hairline_note_stage(matrix);
 }
 
