+#define COMPUTE_GLOBAL_AABB(the_mc, out_has, out_xmin, out_ymin, out_xmax, out_ymax) do { \
+	out_has = 0; \
+	/* Find MC's sprite_display_list */ \
+	DisplayObject* _hmc_dl = NULL; size_t _hmc_max = 0; \
