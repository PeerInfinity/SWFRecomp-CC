+// PROTOTYPE (s28 w1-avm2-vector-flash): quality=low coverage is shifted 0.5 px
+// down (Flash samples coverage at (x+0.5, y)); paint is re-centred here.
+// Bitmaps keep the pixel-centre texel; gradients evaluate at the left edge.
+#if MSAA_SAMPLES == 1
+#ifndef LOWQ_GRAD_GY
