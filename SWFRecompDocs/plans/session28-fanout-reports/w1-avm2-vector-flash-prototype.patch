+"  } else if ((in0.v_style_type & 0xF0u) == 0x40u) {\n" \
+"    in.v_args = vec4f(in0.v_args.xy + 0.5 * lq_dy.xy, in0.v_args.zw);\n" \
+"  }\n"
+#else
+#define LOWQ_PAINT_FIX ""
+#endif
+
 static const char* fragment_wgsl =
