+// avm2/graphics_draw_triangles' Flash golden agrees (cases 5/6, smoke rows).
+static int gfx_culling_mode(const Avm2String* c)
+{
+	if (gfx_str_is(c, "positive")) return 1;
+	if (gfx_str_is(c, "negative")) return 2;
+	return 0;
+}
