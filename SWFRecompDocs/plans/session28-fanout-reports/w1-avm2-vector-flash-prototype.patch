+#endif
+#define LOWQ_PAINT_FIX \
+"  let lq_dx = dpdx(in0.v_args);\n" \
+"  let lq_dy = dpdy(in0.v_args);\n" \
+"  if ((in0.v_style_type & 0xF0u) == 0x10u) {\n" \
