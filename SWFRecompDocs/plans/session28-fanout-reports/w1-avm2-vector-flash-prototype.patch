@@ -2970,12 +2991,41 @@ void render_webgpu_set_background(WebGPURenderContext* ctx, u8 r, u8 g, u8 b)
 	ctx->blue = b;
 }
 
+// PROTOTYPE (s28 w1-avm2-vector-flash): Flash samples coverage AND paint at
+// the top-left corner of each (sub)pixel; the GPU samples at the centre. At
+// quality=low (1 sample) shift the scene +0.5 device px right/down so the
+// GPU's centre sample lands where Flash's corner sample does.
+static void lowq_upload_stage(WebGPURenderContext* ctx, const float* m)
+{
+#if MSAA_SAMPLES == 1
+	float t[16];
+	memcpy(t, m, sizeof(t));
+	static float sx = -1.0f, sy = -1.0f;
+	if (sx < 0.0f)
+	{
+		const char* ex = getenv("LOWQ_SHIFT_X");
+		const char* ey = getenv("LOWQ_SHIFT_Y");
+		sx = ex ? (float) atof(ex) : 0.0f;
+		sy = ey ? (float) atof(ey) : 0.5f;
+	}
+	float tx = 2.0f * sx / (float) ctx->width, ty = -2.0f * sy / (float) ctx->height;
+	for (int c = 0; c < 4; c++)
+	{
+		t[c*4 + 0] += tx * m[c*4 + 3];
+		t[c*4 + 1] += ty * m[c*4 + 3];
+	}
+	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0, t, 16 * sizeof(float));
+#else
+	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0, m, 16 * sizeof(float));
+#endif
+}
+
 // Overwrites the stage_to_ndc uniform buffer. Called from tag.c after
 // render_webgpu_open_pass when _root has an AS-set transform to compose
 // (e.g. _root._x = 200 shifting the whole scene).
 void render_webgpu_upload_stage_transform(WebGPURenderContext* ctx, const float matrix[16])
 {
-	wgpuQueueWriteBuffer(ctx->queue, ctx->stage_to_ndc_buf, 0, matrix, 16 * sizeof(float));
+	lowq_upload_stage(ctx, matrix);
 	hairline_note_stage(matrix);
 }
 
