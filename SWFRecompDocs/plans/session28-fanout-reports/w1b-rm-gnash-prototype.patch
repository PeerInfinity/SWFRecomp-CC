+// w1b-rm-gnash prototype: String.prototype.valueOf is its own native in
+// Flash. A String wrapper returns its string; any other receiver returns
+// ToString(this) (FP32, gnash toString_valueOf.as:186-196: svo() ->
+// "_level0", function -> "[type Function]", new Boolean(false) -> "false").
+static ASFunction g_string_valueOf_func;
+static int g_string_valueOf_func_init = 0;
+static ActionVar builtin_string_proto_valueOf(SWFAppContext* app_context, ActionVar* args, u32 arg_count, ActionVar* registers, void* this_obj)
+{
+	ActionVar thisv = {0};
+	thisv.type = ACTION_STACK_VALUE_UNDEFINED;
+	if (this_obj != NULL && g_call_this_type == ACTION_STACK_VALUE_FUNCTION)
+		return makeStringActionVar(app_context, "[type Function]", 15);
+	if (this_obj != NULL && g_this_depth > 0 &&
+	    (g_this_stack[g_this_depth - 1].data.numeric_value == (u64) this_obj ||
+	     (g_this_stack[g_this_depth - 1].type == ACTION_STACK_VALUE_FUNCTION &&
+	      g_this_stack[g_this_depth - 1].data.numeric_value != 0 &&
+	      (void*)((ASFunction*)(uintptr_t)g_this_stack[g_this_depth - 1].data.numeric_value)->own_props == this_obj)))
+		thisv = g_this_stack[g_this_depth - 1];
+	else if (this_obj != NULL) {
+		thisv.type = ACTION_STACK_VALUE_OBJECT;
+		thisv.data.numeric_value = (u64) this_obj;
+	} else if (g_this_depth > 0)
+		thisv = g_this_stack[g_this_depth - 1];
+	if (thisv.type == ACTION_STACK_VALUE_UNDEFINED || thisv.type == ACTION_STACK_VALUE_NULL) {
+		thisv.type = ACTION_STACK_VALUE_MOVIECLIP;
+		thisv.data.numeric_value = (u64)(uintptr_t)(g_current_context ? g_current_context : &root_movieclip);
+	}
+	if (thisv.type == ACTION_STACK_VALUE_OBJECT && thisv.data.numeric_value != 0) {
+		ASObject* obj = (ASObject*) thisv.data.numeric_value;
+		ActionVar* prim = getProperty(obj, "valueOf_value", 13);
+		if ((prim != NULL && prim->type == ACTION_STACK_VALUE_STRING) ||
+		    obj == g_string_proto_valueof_self[0] || obj == g_string_proto_valueof_self[1])
+			return builtin_wrapper_valueOf(app_context, args, arg_count, registers, obj);
+	}
+	char buf[1024];
+	u32 n = (u32) varToStringBuf(app_context, &thisv, buf, sizeof(buf));
+	return makeStringActionVar(app_context, buf, n);
+}
+static ASFunction* stringValueOfFunc(void)
+{
+	if (!g_string_valueOf_func_init) {
+		memset(&g_string_valueOf_func, 0, sizeof(ASFunction));
+		strncpy(g_string_valueOf_func.name, "valueOf", 255);
+		g_string_valueOf_func.function_type = 2;
+		g_string_valueOf_func.advanced_func = (Function2Ptr) builtin_string_proto_valueOf;
+		if (function_count < MAX_FUNCTIONS) function_registry[function_count++] = &g_string_valueOf_func;
+		g_string_valueOf_func_init = 1;
+	}
+	return &g_string_valueOf_func;
+}
