+// w1b-rm-gnash prototype: an XML node's nodeName and nodeValue are mutually
+// exclusive in Flash Player 32. Writing one nulls the other when the node
+// carries it as an own non-null value (gnash XMLNode.as:79-83: a text node
+// renamed "foo" reads nodeValue null; XML.as:381+494: an element given
+// nodeValue=4 loses its tag name, so toString emits only attrs + children).
+static void xml_name_value_exclusive_after_set(SWFAppContext* ctx, ASObject* obj,
+	const char* name, u32 nlen)
+{
+	if (obj == NULL || (nlen != 8 && nlen != 9)) return;
+	const char* other = NULL; u32 olen = 0;
+	if (nlen == 9 && memcmp(name, "nodeValue", 9) == 0) { other = "nodeName"; olen = 8; }
+	else if (nlen == 8 && memcmp(name, "nodeName", 8) == 0) { other = "nodeValue"; olen = 9; }
+	if (other == NULL) return;
+	if (getProperty(obj, "nodeType", 8) == NULL) return;
+	ActionVar* o = getProperty(obj, other, olen);
+	if (o == NULL || o->type == ACTION_STACK_VALUE_NULL) return;
+	xml_set_null(ctx, obj, other, olen);
+}
