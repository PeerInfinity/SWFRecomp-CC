 // drawTriangles geometry: expand vertices(+indices) into a flat twips triangle
 // list. Flash stops at the first out-of-bounds index (mirrors TriangleData::new).
+// culling: 0 none, 1 positive, 2 negative. Ruffle TriangleCulling::cull on
+// the twips orientation (b-a)x(c-a): positive culls >= 0, negative <= 0.
+// avm2/graphics_draw_triangles' Flash golden agrees (cases 5/6, smoke rows).
+static int gfx_culling_mode(const Avm2String* c)
+{
+	if (gfx_str_is(c, "positive")) return 1;
+	if (gfx_str_is(c, "negative")) return 2;
+	return 0;
+}
