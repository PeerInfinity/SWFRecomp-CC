+SETVAR = op(0x1d)
+GETMEM = op(0x4e)
+SETMEM = op(0x4f)
+ADD2 = op(0x47)
+TRACE = op(0x26)
+STOP = op(0x07)
+POP = op(0x17)
+CALLM = op(0x52)
+CALLF = op(0x3d)
+TYPEOF = op(0x44)
+INITOBJ = op(0x43)
+DEFLOCAL = op(0x3c)
+RETURN = op(0x3e)
+NEWOBJ = op(0x40)
+EQ2 = op(0x49)
+
+
