+// s28 w3-interim2-regressions: the SWF6+/SWF7+ MovieClip.prototype methods
+// (initMovieClipPrototype tags them flash_flags 0x0080 / 0x0400, after
+// Ruffle movie_clip.rs VERSION_6 / VERSION_7) are invisible to SWF5 (and SWF6
+// for the 0x0400 pair) code: `mc.getDepth()` is a call of undefined and
+// yields undefined (FP32, regression/avm1_place_occupied_depth_swf5:
+// "ma.getDepth()= mb.getDepth()="; gnash MovieClip-v5 MovieClip.as:285
+// `mc.getNextHighestDepth() == undefined` PASSED). actionCallMethod's
+// MOVIECLIP arm dispatches these builtins by name and never consulted the
+// tag. Returns 1 when the call must resolve to undefined: the name is one of
+// the tagged stubs, MovieClip.prototype still holds that stub (no script
+// override), the clip has no own override, and the tag hides it at the
+// running version (so an ASSetPropFlags unhide re-exposes it).
+static int mcArmVersionHidden(SWFAppContext* app_context, MovieClip* mc, const char* name, u32 len)
+{
+	static const char* const k_gated[] = {
+		"getDepth", "setMask", "createEmptyMovieClip",
+		"getNextHighestDepth", "getInstanceAtDepth", NULL
+	};
+	if (g_swf_version >= 7) return 0;
+	const char* canon = NULL;
+	for (int i = 0; k_gated[i] != NULL; i++) {
+		if (strlen(k_gated[i]) == len && strncasecmp(k_gated[i], name, len) == 0) { canon = k_gated[i]; break; }
+	}
+	if (canon == NULL) return 0;
+	initMovieClipPrototype(app_context);
+	ASObject* proto = getMovieClipPrototype(g_swf_version);
+	if (proto == NULL) return 0;
+	ASProperty* p = findPropertyRaw(proto, canon, len);
+	if (p == NULL || p->value.type != ACTION_STACK_VALUE_FUNCTION) return 0;
+	ASFunction* f = (ASFunction*)(uintptr_t) p->value.data.numeric_value;
+	if (f < &g_mc_method_funcs[0] || f >= &g_mc_method_funcs[MC_METHOD_COUNT]) return 0;
+	if (!isPropertyHiddenAtVersion(p->flash_flags)) return 0;
+	if (mc != NULL && mc->dynamic_props != NULL &&
+	    findPropertyRaw((ASObject*) mc->dynamic_props, canon, len) != NULL) return 0;
+	return 1;
+}
