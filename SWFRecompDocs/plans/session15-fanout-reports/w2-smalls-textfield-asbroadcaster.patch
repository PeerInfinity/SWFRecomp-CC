+// See the forward declaration above initTextFieldPrototype.
+static void installTextFieldBroadcaster(SWFAppContext* app_context, MovieClip* mc)
+{
+    // SWF5 MC textfields are not instanceof TextField and get no TextField
+    // surface at all (see the __proto__ gates at every call site), so the
+    // broadcaster is SWF6+ too.
+    if (mc == NULL || g_swf_version < 6) return;
+    ASObject* props = (ASObject*) mc->dynamic_props;
+    if (props == NULL) return;
+    // Idempotent: the clone/timeline paths can re-enter for the same field,
+    // and re-initializing would drop listeners the script already added.
+    if (getProperty(props, "_listeners", 10) != NULL) return;
+
+    installAsBroadcaster(app_context, props);
+
+    ActionVar* lp = getProperty(props, "_listeners", 10);
+    if (lp == NULL || lp->type != ACTION_STACK_VALUE_ARRAY) return;
+    ASArray* arr = (ASArray*) (uintptr_t) lp->data.numeric_value;
+    if (arr == NULL) return;
+    ActionVar self = {0};
+    self.type = ACTION_STACK_VALUE_MOVIECLIP;
+    VAL(u64, &self.data.numeric_value) = (u64) mc;
+    setArrayElement(app_context, arr, 0, &self);
+}
