+// Resolve the broadcaster the three builtins below operate on. `this_obj` is
+// the receiver on the OBJECT dispatch arm; on the MOVIECLIP arm actionCallMethod
+// passes this_obj = NULL and communicates the receiver via g_event_this_mc
+// (same convention as builtin_object_valueOf), so a MovieClip-backed
+// broadcaster — a TextField instance, see installTextFieldBroadcaster — has to
+// be picked up from there or every call silently no-ops on a NULL receiver.
+static ASObject* broadcasterReceiver(void* this_obj)
+{
+    ASObject* receiver = (ASObject*) this_obj;
+    if (receiver == NULL) receiver = g_c_function_this_obj;
+    if (receiver == NULL && g_event_this_mc != NULL
+        && g_event_this_mc->depth != INT_MIN)
+    {
+        receiver = (ASObject*) g_event_this_mc->dynamic_props;
+    }
+    return receiver;
+}
