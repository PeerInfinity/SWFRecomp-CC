+		// depth than any real SWF and bounds the cost.
+		for (int pass = 0; pass < 8; ++pass)
+		{
+			bool moved = false;
+
+			for (auto& kv : placements)
+			{
+				auto parent = static_placement_scale.find(kv.first);
+
+				if (parent == static_placement_scale.end())
+				{
+					continue;
+				}
+
+				for (auto& child : kv.second)
+				{
+					float v = parent->second * child.second;
+					auto it = static_placement_scale.find(child.first);
+
+					if (it == static_placement_scale.end() || v > it->second)
+					{
+						static_placement_scale[child.first] = v;
+						moved = true;
+					}
+				}
+			}
+
+			if (!moved)
+			{
+				break;
+			}
+		}
+	}
