+	// Levien-scheduled twin of SWF::addCurvedEdge. Non-morph only, so no
+	// morph_index bookkeeping. Truncation to integer twips is kept verbatim
+	// (see the note in addCurvedEdge).
+	static void addCurvedEdgeLevien(Path* path, Vertex current, Vertex control,
+	                                Vertex anchor, const LevienParams& lp)
+	{
+		u32 n = (lp.count < 1) ? 1 : lp.count;
+
+		for (u32 i = 1; i <= n; ++i)
