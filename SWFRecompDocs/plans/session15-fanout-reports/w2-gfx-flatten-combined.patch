+		float integral_from;
+		float integral_step;
+		float inv_integral_from;
+		float div_inv_integral_diff;
+	};
+
+	static float levienParabolaIntegral(float x)
+	{
+		const float d = 0.67f;
+		return x / (1.0f - d + sqrtf(sqrtf(d*d*d*d + 0.25f*x*x)));
+	}
+
+	static float levienParabolaInvIntegral(float x)
