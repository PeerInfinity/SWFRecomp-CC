+void avm2_sort_decode_args(Avm2Context* ctx, const Avm2Value* args, uint32_t argc,
+                           Avm2Value* compare_fn, uint32_t* options)
+{
+	*compare_fn = avm2_undefined();
+	*options = 0;
+	if (argc == 0) return;
+	Avm2Value a0 = args[0];
