+			if (!sort_is_number(args[1])) sort_throw_1034(ctx, args[1], "Number");
+			*options = (uint32_t) avm2_coerce_to_i32(ctx, args[1]);
+		}
+		return;
 	}
+	if (sort_is_number(a0))
+	{
+		*options = (uint32_t) avm2_coerce_to_i32(ctx, a0);
+		return;
+	}
+	sort_throw_1034(ctx, a0, "Function");
