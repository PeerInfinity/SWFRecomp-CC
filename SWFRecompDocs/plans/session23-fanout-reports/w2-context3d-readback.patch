 // ---------------------------------------------------------------------------
 // Buffer uploads (index_buffer_3d.rs / vertex_buffer_3d.rs)
 // ---------------------------------------------------------------------------
@@ -3138,6 +3251,48 @@ static int agal_validate(const uint8_t* b, uint32_t len, int check_samplers,
 // Program3D.upload(vertexProgram, fragmentProgram). ShaderPairAgal::new parses
 // the vertex program, then the fragment program, then runs the sampler-config
 // pass on the fragment one — so a bad vertex program masks a bad fragment one.
+// The va<i> registers a (validated) vertex program reads, as a bitmask: every
+// source operand of every token (control flow included: this is a compile-time
+// property), and an indirect operand's index register too
+// (builder.rs emit_source_field_load_with_swizzle_out -> get_vertex_input).
+static int s3d_agal_binary(uint32_t op)
+{
+	switch (op)
+	{
+	case 0x00: case 0x05: case 0x08: case 0x09: case 0x0a: case 0x0c:
+	case 0x0d: case 0x0e: case 0x0f: case 0x10: case 0x14: case 0x15:
+	case 0x16: case 0x1a: case 0x1b: case AGAL_OP_KIL:
+		return 0;   // mov rcp frc sqt rsq log exp nrm sin cos abs neg sat ddx ddy kil
+	default:
+		return 1;
+	}
+}
+
+static uint8_t s3d_va_read_mask(const uint8_t* b, uint32_t len)
+{
+	uint8_t mask = 0;
+	if (b == NULL || len < 7) return 0;
+	for (uint32_t pos = 7; pos + 24 <= len; pos += 24)
+	{
+		uint32_t op = agal_u32le(b + pos);
+		if (!agal_has_sources(op)) continue;
+		for (int k = 0; k < 2; k++)
+		{
+			uint64_t src = agal_u64le(b + pos + 8 + 8 * k);
+			uint32_t reg = (uint32_t) (src & 0xFFFF);
+			uint32_t rtype = (uint32_t) ((src >> 32) & 0xF);
+			int indirect = (int) ((src >> 63) & 0x1);
+			if (indirect) rtype = (uint32_t) ((src >> 40) & 0xF);
+			// The sampler operand, and the zeroed second word of a one-source
+			// opcode (which would otherwise decode as va0).
+			if (k == 1 && (op == AGAL_OP_TEX || !s3d_agal_binary(op))) continue;
+			if (rtype == AGAL_REG_ATTRIBUTE && reg < S3D_ATTRS)
+				mask |= (uint8_t) (1u << reg);
+		}
+	}
+	return mask;
+}
