 	avm2_builtin_add_method(ctx, c3d, "present", context3d_present);
 	avm2_builtin_add_method(ctx, c3d, "clear", context3d_clear);
 	avm2_builtin_add_method(ctx, c3d, "drawTriangles", context3d_draw_triangles);
