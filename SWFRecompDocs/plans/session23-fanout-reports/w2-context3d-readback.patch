+// drawToBitmapData(destination) — Ruffle b36debbc7 + e0923f3cf
+// (context_3d.rs draw_to_bitmap_data). Order: #2007 on null; a silent no-op
+// before configureBackBuffer; #3692 when nothing cleared the buffers since the
+// last configureBackBuffer/present; then the BACK buffer (not the presented
+// front one, and the parked one while render-to-texture is open) is drawn 1:1
+// at the destination's top-left: clipped, never scaled, the rest of the
+// destination keeps its pixels. Ruffle does that with render_bitmap
+// (premultiplied src-over, no smoothing); the source texel is the back
+// buffer's MSAA resolve, i.e. the same per-sample quantise + floor-mean that
+// s3d_present / s3d_rtt_end use, alpha kept.
+static Avm2Value context3d_draw_to_bitmap_data(Avm2Activation* act)
+{
+	Avm2Context* ctx = act->ctx;
+	Avm2Object* dobj = s3d_arg_object_non_null(act, 0, "destination");
+	Avm2Context3DExt* ce = context3d_ext(act);
+	S3dBackend* be = (ce != NULL) ? ce->be : NULL;
+	if (be == NULL) return avm2_undefined();
+	int in_rtt = be->rtt_tex != NULL;
+	uint32_t bw = in_rtt ? be->bb_w : be->w;
+	uint32_t bh = in_rtt ? be->bb_h : be->h;
+	uint32_t ns = in_rtt ? be->bb_samples : be->samples;
+	const float* col = in_rtt ? be->bb_color : be->color;
+	if (bw == 0 || bh == 0 || col == NULL) return avm2_undefined();
+	if (!be->seen_clear)
+		avm2_throw_error(ctx, NULL, "Error #3692: All buffers need to be "
+		                            "cleared every frame before drawing.");
+	Avm2BitmapDataExt* bd = avm2_bitmapdata_ext_of(ctx, avm2_object_value(dobj));
+	if (bd == NULL || bd->disposed || bd->pixels == NULL) return avm2_undefined();
+	// A clear with no draw after it is still pending; Flash's clear is
+	// immediate, so the read must see it (stage3d_missing_vertex_stream reads
+	// the clear colour after a draw that was skipped or threw).
+	if (!in_rtt) s3d_apply_pending_clear(be);
+	if (ns == 0) ns = 1;
+	uint32_t cw = bw < bd->width ? bw : bd->width;
+	uint32_t ch = bh < bd->height ? bh : bd->height;
+	for (uint32_t y = 0; y < ch; y++)
+	{
+		for (uint32_t x = 0; x < cw; x++)
+		{
+			size_t p = (size_t) y * bw + x;
+			uint32_t acc[4] = { 0, 0, 0, 0 };
+			for (uint32_t sm = 0; sm < ns; sm++)
+			{
+				const float* c = col + (p * ns + sm) * 4;
+				for (int k = 0; k < 4; k++)
+				{
+					float v = c[k];
+					if (!(v > 0.0f)) v = 0.0f;
+					if (v > 1.0f) v = 1.0f;
+					acc[k] += (uint32_t) (v * 255.0f + 0.5f);
+				}
+			}
+			uint32_t sr = acc[0] / ns, sg = acc[1] / ns, sb = acc[2] / ns;
+			uint32_t sa = acc[3] / ns;
+			uint32_t* dp = &bd->pixels[(size_t) y * bd->width + x];
+			uint32_t out;
+			if (sa == 255)
+			{
+				out = 0xFF000000u | (sr << 16) | (sg << 8) | sb;
+			}
+			else
+			{
+				// Premultiplied src-over onto the (premultiplied) store.
+				uint32_t d = *dp, inv = 255 - sa;
+				uint32_t s4[4] = { sb, sg, sr, sa };
+				out = 0;
+				for (int k = 0; k < 4; k++)
+				{
+					uint32_t dc = (d >> (8 * k)) & 0xFF;
+					uint32_t v = (s4[k] * 255 + dc * inv + 127) / 255;
+					if (v > 255) v = 255;
+					out |= v << (8 * k);
+				}
+			}
+			if (!bd->transparency) out |= 0xFF000000u;
+			*dp = out;
+		}
+	}
+	return avm2_undefined();
+}
