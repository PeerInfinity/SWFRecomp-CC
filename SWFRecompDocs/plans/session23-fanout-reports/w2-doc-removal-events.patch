+static void throw_2094(Avm2Context* ctx)
+{
+	avm2_throw_error(ctx, ctx->builtins.error_class,
+	                 "Error #2094: Event dispatch recursion overflow.");
+}
+
+// remove_child_from_displaylist (Ruffle display_object_container.rs, upstream
+// 7bc23b837): the script-removal path shared by removeChild, removeChildAt
+// and removeChildren. A child whose removal events are still being
+// dispatched by one of these throws #2094 (avm2/displayobjectcontainer_
+// remove_reentrant); a child that no longer has a parent is skipped. The
+// child is removed from its CURRENT parent, which a listener may have
+// changed since the caller looked it up.
+static void doc_script_remove_child(Avm2Context* ctx, Avm2Object* child)
+{
+	Avm2DisplayObjectExt* cext = avm2_display_ext_of(ctx, child);
+	if (cext == NULL) return;
+	if (cext->being_removed_by_avm2) throw_2094(ctx);
+	if (cext->parent == NULL) return;
+	Avm2DisplayObjectExt* pext = avm2_display_ext_of(ctx, cext->parent);
+	if (pext == NULL) return;
+	cext->placed_by_avm2_script = 1;
+	// Listener errors are caught inside the dispatch, so nothing longjmps
+	// past the reset below.
+	cext->being_removed_by_avm2 = 1;
+	full_remove_child(ctx, pext, child);
+	cext->being_removed_by_avm2 = 0;
+}
