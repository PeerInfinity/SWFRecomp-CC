+// `uri::local` spelling for a runtime-name miss message (avmplus/Ruffle
+// qualify a single non-empty namespace, as mn_display_name does for static
+// sites). Returns the plain name when the uri is empty or the buffer is short.
+static const char* qualified_miss_name(const char* uri, uint32_t uri_len,
+                                       const char* name, uint32_t name_len,
+                                       char* buf, size_t size, uint32_t* out_len)
+{
+	if (uri != NULL && uri_len > 0)
+	{
+		int n = snprintf(buf, size, "%.*s::%.*s", (int) uri_len, uri,
+		                 (int) name_len, name);
+		if (n > 0 && (size_t) n < size)
+		{
+			*out_len = (uint32_t) n;
+			return buf;
+		}
+	}
+	*out_len = name_len;
+	return name;
+}
