+// The class half of a frame name (Ruffle function.rs display_function):
+// "only classes in public namespaces are printed with their namespace;
+// internal and private classes are printed with just their local name".
+// Ruffle's is_namespace() is true for the public kinds only (Namespace 0x08 /
+// PackageNamespace 0x16); a package-internal class prints "Hidden()", not
+// "pkg::Hidden()", and a file-private one "Priv()", not "Test.as$1::Priv()"
+// (avm2/error_stack_trace_class_names, Flash's output.txt). Builtins are
+// registered 0x16, so they keep their "flash.display::Sprite" spelling.
+static void frame_class_name(const Avm2Class* cls, char* buf, int size)
+{
+	uint8_t k = cls->name.ns_kind;
+	if (k == 0x08 || k == 0x16)
+	{
+		avm2_class_qname_colons_buf(cls, buf, size);
+		return;
+	}
+	snprintf(buf, size, "%.*s", (int) cls->name.name_len, cls->name.name);
+}
