+		float c[4] = { (float) (v & 0xFF) / 255.0f, (float) ((v >> 8) & 0xFF) / 255.0f,
+		               (float) ((v >> 16) & 0xFF) / 255.0f, (float) ((v >> 24) & 0xFF) / 255.0f };
+		for (uint32_t k = 0; k < sc; k++) memcpy(col + (p * sc + k) * 4, c, sizeof c);
