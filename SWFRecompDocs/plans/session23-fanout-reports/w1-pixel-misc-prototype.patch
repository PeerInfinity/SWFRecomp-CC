+// PROTOTYPE (acid-color-0): the composed ancestor colour transform for the
+// orphan-EditText walk, diag mult + add (0..1). Identity = {1,1,1,0,0,0}.
+static float g_otf_cx_mult[3] = { 1.0f, 1.0f, 1.0f };
+static float g_otf_cx_add[3]  = { 0.0f, 0.0f, 0.0f };
+
+static int otf_entry_cx(SWFAppContext* app_context, const DisplayObject* obj,
+	float mult[3], float add[3])
+{
+	if (obj->cx_overridden) {
+		mult[0] = (float)(obj->cx_ra / 100.0); mult[1] = (float)(obj->cx_ga / 100.0);
+		mult[2] = (float)(obj->cx_ba / 100.0);
+		add[0] = (float)(obj->cx_rb / 255.0); add[1] = (float)(obj->cx_gb / 255.0);
+		add[2] = (float)(obj->cx_bb / 255.0);
+		return 1;
+	}
+	u32 baked = (app_context->cxform_data_size > 0)
+		? (u32)(app_context->cxform_data_size / (20 * sizeof(float))) : 0;
+	if (obj->cxform_id == 0 || obj->cxform_id >= baked) return 0;
+	const float* c = (const float*)app_context->cxform_data + obj->cxform_id * 20;
+	mult[0] = c[0]; mult[1] = c[5]; mult[2] = c[10];
+	add[0] = c[16]; add[1] = c[17]; add[2] = c[18];
+	return 1;
+}
+
+static u32 otf_cx_rgb(u32 rgb)
+{
+	u32 out = 0;
+	for (int i = 0; i < 3; i++) {
+		float c = (float)((rgb >> (16 - 8 * i)) & 0xFF) / 255.0f;
+		float v = c * g_otf_cx_mult[i] + g_otf_cx_add[i];
+		if (v < 0.0f) v = 0.0f;
+		if (v > 1.0f) v = 1.0f;
+		out |= (u32)(v * 255.0f + 0.5f) << (16 - 8 * i);
+	}
+	return out;
+}
+
+// PROTOTYPE: compose the colour transforms of a TextField MovieClip's display
+// entry and every ancestor's, outermost first, into g_otf_cx_*.
