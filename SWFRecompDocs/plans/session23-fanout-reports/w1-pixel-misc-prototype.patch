+	for (MovieClip* m = mc; m != NULL && n < 64; m = m->parent) chain[n++] = m;
+	for (int i = 0; i < 3; i++) { g_otf_cx_mult[i] = 1.0f; g_otf_cx_add[i] = 0.0f; }
+	if (app_context == NULL) return;
+	for (int k = n - 1; k >= 0; k--) {
+		DisplayObject* e = (DisplayObject*)chain[k]->display_obj;
+		if (e == NULL) e = resolveMCDisplayEntry(chain[k]);
+		if (e == NULL) continue;
+		float m[3], a[3];
+		if (!otf_entry_cx(app_context, e, m, a)) continue;
+		for (int i = 0; i < 3; i++) {
+			g_otf_cx_add[i] = g_otf_cx_mult[i] * a[i] + g_otf_cx_add[i];
+			g_otf_cx_mult[i] = g_otf_cx_mult[i] * m[i];
+		}
+	}
+}
