+#if defined(NO_GRAPHICS) || defined(OFFSCREEN_RENDER)
+// [w1-trace-tail s23 prototype] Run an attachMovie'd clip's natural timeline
+// (frame tags + DoActions + nested children), children FIRST: Ruffle's AVM1
+// clip_exec_list is newest-instantiated-first, and a subtree built at attach
+// time instantiates parent before child, so the deepest child runs first.
+// Each object is advanced alone via a 1-entry scratch display list with
+// nested recursion deferred (we do the recursion ourselves, post-order).
+static void w1_attached_post_order(SWFAppContext* app_context, DisplayObject* obj, int depth_lvl, MovieClip* given_mc)
+{
+	if (obj == NULL || obj->char_id == 0) return;
+	Character* ch = &dictionary[obj->char_id];
+	if (ch->type != CHAR_TYPE_SPRITE) return;
+	if (depth_lvl > 32) return;
+	extern MovieClip* actionFindMovieClipByName(const char* instance_name);
+	MovieClip* self_mc = given_mc ? given_mc : (obj->instance_name ? actionFindMovieClipByName(obj->instance_name) : NULL);
+
+	// 1. children first (descending depth ~ newest first for a frame-1 build)
+	if (obj->sprite_display_list != NULL) {
+		MovieClip* saved_ctx = g_current_context;
+		if (self_mc) actionSetCurrentContext(self_mc);
+		for (size_t d = obj->sprite_max_depth; d >= 1; d--) {
+			DisplayObject* c = &obj->sprite_display_list[d];
+			if (c->char_id != 0) w1_attached_post_order(app_context, c, depth_lvl + 1, NULL);
+			if (d == 1) break;
+		}
+		actionSetCurrentContext(saved_ctx);
+	}
+
+	// 2. self, no nested recursion
+	size_t fc = ch->sprite_frame_count;
+	if (fc <= 1 || !obj->sprite_is_playing) return;
+	DisplayObject* tmp = (DisplayObject*)calloc(2, sizeof(DisplayObject));
+	if (tmp == NULL) return;
+	tmp[1] = *obj;
+	if (depth_lvl == 0) tmp[1].sprite_current_frame = (obj->sprite_current_frame + 1) % fc; // attached: shown -> next
+	DisplayObject* saved_dl = display_list;
+	size_t saved_max = max_depth, saved_cap = display_list_capacity;
+	display_list = tmp; max_depth = 1; display_list_capacity = 2;
+	int saved_defer = g_advance_defer_nested;
+	g_advance_defer_nested = 1;
+	MovieClip* saved_c2 = g_current_context;
+	MovieClip* saved_b2 = actionGetBaseClip();
+	if (self_mc && obj->instance_name == NULL) { actionSetCurrentContext(self_mc); actionSetBaseClip(self_mc); }
+	advance_sprite_frames(app_context);
+	actionSetCurrentContext(saved_c2);
+	actionSetBaseClip(saved_b2);
+	g_advance_defer_nested = saved_defer;
+	display_list = saved_dl; max_depth = saved_max; display_list_capacity = saved_cap;
+	actionQueueRebaseSpriteObjPayloads(tmp, 2 * sizeof(DisplayObject), (char*)obj - sizeof(DisplayObject));
+	size_t next = tmp[1].sprite_current_frame;
+	*obj = tmp[1];
+	free(tmp);
+	if (self_mc) self_mc->display_obj = (void*)obj;
+	if (depth_lvl == 0) {
+		obj->sprite_current_frame = (next + fc - 1) % fc; // next -> shown
+		if (self_mc) self_mc->currentframe = (int)obj->sprite_current_frame + 1;
+	}
+}
