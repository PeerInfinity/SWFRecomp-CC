+// ---------------------------------------------------------------------------
+// Video display objects: lazy width/height on the prototype (s23 w2-video-props)
+// ---------------------------------------------------------------------------
+//
+// Flash does not define `width`/`height` on Video.prototype up front. Creating
+// a Video DISPLAY OBJECT (a timeline-placed DefineVideoStream; `new Video()`
+// does not count) defines them on the prototype that Video currently has, at
+// most once per prototype object for the whole player: existing values are
+// overwritten, and once deleted they are never defined on that object again.
+// The new Video's __proto__ is that prototype (captured at creation, so a later
+// `Video.prototype = x` does not move it). The accessors are read-only and
+// return the size of the last decoded frame of the attached stream, 0 before
+// any frame is decoded; a non-Video receiver reads undefined.
+// Ruffle d900f711d / c8a03ccd3 (avm1/globals/video.rs); tests
+// avm1/video_width_height, avm1/video_prototype_lazy, gnash NetStream-SquareTest.
+
+#define MAX_VIDEO_LAZY_PROTOS 64
+static ASObject* g_video_lazy_protos[MAX_VIDEO_LAZY_PROTOS];
+static int g_video_lazy_proto_count = 0;
+
+#define MAX_VIDEO_INST_STATES 32
+typedef struct {
+	MovieClip* mc;
+	ASObject* ns;      // attached NetStream (attachVideo), NULL if none
+	int w, h;          // last decoded size (kept after close / detach)
+} VideoInstState;
+static VideoInstState g_video_inst_states[MAX_VIDEO_INST_STATES];
+
+static ASFunction g_video_width_getter, g_video_height_getter, g_video_size_setter;
+
+static VideoInstState* videoInstState(MovieClip* mc, int create)
+{
+	if (mc == NULL) return NULL;
+	VideoInstState* free_slot = NULL;
+	for (int i = 0; i < MAX_VIDEO_INST_STATES; i++)
+	{
+		if (g_video_inst_states[i].mc == mc) return &g_video_inst_states[i];
+		if (free_slot == NULL && g_video_inst_states[i].mc == NULL) free_slot = &g_video_inst_states[i];
+	}
+	if (!create) return NULL;
+	if (free_slot == NULL) free_slot = &g_video_inst_states[0]; // evict oldest-index
+	memset(free_slot, 0, sizeof(*free_slot));
+	free_slot->mc = mc;
+	return free_slot;
+}
+
+// The Video clip a native Video method / accessor was invoked on. Depending on
+// the dispatcher the ABI `this` is the clip, its dynamic_props bag, or NULL with
+// the clip on g_this_stack.
+static MovieClip* videoReceiverMc(void* this_obj)
+{
+	extern MovieClip* child_mc_cache[];
+	extern int child_mc_count;
+	MovieClip* mc = NULL;
+	if (this_obj != NULL)
+	{
+		for (int i = 0; i < child_mc_count; i++)
+			if (child_mc_cache[i] == (MovieClip*) this_obj) { mc = child_mc_cache[i]; break; }
+		if (mc == NULL) mc = ng_mc_for_dynamic_props(this_obj);
+		if (mc == NULL) return NULL; // a plain object receiver
+	}
+	else
+	{
+		// MOVIECLIP receiver with a NULL ABI this (INV_MC_THIS_NULL_PTR): the
+		// accessor path also pushes it on g_this_stack; the method path only
+		// publishes it as g_event_this_mc (INV_EVENT_THIS_MC).
+		extern MovieClip* g_event_this_mc;
+		if (g_this_depth > 0 && g_this_stack[g_this_depth - 1].type == ACTION_STACK_VALUE_MOVIECLIP)
+			mc = (MovieClip*)(uintptr_t) g_this_stack[g_this_depth - 1].data.numeric_value;
+		if (!mcIsTimelineVideo(mc)) mc = g_event_this_mc;
+	}
+	return mcIsTimelineVideo(mc) ? mc : NULL;
+}
+
+// Decoded size without a decoder: the no-graphics build links no libavcodec,
+// so a Sorenson H.263 stream never decodes there and Video.width/height would
+// differ by build mode. The Sorenson picture header carries the exact size the
+// decoder produces (FLV spec "H.263VIDEOPACKET": PictureStartCode UB[17],
+// Version UB[5], TemporalReference UB[8], PictureSize UB[3], then an 8- or
+// 16-bit custom width/height or a fixed size). Used only when play() decoded
+// no frame; a real decode always wins.
+#define MAX_VIDEO_PROBES 8
+static struct { ASObject* ns; int w, h; } g_video_probes[MAX_VIDEO_PROBES];
+
+static u32 videoBits(const unsigned char* d, int len, int* bitpos, int n)
+{
+	u32 v = 0;
+	for (int i = 0; i < n; i++, (*bitpos)++)
+	{
+		int byte = *bitpos >> 3;
+		int bit = (byte < len) ? (d[byte] >> (7 - (*bitpos & 7))) & 1 : 0;
+		v = (v << 1) | (u32) bit;
+	}
+	return v;
+}
+
+static int videoSorensonSize(const unsigned char* d, int len, int* w, int* h)
+{
+	int bp = 0;
+	if (len < 6 || videoBits(d, len, &bp, 17) != 1) return 0;
+	(void) videoBits(d, len, &bp, 5 + 8);
+	switch (videoBits(d, len, &bp, 3))
+	{
+		case 0: *w = (int) videoBits(d, len, &bp, 8); *h = (int) videoBits(d, len, &bp, 8); break;
+		case 1: *w = (int) videoBits(d, len, &bp, 16); *h = (int) videoBits(d, len, &bp, 16); break;
+		case 2: *w = 352; *h = 288; break;
+		case 3: *w = 176; *h = 144; break;
+		case 4: *w = 128; *h = 96; break;
+		case 5: *w = 320; *h = 240; break;
+		case 6: *w = 160; *h = 120; break;
+		default: return 0;
+	}
+	return *w > 0 && *h > 0;
+}
+
+static void videoProbeStreamSize(ASObject* ns, const unsigned char* data, int len)
+{
+	if (ns == NULL || data == NULL || len < 13 || data[0] != 'F' || data[1] != 'L' || data[2] != 'V') return;
+	int w = 0, h = 0, offset = 9 + 4;
+	while (offset + 11 < len)
+	{
+		int tag_type = data[offset];
+		int tag_size = (data[offset+1] << 16) | (data[offset+2] << 8) | data[offset+3];
+		int start = offset + 11;
+		if (start + tag_size > len) break;
+		if (tag_type == 9 && tag_size > 1)
+		{
+			int codec_id = data[start] & 0xF, frame_type = (data[start] >> 4) & 0xF;
+			if (codec_id == 2 && frame_type == 1 &&
+			    videoSorensonSize(data + start + 1, tag_size - 1, &w, &h))
+				break;
+			if (frame_type == 1) return; // first keyframe is another codec: no probe
+		}
+		offset = start + tag_size + 4;
+	}
+	if (w <= 0 || h <= 0) return;
+	int slot = 0;
+	for (int i = 0; i < MAX_VIDEO_PROBES; i++)
+	{
+		if (g_video_probes[i].ns == ns) { slot = i; break; }
+		if (g_video_probes[i].ns == NULL) { slot = i; break; }
+	}
+	g_video_probes[slot].ns = ns;
+	g_video_probes[slot].w = w;
+	g_video_probes[slot].h = h;
+}
+
+// Refresh the cached decoded size from the attached stream. A frame decoded by
+// play() only becomes visible once the stream has started (next tick), as in
+// Flash, where nothing is decoded before the first frame advance.
+static void videoRefreshSize(VideoInstState* st)
+{
+	if (st == NULL || st->ns == NULL) return;
+	for (int i = 0; i < MAX_ACTIVE_NETSTREAMS; i++)
+		if (g_active_netstreams[i].active && g_active_netstreams[i].ns_obj == st->ns &&
+		    g_active_netstreams[i].pending_start)
+			return;
+	for (int i = 0; i < MAX_VIDEO_FRAMES; i++)
+	{
+		if (g_video_frames[i].active && g_video_frames[i].ns_obj == st->ns &&
+		    g_video_frames[i].width > 0 && g_video_frames[i].height > 0)
+		{
+			st->w = g_video_frames[i].width;
+			st->h = g_video_frames[i].height;
+			return;
+		}
+	}
+	for (int i = 0; i < MAX_VIDEO_PROBES; i++)
+	{
+		if (g_video_probes[i].ns == st->ns)
+		{
+			st->w = g_video_probes[i].w;
+			st->h = g_video_probes[i].h;
+			return;
+		}
+	}
+}
+
+static ActionVar videoSizeGet(void* this_obj, int want_height)
+{
+	MovieClip* mc = videoReceiverMc(this_obj);
+	if (mc == NULL) return as_undef();
+	VideoInstState* st = videoInstState(mc, 0);
+	videoRefreshSize(st);
+	double v = (st == NULL) ? 0.0 : (double)(want_height ? st->h : st->w);
+	ActionVar r = as_undef();
+	r.type = ACTION_STACK_VALUE_F64;
+	VAL(double, &r.data.numeric_value) = v;
+	return r;
+}
+
+static ActionVar videoWidthGetter(SWFAppContext* app_context, ActionVar* args, u32 arg_count, ActionVar* registers, void* this_obj)
+{
+	(void)app_context; (void)args; (void)arg_count; (void)registers;
+	return videoSizeGet(this_obj, 0);
+}
+
+static ActionVar videoHeightGetter(SWFAppContext* app_context, ActionVar* args, u32 arg_count, ActionVar* registers, void* this_obj)
+{
+	(void)app_context; (void)args; (void)arg_count; (void)registers;
+	return videoSizeGet(this_obj, 1);
+}
+
+// Video.prototype.attachVideo(source): remember the stream so width/height can
+// report its decoded size. As in Ruffle (video.rs attach_video), a source that
+// is not an object leaves the current attachment alone (attachVideo(null) does
+// not detach), and the last decoded size is always kept.
+static ActionVar videoAttachVideo(SWFAppContext* app_context, ActionVar* args, u32 arg_count, ActionVar* registers, void* this_obj)
+{
+	(void)app_context; (void)registers;
+	MovieClip* mc = videoReceiverMc(this_obj);
+	if (mc != NULL && arg_count > 0 && args[0].type == ACTION_STACK_VALUE_OBJECT)
+	{
+		VideoInstState* st = videoInstState(mc, 1);
+		videoRefreshSize(st);
+		st->ns = (ASObject*)(uintptr_t) args[0].data.numeric_value;
+	}
+	return as_undef();
+}
+
+static void videoDefineLazyProps(SWFAppContext* app_context, ASObject* proto)
+{
+	if (proto == NULL) return;
+	for (int i = 0; i < g_video_lazy_proto_count; i++)
+		if (g_video_lazy_protos[i] == proto) return;
+	if (g_video_lazy_proto_count >= MAX_VIDEO_LAZY_PROTOS) return;
+	// Keep the object alive so its address can never be reused by a fresh
+	// prototype that would then be wrongly treated as already recorded.
+	retainObject(proto);
+	g_video_lazy_protos[g_video_lazy_proto_count++] = proto;
+	if (g_video_width_getter.advanced_func == NULL)
+	{
+		g_video_width_getter.function_type = 2;
+		g_video_width_getter.advanced_func = (Function2Ptr) videoWidthGetter;
+		g_video_height_getter.function_type = 2;
+		g_video_height_getter.advanced_func = (Function2Ptr) videoHeightGetter;
+		g_video_size_setter.function_type = 2;
+		g_video_size_setter.advanced_func = (Function2Ptr) geomNoopSetter;
+	}
+	setAddPropertyWithFlags(app_context, proto, "width", 5, &g_video_width_getter,
+	                        &g_video_size_setter, PROPERTY_FLAGS_DEFAULT);
+	setAddPropertyWithFlags(app_context, proto, "height", 6, &g_video_height_getter,
+	                        &g_video_size_setter, PROPERTY_FLAGS_DEFAULT);
+	// Ruffle declares both VERSION_6: hidden from SWF5 code (hasOwnProperty
+	// still sees them), the same flash_flags mask AsBroadcaster.initialize uses.
+	static const char* const names[2] = { "width", "height" };
+	for (int i = 0; i < 2; i++)
+	{
+		ASProperty* p = findPropertyRaw(proto, names[i], (u32) strlen(names[i]));
+		if (p != NULL) p->flash_flags = 0x0080;
+	}
+}
+
+// Called from ng_on_place_object2 (tag_stubs.c, both build modes) for every
+// placement callback of a video character — fresh placements and in-place
+// modifies alike. A named Video gets its wrapper eagerly; a wrapper that has
+// already captured its prototype is a live Video being moved, not a new one.
+static void ensureGlobalInit(SWFAppContext* app_context);
+void actionOnVideoPlaced(SWFAppContext* app_context, const char* instance_name, DisplayObject* dobj)
+{
+	extern MovieClip root_movieclip;
+	ensureGlobalInit(app_context); // a Video can be placed before any script ran
+	MovieClip* mc = NULL;
+	if (instance_name != NULL)
+	{
+		MovieClip* parent = g_current_context ? g_current_context : &root_movieclip;
+		mc = findOrCreateMovieClip(app_context, instance_name, parent);
+		if (mc != NULL && mc->display_obj == NULL)
+			mc->display_obj = (void*) dobj;
+		if (mc != NULL && mc->dynamic_props != NULL)
+		{
+			ActionVar* p = getProperty((ASObject*) mc->dynamic_props, "__proto__", 9);
+			if (p != NULL && p->type == ACTION_STACK_VALUE_OBJECT) return;
+		}
+	}
+	// The prototype this movie's `_global.Video` has now (SWF6 and SWF7+ have
+	// separate globals and Video classes); read through GetMember so a
+	// constructor copy's lazily-created prototype is materialized.
+	ASObject* proto = NULL;
+	{
+		ASObject* ag = getActiveGlobal();
+		ActionVar* vv = (ag != NULL) ? getProperty(ag, "Video", 5) : NULL;
+		if (vv != NULL && vv->type == ACTION_STACK_VALUE_FUNCTION)
+		{
+			ActionVar fv = *vv;
+			ActionVar pv = as_get(app_context, &fv, "prototype");
+			if (pv.type == ACTION_STACK_VALUE_OBJECT)
+				proto = (ASObject*)(uintptr_t) pv.data.numeric_value;
+		}
+	}
+	if (proto == NULL) return;
+	videoDefineLazyProps(app_context, proto);
+	if (mc != NULL && mcIsTimelineVideo(mc))
+	{
+		if (mc->dynamic_props == NULL)
+			mc->dynamic_props = (void*) allocDynamicProps(app_context, 8);
+		ActionVar pv = {0};
+		pv.type = ACTION_STACK_VALUE_OBJECT;
+		pv.data.numeric_value = (u64)(uintptr_t) proto;
+		setPropertyWithFlags(app_context, (ASObject*) mc->dynamic_props, "__proto__", 9, &pv,
+		                     PROPERTY_FLAGS_DONTENUM);
+		VideoInstState* st = videoInstState(mc, 1);
+		memset(st, 0, sizeof(*st));
+		st->mc = mc;
+	}
+}
