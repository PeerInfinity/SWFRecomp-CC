+// TextField.styleSheet CSS is applied at parse time so the TFRunTable (and
+// therefore getTextFormat) sees class/tag selector formats. Set by the
+// html=true htmlText setter for the duration of one tf_parse_html call.
+static ASObject* g_tf_parse_css_styles = NULL;
+static void tf_css_apply(TFRun* f, const char* sel, u32 sel_len) {
+	ASObject* so = g_tf_parse_css_styles;
+	if (so == NULL || sel_len == 0) return;
+	for (u32 pi = 0; pi < so->num_used; pi++) {
+		ASProperty* p = &so->properties[pi];
+		if (p->name_length != sel_len || strncasecmp(p->name, sel, sel_len) != 0) continue;
+		if (p->value.type != ACTION_STACK_VALUE_OBJECT || p->value.data.numeric_value == 0) return;
+		ASObject* fmt = (ASObject*)p->value.data.numeric_value;
+		ActionVar* v = getProperty(fmt, "color", 5);
+		if (v != NULL && v->type == ACTION_STACK_VALUE_F64) {
+			double d; memcpy(&d, &v->data.numeric_value, sizeof(double));
+			f->color = (u32)d & 0x00FFFFFF;
+		}
+		v = getProperty(fmt, "size", 4);
+		if (v != NULL && v->type == ACTION_STACK_VALUE_F64) {
+			double d; memcpy(&d, &v->data.numeric_value, sizeof(double));
+			if (d > 0) f->font_height = (s16)(d * 20.0);
+		}
+		v = getProperty(fmt, "bold", 4);
+		if (v != NULL && v->type == ACTION_STACK_VALUE_BOOLEAN) f->bold = v->data.numeric_value ? 1 : 0;
+		v = getProperty(fmt, "italic", 6);
+		if (v != NULL && v->type == ACTION_STACK_VALUE_BOOLEAN) f->italic = v->data.numeric_value ? 1 : 0;
+		v = getProperty(fmt, "underline", 9);
+		if (v != NULL && v->type == ACTION_STACK_VALUE_BOOLEAN) f->underline = v->data.numeric_value ? 1 : 0;
+		return;
+	}
+}
