+// Ruffle core/src/html/text_format.rs: <p>/<a>/<li>: tag selector then ".class";
+// <span>: ".class" only. The class value is taken verbatim (last duplicate wins).
+static void tf_css_apply_tag(TFRun* f, const char* tname, u32 tname_len, const char* tag, int with_tag) {
+	if (g_tf_parse_css_styles == NULL) return;
+	if (with_tag) tf_css_apply(f, tag, (u32)strlen(tag));
+	char cv[120];
+	if (tf_get_attr(tname, tname_len, "class", cv + 1, sizeof(cv) - 1) && cv[1] != '\0') {
+		cv[0] = '.';
+		tf_css_apply(f, cv, (u32)strlen(cv));
+	}
+}
