+// The 8 TextField.prototype methods are name-only stubs (no simple/advanced
+// func): a direct `field.getTextFormat(i)` dispatches by name in
+// actionCallMethod. `field.getTextFormat.apply(field, args)` /
+// `.call(field, ...)` reach Function.apply/call with only the stub, so those
+// arms re-dispatch through actionCallMethod on the MovieClip receiver
+// (Ruffle: the native method runs with the given `this`).
+static int tf_is_builtin_method(const ASFunction* f)
+{
+	return f == &g_tf_getTextFormat_func || f == &g_tf_setTextFormat_func ||
+	       f == &g_tf_getNewTextFormat_func || f == &g_tf_setNewTextFormat_func ||
+	       f == &g_tf_getDepth_func || f == &g_tf_removeTextField_func ||
+	       f == &g_tf_replaceSel_func || f == &g_tf_replaceText_func;
+}
 
