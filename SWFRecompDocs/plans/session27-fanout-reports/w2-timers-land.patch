+    nb = max(abs(tx).bit_length(), abs(ty).bit_length()) + 1
+    bits = '0' + '0' + '{:05b}'.format(nb)
+    for v in (tx, ty):
+        bits += format(v & ((1 << nb) - 1), '0{}b'.format(nb))
+    bits += '0' * ((8 - len(bits) % 8) % 8)
+    return int(bits, 2).to_bytes(len(bits) // 8, 'big')
