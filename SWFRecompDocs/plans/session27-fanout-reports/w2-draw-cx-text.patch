diff --git a/SWFModernRuntime/src/avm2/avm2_cpu_raster.c b/SWFModernRuntime/src/avm2/avm2_cpu_raster.c
index 110d298bd..afbbb564a 100644
--- a/SWFModernRuntime/src/avm2/avm2_cpu_raster.c
+++ b/SWFModernRuntime/src/avm2/avm2_cpu_raster.c
@@ -959,3 +959,98 @@ void avm2_cpu_raster_morph(uint32_t* buf, int W, int H, int transparent,
