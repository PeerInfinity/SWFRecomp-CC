+		bd_apply_convolution(&kctx, &dst, &src, sx, sy, sw, sh, dx, dy, f);
+	}
+	else if (f->kind == AVM2_FILTER_GRADIENT_GLOW || f->kind == AVM2_FILTER_GRADIENT_BEVEL
+	         || f->kind == AVM2_FILTER_CONVOLUTION)
+	{
