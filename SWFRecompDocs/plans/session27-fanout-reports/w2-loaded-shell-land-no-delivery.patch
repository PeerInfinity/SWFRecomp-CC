+            code += STOP
+        frames.append(do_action(code))
+    swf_file(HERE / 'test.swf', frames, version=8)
+
+def children():
+    swf_file(HERE / 'child.swf', [do_action(app('Lh', 'c1,')), do_action(app('Lh', 'c2,')),
