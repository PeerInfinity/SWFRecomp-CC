+    swf_file(HERE / 'child2.swf', [do_action(app('Lg', 'd1,') + NEXT_FRAME), do_action(app('Lg', 'd2,')),
+                                   do_action(app('Lg', 'd3,'))], version=8)
+    swf_file(HERE / 'child3.swf', [do_action(app('Lk', 'e1,') + goto_frame(0) + STOP)], version=8)
+
+if __name__ == '__main__':
+    children(); parent()
