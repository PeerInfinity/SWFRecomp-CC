diff --git a/SWFModernRuntime/src/actionmodern/action.c b/SWFModernRuntime/src/actionmodern/action.c
index 2266466c..2434326a 100644
--- a/SWFModernRuntime/src/actionmodern/action.c
+++ b/SWFModernRuntime/src/actionmodern/action.c
@@ -17831,13 +17831,22 @@ static void tfCallGlobalCtorOnField(SWFAppContext* app_context, MovieClip* field
 	// Default flag superset, plus a real zero-length `arguments` for a type-1
 	// (SWF6 DefineFunction) body, which has no prologue of its own
 	// (TextField.as:1239 `args == 0`).
-	InvokeOpts opts = { .flags = INV_DEPTH_GUARD | INV_THIS_STACK | INV_SUPER_CTX |
+	// Super context: the field's property bag at constructor depth 1, with the
+	// field as companion MC, exactly as actionInvokeRegisteredClassConstructor
+	// does. NOT INV_SUPER_CTX: that pushes the raw MovieClip* at depth 0, and a
+	// `super()` in the replaced constructor (globals_monkeypatch's
+	// monkeyPatchClass `zuper()`) then walks the MovieClip as an ASObject
+	// (walkProtoChain -> findPropertySlot on MovieClip memory) = SIGSEGV
+	// (s27 interim #3; exposed by 85cca4df6, latent before).
+	InvokeOpts opts = { .flags = INV_DEPTH_GUARD | INV_THIS_STACK |
 	                             INV_CAPTURED_SCOPE | INV_LOCAL_SCOPE | INV_BIND_THIS |
 	                             INV_BASE_CLIP | INV_VERSION_SWITCH | INV_EVENT_THIS_MC |
 	                             INV_EXEC_FUNC | INV_LOCAL_SCOPE_MC | INV_CTOR_CTX |
 	                             INV_MC_THIS_NULL_PTR,  // MC receiver: preload_this reads g_event_this_mc
 	                    .act_flags = INV_ACT_ARGUMENTS };
+	pushSuperContextWithMC(field->dynamic_props, 1, (void*) field);
 	(void) invokeFunctionValue(app_context, f, &this_var, NULL, 0, &opts);
+	popSuperContext();
 }
 
 // ============================================================
diff --git a/SWFModernRuntime/src/libswf/tag.c b/SWFModernRuntime/src/libswf/tag.c
index 6388e775..12483130 100644
--- a/SWFModernRuntime/src/libswf/tag.c
+++ b/SWFModernRuntime/src/libswf/tag.c
@@ -2575,9 +2575,20 @@ void ng_apply_pending_sprite_self_gotos(SWFAppContext* app_context)
 
 		int saved_sg_cm = catch_up_mode;
 		catch_up_mode = 1;
+		// An attached root's entry is unnamed, so exec_sprite_frame cannot bind
+		// its clip as the context, and this pass runs with _root as context:
+		// tagPlaceObject2's Phase-7b pre-create then parented every NAMED child
+		// of the replayed frames to _root (orphans the OFFSCREEN attached pass
+		// draws at identity, leaving the real children's compose with an
+		// identity local matrix: regression/avm1_attached_clip_selfgoto_child_parent
+		// image). Bind the clip as ng_attached_run_tree does for its advance.
+		MovieClip* sg_saved_ctx = g_current_context;
+		MovieClip* sg_saved_base = actionGetBaseClip();
+		if (att_mc) { actionSetCurrentContext(att_mc); actionSetBaseClip(att_mc); }
 		for (size_t f = 0; f <= target; f++)
 			if (f < ch->sprite_frame_count && ch->sprite_frame_funcs[f] != NULL)
 				CALL_FRAME(app_context, obj, ch->sprite_frame_funcs[f]);
+		if (att_mc) { actionSetCurrentContext(sg_saved_ctx); actionSetBaseClip(sg_saved_base); }
 		catch_up_mode = saved_sg_cm;
 
 #if defined(NO_GRAPHICS) || defined(OFFSCREEN_RENDER)
