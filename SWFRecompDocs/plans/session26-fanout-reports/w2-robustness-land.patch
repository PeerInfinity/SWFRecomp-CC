+
+    DefineFont2 "F" (one square glyph 'A'), EditText 100x100 px, multiline,
+    centred, embedded outlines, white, text = 300 x "A" joined by "\\r".
+    trace(maxscroll); scroll = maxscroll; trace(scroll, bottomScroll)
