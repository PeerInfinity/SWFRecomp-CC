+    b += bytes([0x80 | 0x20 | 0x08 | 0x04 | 0x01, 0x20 | 0x10 | 0x01])  # text, multiline, ro, color, font | layout, noselect, outlines
+    b += struct.pack("<HH", fid, 200)                    # 10 px
+    b += bytes([255, 255, 255, 255])                     # white
