+    w = BW(); w.u(nb, 5)
+    for v in (x0, x1, y0, y1): w.sb(v, nb)
+    return w.bytes()
+
+def matrix_t(tx, ty):            # translate-only MATRIX (twips)
+    w = BW(); w.u(0, 1); w.u(0, 1); w.u(16, 5); w.sb(tx, 16); w.sb(ty, 16)
+    return w.bytes()
