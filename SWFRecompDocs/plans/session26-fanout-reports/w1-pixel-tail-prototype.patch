+			double sa = o[3], da = dest->transparent ? ((d >> 24) & 0xFF) / 255.0 : 1.0;
+			double oa = sa + da * (1.0 - sa);
+			double rc[3];
+			for (int k = 0; k < 3; k++) {
+				double dc = ((d >> (16 - 8 * k)) & 0xFF) / 255.0;
+				rc[k] = oa > 0 ? (o[k] * sa + dc * da * (1.0 - sa)) / oa : 0;
+			}
