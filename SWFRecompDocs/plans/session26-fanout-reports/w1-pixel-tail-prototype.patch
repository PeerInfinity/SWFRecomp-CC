+		double pc = ma * pm[4] + mc_ * pm[5], pd = mb * pm[4] + md * pm[5];
+		double ptx = ma * pm[12] + mc_ * pm[13] + 20.0 * mtx;
+		double pty = mb * pm[12] + md * pm[13] + 20.0 * mty;
+		memset(g_bd1_scratch, 0, n * sizeof(uint32_t));
