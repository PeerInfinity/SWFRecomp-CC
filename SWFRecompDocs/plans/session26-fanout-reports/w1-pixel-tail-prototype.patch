+			dest->pixels[i] = (A << 24) | ((uint32_t)(rc[0] * 255.0 + 0.5) << 16)
+			                | ((uint32_t)(rc[1] * 255.0 + 0.5) << 8) | (uint32_t)(rc[2] * 255.0 + 0.5);
+		}
+	}
+}
