+// s26 w1-avm1-dispatch-scope PROTOTYPE (item 5): the format edit for typed
+// input (keyboard / IME). Ruffle html/text_format.rs FormatSpans::replace_text:
+// the inserted text takes the format of the span AFTER the replaced range, or
+// the new-text format when appending. Edits the run table in place instead of
+// dropping it (which lost every <font> run of an HTML field on a keystroke).
+// Returns 1 when it handled the field (caller must not invalidate the table).
+static int tf_ps_on_typed(SWFAppContext* app_context, MovieClip* mc, u32 from, u32 to,
+                          const uint16_t* ins_u16, u32 ins_len)
+{
+	TFRunTable* table = tf_find_table(mc);
+	if (table == NULL || table->run_count == 0) return 0;
+	u32 old_len = tf_ps_text_len(mc);
+	if (from > old_len) from = old_len;
+	if (to > old_len) to = old_len;
+	int ml = tf_ps_is_multiline(mc);
+	TFPlainSpans* ps = tf_ps_get(app_context, mc);
+	if (ps == NULL) return 0;
+	TFPSFmt ins_fmt = ps->newfmt;
+	if (to < old_len) {
+		TFRun* r = tf_table_run_at_plain(table, to, ml);
+		if (r != NULL) tf_ps_from_run(&ins_fmt, r);
+	}
+	char buf[16384];
+	size_t n = (ins_u16 != NULL && ins_len > 0) ? u16_to_utf8(ins_u16, ins_len, buf, sizeof(buf)) : 0;
+	if (n >= sizeof(buf)) n = sizeof(buf) - 1;
+	tf_table_replace(table, from, to, buf, (u32)n, ml, &ins_fmt);
+	return 1;
+}
