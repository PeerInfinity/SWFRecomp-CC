--- /dev/null
+++ b/ruffle-tests/tests/swfs/regression/avm1_edittext_placed_cxform/test.toml
@@ -0,0 +1,18 @@
+num_ticks = 1
+
+# Golden = Ruffle exporter 0ddd12b6a (HIGH quality). Every box/text/border
+# pixel is graded at tolerance 2. The 19 allowed outlier CHANNELS are 9
+# EditText border corner pixels (TL/TR/BL of each of the 3 boxes) that the
+# oracle machine drew 3/4-covered: that is Ruffle's `emulate_line_rect`
+# line-as-rect path (render/src/lines.rs; wgpu uses it on Dx12 only), whereas
+# the corpus goldens (LineStrip backends) ink those three corners solid and
+# only the bottom-right one partially — the rule tag.c::textfield_render_cb
+# follows (s20, edittext_caret_empty & 10 more at 0 outliers). Independent of
+# the colour transform; see
+# SWFRecompDocs/plans/session26-fanout-reports/w2-edittext-border-cx-report.md.
+[image_comparisons.output]
+tolerance = 2
+max_outliers = 19
+
+[player_options]
+with_renderer = { optional = false }
