+// Flash wires a freshly created function object to `_global.Function` at
+// CREATION time: "__proto__ is _global.Function.prototype" (gnash
+// actionscript.all/Function.as:1069-1089). Our FUNCTION GetMember path already
+// synthesises a *virtual* __proto__ from the built-in per-version
+// Function.prototype singleton, which is right whenever `_global.Function` is
+// untouched — so this only materialises a real own `__proto__` slot in the one
+// case the virtual answer is wrong: the SWF replaced `_global.Function` (or its
+// `.prototype`) with something else before defining the function.
+//
+// Deliberately narrow, to keep the blast radius at zero for ordinary movies:
+//   - `_global.Function` must currently be a FUNCTION (Flash skips the wiring
+//     when it is a primitive — Function.as:1096-1113 checks exactly that via
+//     hasOwnProperty);
+//   - its `.prototype` must be an OBJECT (a non-object prototype would leave
+//     the function with no lookup chain at all; the ASnative(1,0) path stores
+//     it, but no test observes it for SWF-defined functions);
+//   - and it must NOT be one of the two built-in Function.prototype singletons,
+//     which is the normal case and needs no own slot.
+// When it fires, the existing own_props prototype walk in the FUNCTION arm of
+// GetMember delivers both `uf.__proto__` and inherited members (`uf.p`).
+static void applyGlobalFunctionProtoLink(SWFAppContext* app_context, ASFunction* fn)
+{
+	extern ASObject* global_object;
+	if (fn == NULL || global_object == NULL) return;
+	ActionVar* gfn_ptr = getProperty(global_object, "Function", 8);
+	if (gfn_ptr == NULL || gfn_ptr->type != ACTION_STACK_VALUE_FUNCTION) return;
+	ASFunction* gff = (ASFunction*)(uintptr_t)gfn_ptr->data.numeric_value;
+	if (gff == NULL || gff == fn) return;
+	ActionVar protov = funcPrototypeVar(gff);
+	if (protov.type != ACTION_STACK_VALUE_OBJECT) return;
+	ASObject* po = (ASObject*)(uintptr_t)protov.data.numeric_value;
+	if (po == NULL || po == g_function_proto_legacy || po == g_function_proto_modern)
+		return;
+	if (fn->own_props == NULL)
+	{
+		fn->own_props = allocObject(app_context, 4);
+		retainObject(fn->own_props);
+	}
+	setPropertyWithFlags(app_context, fn->own_props, "__proto__", 9, &protov,
+	                     PROPERTY_FLAGS_DONTENUM);
+}
