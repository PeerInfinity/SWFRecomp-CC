new file mode 100644
index 000000000..bcf556f1a
--- /dev/null
+++ b/exporter/src/local_navigator.rs
@@ -0,0 +1,167 @@
+//! Local-patch navigator for the exporter.
+//!
+//! Minimal `NavigatorBackend` that serves `fetch` requests from a local
+//! directory, mapping `http(s)://host/path` -> `{base}/host/path` (same
+//! scheme as ruffle's own `TestNavigatorBackend`). Used to faithfully
+//! reproduce an environment where an external SWF dependency (e.g.
+//! armorgames AGI.swf) is available, without a live network stack.
+//!
+//! Enabled by env `RUFFLE_LOCAL_FETCH_DIR`. Futures run on a `NullExecutor`
+//! that the exporter polls once per frame.
+
+use async_channel::{Receiver, Sender};
+use ruffle_core::backend::navigator::{
+    ErrorResponse, NavigationMethod, NavigatorBackend, NullSpawner, OwnedFuture, Request,
+    SuccessResponse, async_return, create_fetch_error,
+};
+use ruffle_core::indexmap::IndexMap;
+use ruffle_core::loader::Error;
+use ruffle_core::socket::{SocketAction, SocketHandle};
+use ruffle_core::swf::Encoding;
+use std::borrow::Cow;
+use std::path::PathBuf;
+use std::time::Duration;
+use url::{ParseError, Url};
+
+struct LocalResponse {
+    url: String,
+    body: Vec<u8>,
+    chunk_gotten: bool,
+    status: u16,
+}
+
+impl SuccessResponse for LocalResponse {
+    fn url(&self) -> Cow<'_, str> {
+        Cow::Borrowed(&self.url)
+    }
+    fn set_url(&mut self, url: String) {
+        self.url = url;
+    }
+    fn body(self: Box<Self>) -> OwnedFuture<Vec<u8>, Error> {
+        Box::pin(async move { Ok(self.body) })
+    }
+    fn text_encoding(&self) -> Option<&'static Encoding> {
+        None
+    }
+    fn status(&self) -> u16 {
+        self.status
+    }
+    fn redirected(&self) -> bool {
+        false
+    }
+    fn next_chunk(&mut self) -> OwnedFuture<Option<Vec<u8>>, Error> {
+        if !self.chunk_gotten {
+            self.chunk_gotten = true;
+            let body = self.body.clone();
+            Box::pin(async move { Ok(Some(body)) })
+        } else {
+            Box::pin(async move { Ok(None) })
+        }
+    }
+    fn expected_length(&self) -> Result<Option<u64>, Error> {
+        Ok(Some(self.body.len() as u64))
+    }
+}
+
+pub struct LocalFileNavigator {
+    spawner: NullSpawner,
+    base_path: PathBuf,
+}
+
+impl LocalFileNavigator {
+    pub fn new(base_path: PathBuf, spawner: NullSpawner) -> Self {
+        Self { spawner, base_path }
+    }
+}
+
+impl NavigatorBackend for LocalFileNavigator {
+    fn navigate_to_url(
+        &self,
+        url: &str,
+        _target: &str,
+        _vars_method: Option<(NavigationMethod, IndexMap<String, String>)>,
+    ) {
+        tracing::info!("LocalFileNavigator: navigate_to_url ignored: {url}");
+    }
+
+    fn fetch(&self, request: Request) -> OwnedFuture<Box<dyn SuccessResponse>, ErrorResponse> {
+        let url = match self.resolve_url(request.url()) {
+            Ok(url) => url,
+            Err(e) => return async_return(Err(create_fetch_error(request.url(), e))),
+        };
+
+        // Map http(s)://host/path -> {base}/host/path
+        let mut path = self.base_path.clone();
+        if let Some(host) = url.host_str() {
+            path.push(host);
+        }
+        if let Some(rest) = url.path().strip_prefix('/') {
+            path.push(rest);
+        }
+        let url_str = url.to_string();
+
+        Box::pin(async move {
+            match std::fs::read(&path) {
+                Ok(body) => {
+                    tracing::info!(
+                        "LocalFileNavigator: served {} ({} bytes) from {}",
+                        url_str,
+                        body.len(),
+                        path.display()
+                    );
+                    let resp: Box<dyn SuccessResponse> = Box::new(LocalResponse {
+                        url: url_str,
+                        body,
+                        chunk_gotten: false,
+                        status: 200,
+                    });
+                    Ok(resp)
+                }
+                Err(e) => {
+                    tracing::warn!(
+                        "LocalFileNavigator: MISS {} (no local file {}): {}",
+                        url_str,
+                        path.display(),
+                        e
+                    );
+                    Err(ErrorResponse {
+                        url: url_str,
+                        error: Error::FetchError(e.to_string()),
+                    })
+                }
+            }
+        })
+    }
+
+    fn resolve_url(&self, url: &str) -> Result<Url, ParseError> {
+        match Url::parse(url) {
+            Ok(parsed) => Ok(parsed),
+            Err(ParseError::RelativeUrlWithoutBase) => {
+                let base = Url::parse("http://armorgames.com/").unwrap();
+                base.join(url)
+            }
+            Err(e) => Err(e),
+        }
+    }
+
+    fn spawn_future(&mut self, future: OwnedFuture<(), Error>) {
+        self.spawner.spawn_local(future);
+    }
+
+    fn pre_process_url(&self, url: Url) -> Url {
+        url
+    }
+
+    fn connect_socket(
+        &mut self,
+        _host: String,
+        _port: u16,
+        _timeout: Duration,
+        _handle: SocketHandle,
+        _receiver: Receiver<Vec<u8>>,
+        sender: Sender<SocketAction>,
+    ) {
+        // Sockets unsupported: immediately report failure.
+        let _ = sender.try_send(SocketAction::Connect(_handle, ruffle_core::socket::ConnectionState::Failed));
+    }
+}
