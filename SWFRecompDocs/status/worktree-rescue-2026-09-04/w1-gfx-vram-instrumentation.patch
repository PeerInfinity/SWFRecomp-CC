+// --- SCRATCH INSTRUMENTATION (w1-gfx-vram, NOT FOR MERGE) ---
+#include <stdlib.h>
+static size_t g_vram_total = 0;
+static void vram_log(const char* what, const char* label, size_t bytes, void* handle)
+{
+	if (getenv("SWF_VRAM_LOG") == NULL) return;
+	g_vram_total += bytes;
+	fprintf(stderr, "[vram] %-8s %-26s %12zu B  (%7.2f MB)  cum=%7.2f MB %s\n",
+	        what, label ? label : "?", bytes, bytes/1048576.0,
+	        g_vram_total/1048576.0, handle ? "" : "<<< NULL (ALLOC FAILED)");
+	fflush(stderr);
+}
+static void vram_tex(const char* label, WGPUTextureDescriptor* d, unsigned bpp, void* h)
+{
+	size_t b = (size_t)d->size.width * d->size.height * d->size.depthOrArrayLayers
+	           * bpp * (d->sampleCount ? d->sampleCount : 1);
+	if (getenv("SWF_VRAM_LOG"))
+		fprintf(stderr, "[vram]   dims %ux%ux%u  samples=%u bpp=%u\n",
+		        d->size.width, d->size.height, d->size.depthOrArrayLayers,
+		        d->sampleCount, bpp);
+	vram_log("TEXTURE", label, b, h);
+}
+unsigned g_dynbmp_max_used = 0, g_dynbmp_max_gradused = 0, g_dynbmp_frames = 0;
+__attribute__((destructor)) static void dynbmp_report(void)
+{
+	if (getenv("SWF_DYNBMP_REPORT"))
+		fprintf(stderr, "[dynbmp] frames=%u max_dynamic_bitmaps_per_frame=%u max_dynamic_gradients_per_frame=%u\n",
+		        g_dynbmp_frames, g_dynbmp_max_used, g_dynbmp_max_gradused);
+}
+// --- END SCRATCH INSTRUMENTATION ---
