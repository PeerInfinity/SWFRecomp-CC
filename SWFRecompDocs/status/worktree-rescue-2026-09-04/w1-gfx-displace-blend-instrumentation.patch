+			for (size_t k = 0; k < num_verts; k++)
+			{
+				float px = ((const float*)v)[k * 4 + 0];
+				float py = ((const float*)v)[k * 4 + 1];
+				if (px < minx) minx = px; if (px > maxx) maxx = px;
+				if (py < miny) miny = py; if (py > maxy) maxy = py;
+			}
+			fprintf(stderr,
+				"[dump] bitmapfill st=0x%02x layer=%u invmat=%u verts=%zu "
+				"x[%.1f,%.1f] y[%.1f,%.1f] fwdmat=[%.4f %.4f %.4f %.4f tx=%.1f ty=%.1f] "
+				"sizes=[%u %u %u %u] xform=%u\n",
+				st, sid, upper, num_verts, minx, maxx, miny, maxy,
+				im ? im[0] : 0.f, im ? im[1] : 0.f, im ? im[4] : 0.f, im ? im[5] : 0.f,
+				im ? im[12] : 0.f, im ? im[13] : 0.f,
+				ctx->bitmap_sizes ? ctx->bitmap_sizes[4 * sid] : 0,
+				ctx->bitmap_sizes ? ctx->bitmap_sizes[4 * sid + 1] : 0,
+				ctx->bitmap_sizes ? ctx->bitmap_sizes[4 * sid + 2] : 0,
+				ctx->bitmap_sizes ? ctx->bitmap_sizes[4 * sid + 3] : 0,
+				transform_id);
+		}
+	}
 	// Set vertex buffer with byte offset
 	uint64_t byte_offset = offset * 4 * sizeof(u32);
 	uint64_t byte_size = num_verts * 4 * sizeof(u32);
