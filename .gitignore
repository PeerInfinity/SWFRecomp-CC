# Disabled git directories (for submodules converted to regular directories)
.git.disabled

# Pipeline driver state (used by .claude/pipeline-handoff.md)
.pipeline-state

# Visual Studio
.vs/

# Build directories
build/
build-*/
build_*/
out/

# Recompiled output
RecompiledTags/
RecompiledScripts/

# Flash files
*.swf
sup*.swf
# Allow deployed test SWFs (needed for Ruffle comparison on GitHub Pages)
!docs/examples/**/test.swf
# Allow divergence regression-gate fixture SWFs (hand-built, tracked)
!tools/divergence/gates/*.swf
# Allow demo SWFs for in-browser recompiler
!docs/recompiler/*.swf
# Allow demo SWFs for runtime-swf experiments
!demos/**/*.swf
# Allow deployed wrapper SWFs for injector demos
!docs/injector/**/*.swf
# Allow the divergence harness's prebuilt tracer SWF (compiled from Tracer.as)
!tools/divergence/tracer.swf
# Allow Archipelago Rando integration-test SWFs (hand-built MTASC test inputs)
!ruffle-tests/tests/swfs/_rando/**/*.swf

# Libraries
zlib.dll
*.lib
*.a
# Allow pre-compiled runtime files for in-browser recompiler demo
!docs/recompiler/libswfruntime.a

# Compiled files
*.spv
*.o
# Pre-compiled .o files for the in-browser recompiler demo are built by
# the deploy-pages CI workflow — no longer committed to the repository.

# Generated deploy timestamp
docs/recompiler/build_info.json

# WASM build artifacts (but keep source)
wasm/examples/*/*.wasm
wasm/examples/*/*.js
!wasm/examples/*/build.sh
!wasm/examples/*/*.c
!wasm/examples/*/*.h
!wasm/examples/*/*.html

# Emscripten
emsdk/

# WASI-SDK
wasi-sdk
wasi-sdk-*/
.emscripten_cache/
.emscripten_ports/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test executables
test_vars

# Test results
#test_results.json

# Other
__pycache__/
opam-*
test-and-doc-output.log
test-run.log
upstream/
# Upstream reference files for merge comparison
upstream-reference/

# Ruffle tests: ignore downloaded test data, keep infrastructure and results
ruffle-tests/tests/swfs/avm1/*/
!ruffle-tests/tests/swfs/avm1/_investigation/
!ruffle-tests/tests/swfs/avm1/_results/
# Allow Flash-correct expected output files (not overwritten by download_tests.sh).
# Must un-ignore the directory first, then re-ignore everything except output.flash.txt.
!ruffle-tests/tests/swfs/avm1/global_proto_decls/
ruffle-tests/tests/swfs/avm1/global_proto_decls/*
!ruffle-tests/tests/swfs/avm1/global_proto_decls/output.flash.txt
!ruffle-tests/tests/swfs/avm1/global_proto_decls_delete/
ruffle-tests/tests/swfs/avm1/global_proto_decls_delete/*
!ruffle-tests/tests/swfs/avm1/global_proto_decls_delete/output.flash.txt
!ruffle-tests/tests/swfs/avm1/global_instance_decls/
ruffle-tests/tests/swfs/avm1/global_instance_decls/*
!ruffle-tests/tests/swfs/avm1/global_instance_decls/output.flash.txt
!ruffle-tests/tests/swfs/avm1/external_interface/
# Ignore downloaded files within external_interface (only track test.toml + test_harness.c)
ruffle-tests/tests/swfs/avm1/external_interface/output.txt
ruffle-tests/tests/swfs/avm1/external_interface/*.fla
ruffle-tests/tests/swfs/avm1/external_interface/RecompiledScripts/
ruffle-tests/tests/swfs/avm1/external_interface/RecompiledTags/

# Shumway tests (downloaded test data, keep results and investigation)
ruffle-tests/tests/swfs/from_shumway/*/
!ruffle-tests/tests/swfs/from_shumway/_results/
!ruffle-tests/tests/swfs/from_shumway/_investigation/
!ruffle-tests/tests/swfs/from_shumway/avm1/
ruffle-tests/tests/swfs/from_shumway/avm1/*/
!ruffle-tests/tests/swfs/from_shumway/avm1/_results/

# Gnash tests (downloaded test data, keep results and investigation)
ruffle-tests/tests/swfs/from_gnash/*/
!ruffle-tests/tests/swfs/from_gnash/_investigation/
!ruffle-tests/tests/swfs/from_gnash/misc-swfmill.all/
ruffle-tests/tests/swfs/from_gnash/misc-swfmill.all/*/
!ruffle-tests/tests/swfs/from_gnash/misc-swfmill.all/_results/
!ruffle-tests/tests/swfs/from_gnash/actionscript.all/
ruffle-tests/tests/swfs/from_gnash/actionscript.all/*/
!ruffle-tests/tests/swfs/from_gnash/actionscript.all/_results/
!ruffle-tests/tests/swfs/from_gnash/misc-swfc.all/
ruffle-tests/tests/swfs/from_gnash/misc-swfc.all/*/
!ruffle-tests/tests/swfs/from_gnash/misc-swfc.all/_results/
!ruffle-tests/tests/swfs/from_gnash/misc-ming.all/
ruffle-tests/tests/swfs/from_gnash/misc-ming.all/*/
!ruffle-tests/tests/swfs/from_gnash/misc-ming.all/_results/

# Transient result files (not committed)
ruffle-tests/tests/swfs/**/_results/results_current.json
ruffle-tests/tests/swfs/**/_results/results_previous.json
.claude/scheduled_tasks.lock

# run_image_tests.py outputs (gathered actual/expected/difference PNGs,
# plus the side-effect _results/ dir verify_output.py creates when run
# with --tests-dir=tests/swfs). Per-suite _image-test-output/ dirs are
# already covered by the per-suite test-data ignore patterns above.
ruffle-tests/tests/swfs/_image-test-output/
ruffle-tests/tests/swfs/_results/
ruffle-tests/image_results.json
ruffle-image-results.md
ruffle-image-results.html

# Local-only SWF batch artifacts (build_swf_batch.sh / clean_swf_batch.sh)
docs/examples/local_batch/
docs2/examples/local_batch/
docs2/examples/glaiel/
docs2/examples/flasharchive/
docs2/examples/graphics/
docs2/examples/wasm_probes/

# Per-probe generated artifacts (probe sources live at wasm_probes/<slug>/test.xml
# and wasm_probes/<slug>/config.toml; everything else under each probe dir is
# regenerated by SWFRecomp/scripts/build_wasm_probes.sh).
SWFRecomp/tests/wasm_probes/*/test.swf
SWFRecomp/tests/wasm_probes/*/RecompiledScripts/
SWFRecomp/tests/wasm_probes/*/RecompiledTags/
SWFRecomp/tests/wasm_probes/*/build/
docs/local_catalog.json
docs2/local_catalog.json
docs2/glaiel_catalog.json
docs2/flasharchive_catalog.json
SWFRecomp/tests/local_batch/
SWFRecomp/tests/glaiel/
SWFRecomp/tests/flasharchive/
local_swf_batch/*.swf
local_swf_batch/*.SWF

# AI agent handoff scratch directory (cross-instance messages, runtime probes)
.ai_handoff/

# Per-session prompt scratch (carries instructions across Claude Code sessions)
.claude/next-session-prompt.md

# Divergence harness per-run outputs (injected SWFs, captured PNGs/traces,
# build artifacts). The tools themselves are committed; the runs/ subdir is
# generated per-game.
tools/divergence/runs/

# Browser-test probe per-run outputs (canvas snapshots, console capture,
# display-list dumps). Generated by tools/browser-test/probe.py.
tools/browser-test/runs/

# WASM probe runner per-run outputs (actual + diff PNGs, report.json).
# Generated by tools/wasm_probe_runner.py.
tools/wasm_probe_runner_out/

# APCpp datapackage cache (dropped in cwd by native WITH_AP livetests)
APCpp_datapkg.cache

# Untracked planning / working documents (session notes, cleanup plans).
# Deliberately local-only: drafts live here before graduating to SWFRecompDocs.
NewDocs/
