# Disabled git directories (for submodules converted to regular directories)
.git.disabled

# Visual Studio
.vs/

# Build directories
build/
build-*/
build_*/
out/

# Recompiled output
RecompiledTags/
RecompiledScripts/

# Flash files
*.swf
sup*.swf
# Allow deployed test SWFs (needed for Ruffle comparison on GitHub Pages)
!docs/examples/**/test.swf

# Libraries
zlib.dll
*.lib
*.a
# Allow pre-compiled runtime files for in-browser recompiler demo
!docs/recompiler/libswfruntime.a

# Compiled files
*.spv
*.o
# Allow pre-compiled .o files for in-browser recompiler demo
!docs/recompiler/runtime_src/*.o

# WASM build artifacts (but keep source)
wasm/examples/*/*.wasm
wasm/examples/*/*.js
!wasm/examples/*/build.sh
!wasm/examples/*/*.c
!wasm/examples/*/*.h
!wasm/examples/*/*.html

# Emscripten
emsdk/

# WASI-SDK
wasi-sdk
wasi-sdk-*/
.emscripten_cache/
.emscripten_ports/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test executables
test_vars

# Test results
#test_results.json

# Other
__pycache__/
test-and-doc-output.log
test-run.log
upstream/
# Upstream reference files for merge comparison
upstream-reference/

# Ruffle tests: ignore test subdirectories (downloaded data), keep top-level files
ruffle-tests/*/
!ruffle-tests/_shared/
!ruffle-tests/_investigation/

ruffle-tests/results_current.json
ruffle-tests/results_previous.json