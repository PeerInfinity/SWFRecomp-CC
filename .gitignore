# Disabled git directories (for submodules converted to regular directories)
.git.disabled

# Pipeline driver state (used by .claude/pipeline-handoff.md)
.pipeline-state

# Regenerated by CC/scripts/gen_investigation_prompts.sh
ruffle-tests/tests/swfs/*/_investigation/investigation_prompts.txt

# Visual Studio
.vs/

# Build directories
build/
build-*/
build_*/
out/

# Recompiled output
RecompiledTags/
RecompiledScripts/

# Flash files
*.swf
sup*.swf
# Allow deployed test SWFs (needed for Ruffle comparison on GitHub Pages)
!docs/examples/**/test.swf
# Allow demo SWFs for in-browser recompiler
!docs/recompiler/*.swf
# Allow demo SWFs for runtime-swf experiments
!demos/**/*.swf
# Allow deployed wrapper SWFs for injector demos
!docs/injector/**/*.swf

# Libraries
zlib.dll
*.lib
*.a
# Allow pre-compiled runtime files for in-browser recompiler demo
!docs/recompiler/libswfruntime.a

# Compiled files
*.spv
*.o
# Pre-compiled .o files for the in-browser recompiler demo are built by
# the deploy-pages CI workflow — no longer committed to the repository.

# Generated deploy timestamp
docs/recompiler/build_info.json

# WASM build artifacts (but keep source)
wasm/examples/*/*.wasm
wasm/examples/*/*.js
!wasm/examples/*/build.sh
!wasm/examples/*/*.c
!wasm/examples/*/*.h
!wasm/examples/*/*.html

# Emscripten
emsdk/

# WASI-SDK
wasi-sdk
wasi-sdk-*/
.emscripten_cache/
.emscripten_ports/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test executables
test_vars

# Test results
#test_results.json

# Other
__pycache__/
opam-*
test-and-doc-output.log
test-run.log
upstream/
# Upstream reference files for merge comparison
upstream-reference/

# Ruffle tests: ignore downloaded test data, keep infrastructure and results
ruffle-tests/tests/swfs/avm1/*/
!ruffle-tests/tests/swfs/avm1/_investigation/
!ruffle-tests/tests/swfs/avm1/_results/
# Allow Flash-correct expected output files (not overwritten by download_tests.sh).
# Must un-ignore the directory first, then re-ignore everything except output.flash.txt.
!ruffle-tests/tests/swfs/avm1/global_proto_decls/
ruffle-tests/tests/swfs/avm1/global_proto_decls/*
!ruffle-tests/tests/swfs/avm1/global_proto_decls/output.flash.txt
!ruffle-tests/tests/swfs/avm1/global_proto_decls_delete/
ruffle-tests/tests/swfs/avm1/global_proto_decls_delete/*
!ruffle-tests/tests/swfs/avm1/global_proto_decls_delete/output.flash.txt
!ruffle-tests/tests/swfs/avm1/global_instance_decls/
ruffle-tests/tests/swfs/avm1/global_instance_decls/*
!ruffle-tests/tests/swfs/avm1/global_instance_decls/output.flash.txt
!ruffle-tests/tests/swfs/avm1/external_interface/
# Ignore downloaded files within external_interface (only track test.toml + test_harness.c)
ruffle-tests/tests/swfs/avm1/external_interface/output.txt
ruffle-tests/tests/swfs/avm1/external_interface/*.fla
ruffle-tests/tests/swfs/avm1/external_interface/RecompiledScripts/
ruffle-tests/tests/swfs/avm1/external_interface/RecompiledTags/

# Shumway tests (downloaded test data, keep results and investigation)
ruffle-tests/tests/swfs/from_shumway/*/
!ruffle-tests/tests/swfs/from_shumway/_results/
!ruffle-tests/tests/swfs/from_shumway/_investigation/
!ruffle-tests/tests/swfs/from_shumway/avm1/
ruffle-tests/tests/swfs/from_shumway/avm1/*/
!ruffle-tests/tests/swfs/from_shumway/avm1/_results/

# Gnash tests (downloaded test data, keep results and investigation)
ruffle-tests/tests/swfs/from_gnash/*/
!ruffle-tests/tests/swfs/from_gnash/_investigation/
!ruffle-tests/tests/swfs/from_gnash/misc-swfmill.all/
ruffle-tests/tests/swfs/from_gnash/misc-swfmill.all/*/
!ruffle-tests/tests/swfs/from_gnash/misc-swfmill.all/_results/
!ruffle-tests/tests/swfs/from_gnash/actionscript.all/
ruffle-tests/tests/swfs/from_gnash/actionscript.all/*/
!ruffle-tests/tests/swfs/from_gnash/actionscript.all/_results/

# Transient result files (not committed)
ruffle-tests/tests/swfs/**/_results/results_current.json
ruffle-tests/tests/swfs/**/_results/results_previous.json
.claude/scheduled_tasks.lock
