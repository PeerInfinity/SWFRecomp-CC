# Disabled git directories (for submodules converted to regular directories)
.git.disabled

# Visual Studio
.vs/

# Build directories
build/
build-*/
build_*/
out/

# Recompiled output
RecompiledTags/
RecompiledScripts/

# Flash files
*.swf
sup*.swf
# Allow deployed test SWFs (needed for Ruffle comparison on GitHub Pages)
!docs/examples/**/test.swf

# Libraries
zlib.dll
*.lib
*.a

# Compiled files
*.spv
*.o

# WASM build artifacts (but keep source)
wasm/examples/*/*.wasm
wasm/examples/*/*.js
!wasm/examples/*/build.sh
!wasm/examples/*/*.c
!wasm/examples/*/*.h
!wasm/examples/*/*.html

# Emscripten
emsdk/
.emscripten_cache/
.emscripten_ports/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test executables
test_vars

# Test results
#test_results.json

# Other
__pycache__/
test-and-doc-output.log
test-run.log
upstream/
# Upstream reference files for merge comparison
upstream-reference/

# Downloaded external test SWFs (keep our scripts, ignore downloaded data)
ruffle-tests/*
!ruffle-tests/run_tests.py
!ruffle-tests/verify_output.py
!ruffle-tests/download_tests.sh
!ruffle-tests/_shared/
!ruffle-tests/README.md
