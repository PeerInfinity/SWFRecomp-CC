+/// Record one frame's tick (AVM/sim) and render (command-build + GPU) CPU costs
+/// onto JS-side ring buffers (`window.__rufflePerfTick` / `__rufflePerfRender`,
+/// capped at 600 samples) plus scalar `__rufflePerfLastTick` / `__rufflePerfLastRender`.
+/// An external harness reads these to compute mean/p95/max, the same way it reads
+/// SWFRecomp's perf HUD. Only compiled with the `profiling` feature.
+#[cfg(feature = "profiling")]
+fn record_frame_ms(tick_ms: f64, render_ms: f64, draws: f64) {
+    use wasm_bindgen::{JsCast, JsValue};
+    const CAP: u32 = 600;
+    let Some(window) = web_sys::window() else {
+        return;
+    };
+    let push = |key: &str, last_key: &str, ms: f64| {
+        let mut arr = match js_sys::Reflect::get(&window, &JsValue::from_str(key)) {
+            Ok(v) if v.is_instance_of::<js_sys::Array>() => v.unchecked_into::<js_sys::Array>(),
+            _ => {
+                let a = js_sys::Array::new();
+                let _ = js_sys::Reflect::set(&window, &JsValue::from_str(key), &a);
+                a
+            }
+        };
+        arr.push(&JsValue::from_f64(ms));
+        let len = arr.length();
+        if len > CAP {
+            // Keep only the most recent CAP samples (slice does not mutate in
+            // place, so re-publish the trimmed array as the window global).
+            arr = arr.slice(len - CAP, len);
+            let _ = js_sys::Reflect::set(&window, &JsValue::from_str(key), &arr);
+        }
+        let _ = js_sys::Reflect::set(&window, &JsValue::from_str(last_key), &JsValue::from_f64(ms));
+    };
+    push("__rufflePerfTick", "__rufflePerfLastTick", tick_ms);
+    push("__rufflePerfRender", "__rufflePerfLastRender", render_ms);
+    push("__rufflePerfDraws", "__rufflePerfLastDraws", draws);
+}
