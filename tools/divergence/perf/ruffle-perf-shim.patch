+// Local perf instrumentation (feature `draw_counter`): a global count of shape
+// draw_indexed calls, incremented in surface::commands and read+reset per frame
+// by the web crate's profiling shim. Relaxed ordering — an approximate per-frame
+// tally, not a synchronisation point.
+#[cfg(feature = "draw_counter")]
+pub static DRAW_CALLS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Read and reset the accumulated shape draw-call count (feature `draw_counter`).
+#[cfg(feature = "draw_counter")]
+pub fn take_draw_calls() -> u64 {
+    DRAW_CALLS.swap(0, std::sync::atomic::Ordering::Relaxed)
+}
