<?xml version="1.0" encoding="UTF-8"?>
<swf version="6" compressed="0">
  <Header framerate="12" frames="2">
    <size><Rectangle left="0" right="4000" top="0" bottom="3000"/></size>
    <tags>
      <SetBackgroundColor><color><Color red="255" green="255" blue="255"/></color></SetBackgroundColor>

      <!-- leaf: 4-frame sprite, plays (no stop) -->
      <DefineSprite objectID="2" frames="4">
        <tags>
          <ShowFrame/>
          <ShowFrame/>
          <ShowFrame/>
          <ShowFrame/>
          <End/>
        </tags>
      </DefineSprite>

      <!-- mid: 1-frame holder, places leaf as "n" -->
      <DefineSprite objectID="3" frames="1">
        <tags>
          <PlaceObject2 replace="0" depth="1" objectID="2" name="n"/>
          <ShowFrame/>
          <End/>
        </tags>
      </DefineSprite>

      <!-- m: a ROOT-LEVEL 4-frame sprite (control). swfrecomp advances
           root-level sprites in Phase 1 (BEFORE the enterFrame flush), so the
           tracer should read m._cf with NO lag — isolating the bug to nested
           sprites (Phase 3, AFTER enterFrame). -->
      <DefineSprite objectID="4" frames="4">
        <tags>
          <ShowFrame/>
          <ShowFrame/>
          <ShowFrame/>
          <ShowFrame/>
          <End/>
        </tags>
      </DefineSprite>

      <!-- root: place mid as "c" (nested case) and m as the root-level control;
           2 frames, loops -->
      <PlaceObject2 replace="0" depth="1" objectID="3" name="c"/>
      <PlaceObject2 replace="0" depth="2" objectID="4" name="m"/>
      <ShowFrame/>
      <ShowFrame/>
      <End/>
    </tags>
  </Header>
</swf>
